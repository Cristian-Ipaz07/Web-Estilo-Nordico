---
/**
 * /perfumes/index.astro — Catálogo de perfumes (Estilo Dark Mode Streetwear)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { perfumes, getUniqueBrands } from '../../data/products';

const brands = getUniqueBrands(perfumes);
// Best sellers specified by user: Ohm, Pulso, Nitro Clásica, Dancing Night, Winner Sport, Dorsay, Prints, Soft Musk
const featured = perfumes.filter(p => p.featured);
---

<BaseLayout title="Perfumes y Lociones" description="Encuentra perfumes de catálogo Yanbal, Ésika, Cyzone, Avon y L'Bel en Pasto. Paga al recibir en Pasto y envíos nacionales rápidos.">
  
  <!-- Page Header (Premium lifestyle banner with bottom white fade) -->
  <section class="relative w-full h-[75vh] sm:h-[85vh] flex items-end overflow-hidden bg-black" id="perfumes-hero">
    <!-- Image Background -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/ChatGPT Image 27 jul 2026, 07_41_27 a.m..png" 
        alt="Colección Perfumes Estilo Nórdico" 
        class="w-full h-full object-cover object-center scale-100 brightness-[0.75]"
        loading="eager"
      />
      <!-- Dark bottom gradient overlay that fades to white at the bottom edge -->
      <div class="absolute inset-0 bg-gradient-to-t from-white via-black/60 to-transparent z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-20 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
      <div class="max-w-2xl text-left">
        
        <!-- Minimalist Tagline -->
        <span class="inline-block border border-white/20 bg-white/5 backdrop-blur-md text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-widest mb-4">
          COLECCIÓN 2026
        </span>

        <!-- Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-title font-black text-white leading-none tracking-wider uppercase mb-4">
          El aroma<br />que habla<br />antes que tú.
        </h1>

        <!-- Slogan -->
        <p class="text-xs sm:text-sm lg:text-base text-zinc-300 mb-8 font-light leading-relaxed max-w-md">
          Descubre fragancias diseñadas para dejar una impresión inolvidable.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          <a 
            href="#mas-vendidos"
            class="inline-flex items-center justify-center gap-2 bg-black hover:bg-neutral-950 text-white font-black text-[11px] sm:text-xs uppercase tracking-widest px-8 py-4.5 rounded-md transition-all duration-300 border-2 border-black cursor-pointer shadow-md"
          >
            Lo Más Vendido
          </a>
          <a 
            href="#catalogo-completo"
            class="inline-flex items-center justify-center gap-2 border-2 border-black hover:bg-black hover:text-white text-black font-black text-[11px] sm:text-xs uppercase tracking-widest px-8 py-4.5 rounded-md transition-all duration-300 cursor-pointer bg-white/85 backdrop-blur-md"
          >
            Catálogo
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 1. Featured / Más vendidos: Infinite Slow Slider (Marquee style) -->
  {featured.length > 0 && (
    <section class="py-12 bg-white border-b border-[#E5E7EB] overflow-hidden" id="mas-vendidos">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 text-center">
        <span class="inline-block text-gold text-[9px] font-black px-4 py-1.5 rounded-md border border-gold/30 bg-gold/5 mb-3 uppercase tracking-widest">Top Ventas</span>
        <h2 class="text-xl sm:text-2xl font-title font-black text-text-main uppercase tracking-widest">Los Más Vendidos</h2>
        <p class="text-[10px] text-text-muted uppercase tracking-wider mt-1">Desliza o pon el cursor encima para detener la rotación</p>
      </div>

      <!-- Horizontal Marquee Container (Monochrome Light) -->
      <div class="relative w-full overflow-hidden py-4 bg-white">
        <div class="animate-marquee flex gap-6 w-max px-6">
          <!-- First set of cards -->
          {featured.map((product) => (
            <div class="flex-shrink-0 w-48 sm:w-56">
              <ProductCard
                id={product.id}
                slug={product.slug}
                name={product.name}
                brand={product.brand}
                price={product.price}
                anchorPrice={product.anchorPrice}
                image={product.image}
                description={product.description}
                category="perfumes"
              />
            </div>
          ))}
          <!-- Second set of cards for seamless infinite loop -->
          {featured.map((product) => (
            <div class="flex-shrink-0 w-48 sm:w-56" aria-hidden="true">
              <ProductCard
                id={product.id}
                slug={product.slug}
                name={product.name}
                brand={product.brand}
                price={product.price}
                anchorPrice={product.anchorPrice}
                image={product.image}
                description={product.description}
                category="perfumes"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 2. Full Catalog with Filters -->
  <section class="py-12 sm:py-16 bg-white" id="catalogo-completo">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest mb-3">Búsqueda Avanzada</span>
        <h2 class="text-xl sm:text-2xl font-title font-black text-text-main uppercase tracking-widest">Encuentra Tu Fragancia</h2>
      </div>

      <!-- Filters Wrapper (Light Theme) -->
      <div class="space-y-4 max-w-4xl mx-auto mb-10 p-5 bg-[#F9F9FB] border border-[#E5E7EB] rounded-md">
        <!-- Gender Filters -->
        <div class="flex flex-wrap gap-2 justify-center" id="gender-filters">
          <button class="gender-btn active-filter px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-text-main bg-text-main text-white transition-all cursor-pointer" data-gender="all">
            Todos
          </button>
          <button class="gender-btn px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-[#E5E7EB] text-text-main hover:border-text-main transition-all cursor-pointer bg-white" data-gender="hombre">
            Hombre
          </button>
          <button class="gender-btn px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-[#E5E7EB] text-text-main hover:border-text-main transition-all cursor-pointer bg-white" data-gender="mujer">
            Dama
          </button>
          <button class="gender-btn px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-[#E5E7EB] text-text-main hover:border-text-main transition-all cursor-pointer bg-white" data-gender="unisex">
            Unisex
          </button>
        </div>

        <!-- Brand Filters -->
        <div class="flex flex-wrap gap-2 justify-center" id="brand-filters">
          <button class="brand-btn active-filter px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-text-main bg-text-main text-white transition-all cursor-pointer" data-brand="all">
            Todas ({perfumes.length})
          </button>
          {brands.map(brand => {
            const count = perfumes.filter(p => p.brand === brand).length;
            return (
              <button 
                class="brand-btn px-4 py-2 rounded-md text-[10px] font-black uppercase tracking-widest border border-[#E5E7EB] text-text-main hover:border-text-main transition-all cursor-pointer bg-white"
                data-brand={brand}
              >
                {brand} ({count})
              </button>
            );
          })}
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="perfumes-grid">
        {perfumes.map((product) => (
          <div class="perfume-item" data-brand={product.brand} data-gender={product.gender}>
            <ProductCard
              id={product.id}
              slug={product.slug}
              name={product.name}
              brand={product.brand}
              price={product.price}
              anchorPrice={product.anchorPrice}
              image={product.image}
              description={product.description}
              category="perfumes"
            />
          </div>
        ))}
      </div>

      <!-- Ver Más Button Container -->
      <div class="text-center mt-10" id="ver-mas-container">
        <button id="btn-ver-mas" class="bg-text-main hover:bg-neutral-800 text-white font-black px-8 py-3.5 rounded-md transition-all cursor-pointer text-[10px] uppercase tracking-widest">
          Ver Más Perfumes
        </button>
      </div>

      <!-- Empty State -->
      <div id="perfumes-empty" class="hidden text-center py-12">
        <span class="text-3xl mb-4 block">🔍</span>
        <p class="text-sm font-black text-text-main uppercase tracking-widest">No hay perfumes con esta combinación de filtros</p>
      </div>

      <!-- Callout Call: Direct Distributor Authorized Note (Premium High Contrast Dark Card with Gentle Bounce Button) -->
      <div class="max-w-3xl mx-auto mt-14 p-8 bg-neutral-900 border border-neutral-850 rounded-md flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left shadow-xl">
        <div class="flex items-center gap-4 flex-col sm:flex-row">
          <span class="text-3xl">💬</span>
          <div>
            <h3 class="text-sm sm:text-base font-black text-white uppercase tracking-widest">¿No encuentras tu loción favorita?</h3>
            <p class="text-xs text-zinc-300 mt-1.5 font-light leading-relaxed">Trabajamos directo con distribuidor de fábrica. <strong>¡Pregunta por la que deseas para conseguírtela hoy mismo!</strong></p>
          </div>
        </div>
        <a 
          href={`https://api.whatsapp.com/send?phone=573218888046&text=${encodeURIComponent('Hola, estoy buscando una loción de catálogo que no veo en la web. Pregunto por la que deseo para conseguírmela hoy mismo. ¿Me ayudan?')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-white bg-white hover:bg-neutral-200 text-black font-black text-[10px] sm:text-xs px-8 py-4.5 rounded-md transition-all duration-300 whitespace-nowrap uppercase tracking-widest cursor-pointer shadow-md animate-bounce-gentle"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Cross-sell Banner -->
  <section class="py-16 bg-[#121214] border-t border-[#262626] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-title font-black uppercase tracking-widest mb-3">Completa tu estilo con una chaqueta</h2>
      <p class="text-xs sm:text-sm text-[#A3A3A3] mb-6 max-w-lg mx-auto font-light leading-relaxed">
        Combo perfume + chaqueta de Confección Premium Colombiana con envío inmediato.
      </p>
      <a href="/chaquetas" class="inline-flex items-center gap-2 border border-white hover:bg-white hover:text-[#0B0B0C] font-black text-[10px] sm:text-xs uppercase tracking-widest px-6 py-3 rounded-md transition-all duration-300">
        Ver chaquetas →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Endless slow scrolling marquee */
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Gentle bounce animation for callout conversion */
  @keyframes bounce-gentle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .animate-bounce-gentle {
    animation: bounce-gentle 2.2s infinite ease-in-out;
  }
</style>

<script>
  const brandButtons = document.querySelectorAll('.brand-btn');
  const genderButtons = document.querySelectorAll('.gender-btn');
  const perfumeItems = document.querySelectorAll('.perfume-item');
  const emptyState = document.getElementById('perfumes-empty');
  const btnVerMas = document.getElementById('btn-ver-mas');
  const verMasContainer = document.getElementById('ver-mas-container');

  let activeBrand = 'all';
  let activeGender = 'all';
  let limitApplied = true;

  // Initialize display: show only first 8 items on load
  filterItems();

  // Brand click listener
  brandButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeBrand = btn.getAttribute('data-brand') || 'all';
      
      brandButtons.forEach(b => {
        b.classList.remove('border-text-main', 'bg-text-main', 'text-white');
        b.classList.add('border-[#E5E7EB]', 'text-text-main', 'bg-white');
      });
      btn.classList.add('border-text-main', 'bg-text-main', 'text-white');
      btn.classList.remove('border-[#E5E7EB]', 'text-text-main', 'bg-white');

      // Automatically drop limit when filtering specific items
      if (activeBrand !== 'all') {
        limitApplied = false;
      }
      
      filterItems();
    });
  });

  // Gender click listener
  genderButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeGender = btn.getAttribute('data-gender') || 'all';
      
      genderButtons.forEach(b => {
        b.classList.remove('border-text-main', 'bg-text-main', 'text-white');
        b.classList.add('border-[#E5E7EB]', 'text-text-main', 'bg-white');
      });
      btn.classList.add('border-text-main', 'bg-text-main', 'text-white');
      btn.classList.remove('border-[#E5E7EB]', 'text-text-main', 'bg-white');

      // Automatically drop limit when filtering specific items
      if (activeGender !== 'all') {
        limitApplied = false;
      }
      
      filterItems();
    });
  });

  // "Ver Más" click listener
  btnVerMas?.addEventListener('click', () => {
    limitApplied = false;
    filterItems();
  });

  function filterItems() {
    let visibleCount = 0;
    let matchCount = 0;

    perfumeItems.forEach(item => {
      const el = item as HTMLElement;
      const itemBrand = el.dataset.brand || '';
      const itemGender = el.dataset.gender || '';
      
      const brandMatch = activeBrand === 'all' || itemBrand === activeBrand;
      const genderMatch = activeGender === 'all' || itemGender === activeGender;
      const isMatch = brandMatch && genderMatch;

      if (isMatch) {
        matchCount++;
        // Apply 8-item limit only on "Todas" + "Todos" mode when limitApplied is active
        if (limitApplied && activeBrand === 'all' && activeGender === 'all') {
          if (visibleCount < 8) {
            el.style.display = '';
            visibleCount++;
          } else {
            el.style.display = 'none';
          }
        } else {
          el.style.display = '';
          visibleCount++;
        }
      } else {
        el.style.display = 'none';
      }
    });

    // Toggle Empty State
    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }

    // Toggle "Ver Más" button visibility
    if (verMasContainer) {
      const shouldShowVerMas = limitApplied && activeBrand === 'all' && activeGender === 'all' && matchCount > 8;
      verMasContainer.classList.toggle('hidden', !shouldShowVerMas);
    }
  }
</script>
