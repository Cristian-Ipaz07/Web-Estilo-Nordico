---
/**
 * /camisetas/[slug].astro — Página individual de Camisetas y Streetwear
 * Genera páginas estáticas por cada referencia y variante del ERP.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPage from '../../components/ProductPage.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchTShirtsFromERP } from '../../lib/erpApi';

export async function getStaticPaths() {
  const tshirts = await fetchTShirtsFromERP();
  const paths = tshirts.map(t => ({
    params: { slug: t.slug },
    props: { tshirt: t, allTshirts: tshirts },
  }));

  // Aliases para acceso rápido por referencia limpia (ej: /camisetas/7652)
  const refGroups = new Map<string, typeof tshirts[0]>();
  tshirts.forEach(t => {
    const refNum = (t.reference || t.id.replace(/^erp-/, '').split('-')[0] || '').toUpperCase();
    if (refNum && (!refGroups.has(refNum) || (t.stock || 0) > (refGroups.get(refNum)?.stock || 0))) {
      refGroups.set(refNum, t);
    }
  });

  refGroups.forEach((repTshirt, refNum) => {
    const aliases = [refNum, `ref-${refNum}`, `camiseta-${refNum}`, `camisetas-${refNum}`];
    aliases.forEach(alias => {
      if (!paths.some(p => p.params.slug === alias)) {
        paths.push({
          params: { slug: alias },
          props: { tshirt: repTshirt, allTshirts: tshirts },
        });
      }
    });
  });

  return paths;
}

const { tshirt, allTshirts } = Astro.props;

const categoryLabel = "Camisetas";
const categoryHref = "/camisetas";

// Camisetas relacionadas de la misma colección o marcas afines
const currentRef = (tshirt.reference || tshirt.id.replace(/^erp-/, '').split('-')[0] || '').toUpperCase();
const related = allTshirts
  .filter(t => t.id !== tshirt.id && t.status === 'disponible')
  .sort((a, b) => {
    const aRef = (a.reference || a.id.replace(/^erp-/, '').split('-')[0] || '').toUpperCase();
    const bRef = (b.reference || b.id.replace(/^erp-/, '').split('-')[0] || '').toUpperCase();
    if (aRef === currentRef && bRef !== currentRef) return -1;
    if (aRef !== currentRef && bRef === currentRef) return 1;
    return 0;
  })
  .slice(0, 4);
---

<BaseLayout title={`${tshirt.name} | Estilo Nórdico`} description={tshirt.description}>
  <ProductPage 
    product={tshirt} 
    categoryLabel={categoryLabel} 
    categoryHref={categoryHref} 
    allProducts={allTshirts}
  />

  {/* Productos Relacionados */}
  {related.length > 0 && (
    <section class="py-12 sm:py-16 bg-bg border-t border-[#E5E7EB]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl sm:text-2xl font-black text-text-main mb-6 text-center uppercase tracking-wider font-title">
          Otros Diseños Disponibles de la Colección
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto">
          {related.map((product) => (
            <ProductCard
              id={product.id}
              slug={product.slug}
              name={product.name}
              brand={product.brand}
              price={product.price}
              anchorPrice={product.anchorPrice}
              image={product.image}
              images={product.images}
              description={product.description}
              category="camisetas"
              gender={product.gender}
              stock={product.stock}
              status={product.status}
              colorHex={product.colorHex}
              variants={product.variants}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
