---
/**
 * /relojes/index.astro — Catálogo de relojes
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { relojes } from '../../data/products';
---

<BaseLayout title="Relojes de Alta Gama" description="Relojes ejecutivos, cronógrafos y de lujo Curren, SKMEI y RISTOS. Paga al recibir en Pasto y envíos nacionales rápidos.">
  
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-[#D97706] to-[#F59E0B] text-white py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-4xl mb-3">⌚</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-3">Relojes Premium</h1>
      <p class="text-base sm:text-lg text-white/70 max-w-lg mx-auto">
        Diseños exclusivos de lujo y deportivos. {relojes.length} modelos en stock real.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mt-6">
        <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold">
          🏠 Paga al Recibir en Pasto
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold">
          🇨🇴 Envíos a todo el país
        </span>
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 max-w-4xl mx-auto">
        {relojes.map((product) => (
          <ProductCard
            id={product.id}
            slug={product.slug}
            name={product.name}
            brand={product.brand}
            price={product.price}
            anchorPrice={product.anchorPrice}
            image={product.image}
            description={product.description}
            category="relojes"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-sell -->
  <section class="py-12 sm:py-16 bg-gradient-to-r from-[#8B5CF6] to-[#A78BFA] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-xl sm:text-2xl lg:text-3xl font-black mb-3">Complementa con un perfume de catálogo 🧴</h2>
      <p class="text-sm sm:text-base text-white/80 mb-6 max-w-lg mx-auto">
        Fragancias Yanbal, Ésika y Cyzone originales con envío inmediato a domicilio.
      </p>
      <a href="/perfumes" class="inline-flex items-center gap-2 bg-white text-[#8B5CF6] font-bold px-6 py-3 rounded-xl transition-all duration-200 hover:shadow-xl hover:scale-105 text-sm">
        Ver perfumes →
      </a>
    </div>
  </section>
</BaseLayout>
