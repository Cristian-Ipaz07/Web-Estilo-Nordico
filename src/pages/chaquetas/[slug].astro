---
/**
 * /chaquetas/[slug].astro — Product page individual del catálogo de confección y accesorios
 * Genera una página estática por cada producto y variante desde el ERP de Estilo Nórdico.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductPage from '../../components/ProductPage.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchJacketsFromERP } from '../../lib/erpApi';

export async function getStaticPaths() {
  const jackets = await fetchJacketsFromERP();
  const paths = jackets.map(jacket => ({
    params: { slug: jacket.slug },
    props: { jacket, allJackets: jackets },
  }));

  // Alias para retrocompatibilidad con links del ERP y directos
  const defaultJacket = jackets.find(j => j.slug === 'chaqueta-impermeable-negro') || jackets[0];
  if (defaultJacket) {
    const aliases = ['5080-impermeable', '5080', 'chaqueta-impermeable', '5080-the-north-face'];
    aliases.forEach(alias => {
      paths.push({
        params: { slug: alias },
        props: { jacket: defaultJacket, allJackets: jackets },
      });
    });
  }

  // Alias para billeteras u otros slugs con -unicolor
  jackets.forEach(j => {
    if (j.slug.startsWith('billetera-8270')) {
      paths.push({
        params: { slug: 'billetera-8270-unicolor' },
        props: { jacket: j, allJackets: jackets },
      });
    }
  });

  return paths;
}

const { jacket, allJackets } = Astro.props;

const isJacket = (jacket.subcategory || '').toUpperCase().includes('CHAQUETA') || jacket.id.includes('5080');
const categoryLabel = isJacket ? 'Chaquetas' : (jacket.subcategory ? `${jacket.subcategory.charAt(0).toUpperCase()}${jacket.subcategory.slice(1).toLowerCase()}` : 'Prendas');
const categoryHref = isJacket ? '/chaquetas' : `/chaquetas?tipo=${encodeURIComponent((jacket.subcategory || '').toLowerCase())}`;

// Related products
const related = allJackets
  .filter((j: any) => j.id !== jacket.id && j.status === 'disponible')
  .slice(0, 3);
const relatedTitle = isJacket ? 'Otros Colores Disponibles' : 'Otras Opciones Disponibles';
---

<BaseLayout title={jacket.name} description={jacket.description}>
  <ProductPage 
    product={jacket} 
    categoryLabel={categoryLabel} 
    categoryHref={categoryHref} 
    allProducts={allJackets}
  />

  {/* Related Products */}
  {related.length > 0 && (
    <section class="py-12 sm:py-16 bg-bg">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl sm:text-2xl font-black text-text-main mb-6 text-center">{relatedTitle}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 max-w-3xl mx-auto">
          {related.map((product: any) => (
            <ProductCard
              id={product.id}
              slug={product.slug}
              name={product.name}
              brand={product.brand}
              price={product.price}
              anchorPrice={product.anchorPrice}
              image={product.image}
              description={product.description}
              category="chaquetas"
              stock={product.stock}
              status={product.status}
              colorHex={product.colorHex}
              variants={product.variants}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
