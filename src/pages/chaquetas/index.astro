    }

    if (filterCount) {
      const genderLabel = selectedGender === 'mujer' ? 'en Colección Mujer' : selectedGender === 'hombre' ? 'en Colección Hombre' : 'en Catálogo';
      const statusLabel = status === 'disponible' ? 'disponibles' : status === 'agotado' ? 'agotados' : 'en total';
      let countText = `${visible} producto${visible !== 1 ? 's' : ''} ${statusLabel} ${genderLabel}`;

      const filterLabels = [];
      if (selectedTypes.size > 0) filterLabels.push(`Prendas: ${Array.from(selectedTypes).join(', ')}`);
      if (selectedSizes.size > 0) filterLabels.push(`Tallas: ${Array.from(selectedSizes).join(', ')}`);
      if (selectedRefs.size > 0) filterLabels.push(`Refs: ${selectedRefs.size}`);
      if (color !== 'all') filterLabels.push(`Color: ${color}`);
      if (filterLabels.length > 0) {
        countText += ` · ${filterLabels.join(' | ')}`;
      }
      filterCount.textContent = countText;
    }
    if (emptyState) {
