---
/**
 * /chaquetas/index.astro — Catálogo de chaquetas y prendas del ERP (Estilo Dark Mode Streetwear)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchJacketsFromERP } from '../../lib/erpApi';
import { getUniqueColors, getUniqueSizes } from '../../data/products';

const jackets = await fetchJacketsFromERP();
const colors = getUniqueColors(jackets);
const sizes = getUniqueSizes(jackets);
const availableCount = jackets.filter(j => j.status === 'disponible').length;

// Tipos de prendas disponibles en el catálogo
const apparelTypes = Array.from(new Set(jackets.map(j => {
  const sub = (j.subcategory || '').toUpperCase();
  const name = (j.name || '').toUpperCase();
  if (sub.includes('CHAQUETA')) return 'CHAQUETA';
  if (sub.includes('CONJUNTO') || name.includes('CONJUNTO')) return 'CONJUNTO';
  if (sub.includes('BUSO') || name.includes('BUSO') || name.includes('CAPUCHA')) return 'BUSO';
  if (sub.includes('CAMISETA')) return 'CAMISETA';
  if (sub.includes('BERMUDA')) return 'BERMUDA';
  if (sub.includes('JEAN')) return 'JEANS';
  if (sub.includes('PANTALON')) return 'PANTALON';
  if (sub.includes('BILLETERA')) return 'BILLETERA';
  return sub || 'PRENDA';
}))).filter(Boolean).sort();
---

<BaseLayout title="Chaquetas & Moda Streetwear" description="Prendas de Confección Premium Colombiana con stock real. Filtros por prenda, color y talla. Paga al recibir en Pasto y envíos a todo el país.">
  
  <!-- Page Header (Premium Banner with bottom white fade) -->
  <section class="relative w-full h-[70vh] sm:h-[80vh] flex items-end overflow-hidden bg-black" id="chaquetas-hero">
    <!-- Image Background -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/baner cha.png" 
        alt="Colección Estilo Nórdico" 
        class="w-full h-full object-cover brightness-[0.75]"
        style="object-position: 80% center;"
        loading="eager"
      />
      <!-- Dark bottom gradient overlay that fades to white at the bottom edge -->
      <div class="absolute inset-0 bg-gradient-to-t from-white via-black/60 to-transparent z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-20 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
      <div class="max-w-2xl text-left">
        
        <!-- Minimalist Tagline -->
        <span class="inline-block border border-white/20 bg-white/5 backdrop-blur-md text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-widest mb-4">
          COLECCIÓN 2026
        </span>

        <!-- Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-title font-black text-white leading-none tracking-wider uppercase mb-4">
          Chaquetas
        </h1>

        <!-- Slogan -->
        <p class="text-xs sm:text-sm lg:text-base text-zinc-300 mb-6 font-light leading-relaxed max-w-md">
          Para quienes buscan estilo, comodidad y protección.
        </p>

        <!-- Trust Signals (List style) -->
        <ul class="space-y-2 mb-8 text-xs text-white/90 font-semibold tracking-wider uppercase">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Calidad Premium
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Envíos Nacionales
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Pago Contra Entrega
          </li>
        </ul>

        <!-- CTA -->
        <div>
          <a 
            href="#filter-bar"
            class="inline-flex items-center justify-center gap-2 bg-[#C9A962] hover:bg-[#D4B878] text-[#0B0B0C] border-2 border-[#C9A962] hover:border-[#D4B878] font-black text-[11px] sm:text-xs uppercase tracking-widest px-8 py-4.5 rounded-md transition-all duration-300 cursor-pointer shadow-md"
          >
            Ver Catálogo <span class="ml-1">→</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Filters + Products -->
  <section class="py-8 sm:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Department Selector Tabs (Koaj / Zara / Mattelsa Style) -->
      <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6" id="department-tabs">
        <button 
          type="button" 
          class="dept-tab active-dept px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5"
          data-dept="all"
        >
          <span>🔥</span> Todo el Catálogo
        </button>
        <button 
          type="button" 
          class="dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5"
          data-dept="hombre"
        >
          <span>👔</span> Colección Hombre
        </button>
        <button 
          type="button" 
          class="dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5"
          data-dept="mujer"
        >
          <span>👗</span> Colección Mujer
        </button>
      </div>

      <!-- Filter Bar (Light Theme) -->
      <div class="mb-8 p-5 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]" id="filter-bar">
        <div class="flex flex-wrap gap-4 items-end">
          
          <!-- Gender / Department select -->
          <div class="flex-1 min-w-[130px]">
            <label class="block text-[9px] font-black text-text-main mb-2 uppercase tracking-widest">Departamento</label>
            <select id="filter-gender" class="w-full px-3 py-2.5 rounded-md border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
              <option value="all" selected>Todos (Hombre y Mujer)</option>
              <option value="hombre">Hombre</option>
              <option value="mujer">Mujer</option>
            </select>
          </div>

          {apparelTypes.length > 1 && (
            <div class="flex-1 min-w-[130px]">
              <label class="block text-[9px] font-black text-text-main mb-2 uppercase tracking-widest">Prenda</label>
              <select id="filter-type" class="w-full px-3 py-2.5 rounded-md border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
                <option value="all" selected>Todas</option>
                {apparelTypes.map(t => (
                  <option value={t}>{t === 'CHAQUETA' ? 'Chaquetas' : t === 'CONJUNTO' ? 'Conjuntos Importados' : t === 'BUSO' ? 'Busos & Sacos' : t === 'CAMISETA' ? 'Camisetas' : t === 'BERMUDA' ? 'Bermudas' : t === 'BILLETERA' ? 'Billeteras' : t}</option>
                ))}
              </select>
            </div>
          )}

          <!-- Color filter -->
          <div class="flex-1 min-w-[140px]">
            <label class="block text-[9px] font-black text-text-main mb-2 uppercase tracking-widest">Color</label>
            <select id="filter-color" class="w-full px-3 py-2.5 rounded-md border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
              <option value="all">Todos los colores</option>
              {colors.map(color => (
                <option value={color}>{color}</option>
              ))}
            </select>
          </div>
          <!-- Size filter -->
          <div class="flex-1 min-w-[120px]">
            <label class="block text-[9px] font-black text-text-main mb-2 uppercase tracking-widest">Talla</label>
            <select id="filter-size" class="w-full px-3 py-2.5 rounded-md border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
              <option value="all">Todas</option>
              {sizes.map(size => (
                <option value={size}>{size}</option>
              ))}
            </select>
          </div>
          <!-- Status filter -->
          <div class="flex-1 min-w-[130px]">
            <label class="block text-[9px] font-black text-text-main mb-2 uppercase tracking-widest">Estado</label>
            <select id="filter-status" class="w-full px-3 py-2.5 rounded-md border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
              <option value="all" selected>Todos</option>
              <option value="disponible">Disponibles</option>
              <option value="agotado">Agotados</option>
            </select>
          </div>
          <!-- Reset -->
          <button id="filter-reset" class="px-5 py-2.5 rounded-md text-[10px] font-black uppercase tracking-widest text-text-main border border-[#E5E7EB] hover:border-[#0B0B0C] hover:bg-[#F9F9FB] transition-all cursor-pointer">
            Limpiar
          </button>
        </div>
        <p class="mt-3 text-[10px] text-text-muted uppercase tracking-wider" id="filter-count">{jackets.length} productos</p>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="products-grid">
        {jackets.map((product) => {
          const rawSub = (product.subcategory || '').toUpperCase();
          const rawName = (product.name || '').toUpperCase();
          const normalizedType = rawSub.includes('CHAQUETA') ? 'CHAQUETA'
            : (rawSub.includes('CONJUNTO') || rawName.includes('CONJUNTO')) ? 'CONJUNTO'
            : (rawSub.includes('BUSO') || rawName.includes('BUSO') || rawName.includes('CAPUCHA')) ? 'BUSO'
            : rawSub.includes('CAMISETA') ? 'CAMISETA'
            : rawSub.includes('BERMUDA') ? 'BERMUDA'
            : rawSub.includes('JEAN') ? 'JEANS'
            : rawSub.includes('PANTALON') ? 'PANTALON'
            : rawSub.includes('BILLETERA') ? 'BILLETERA'
            : rawSub || 'PRENDA';
          return (
            <div 
              class="product-item"
              data-type={normalizedType}
              data-gender={product.gender || 'hombre'}
              data-subcategory={rawSub}
              data-name={rawName}
              data-colors={product.variants?.map(v => v.color).join(',')}
              data-sizes={product.variants?.map(v => v.talla).join(',')}
              data-status={product.status}
              data-available-sizes={product.variants?.filter(v => v.status === 'disponible').map(v => v.talla).join(',')}
            >
              <ProductCard
                id={product.id}
                slug={product.slug}
                name={product.name}
                brand={product.brand}
                price={product.price}
                anchorPrice={product.anchorPrice}
                image={product.image}
                description={product.description}
                category="chaquetas"
                gender={product.gender}
                stock={product.stock}
                status={product.status}
                colorHex={product.colorHex}
                variants={product.variants}
              />
            </div>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-16">
        <span class="text-3xl mb-4 block">🔍</span>
        <p class="text-sm font-black text-text-main uppercase tracking-widest">No hay prendas con estos filtros</p>
        <p class="text-xs text-text-muted mt-1 uppercase tracking-wider">Intenta cambiar la combinación de filtros</p>
      </div>
    </div>
  </section>

  <!-- Cross-sell Banner -->
  <section class="py-16 bg-[#121214] border-t border-[#262626] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-title font-black uppercase tracking-widest mb-3">¿Y si le sumas un perfume?</h2>
      <p class="text-xs sm:text-sm text-[#A3A3A3] mb-6 max-w-lg mx-auto font-light leading-relaxed">
        Combo prenda + perfume original desde <strong>$130.000 COP</strong> con entrega inmediata hoy mismo en Pasto.
      </p>
      <a href="/perfumes" class="inline-flex items-center gap-2 border border-white hover:bg-white hover:text-[#0B0B0C] font-black text-[10px] sm:text-xs uppercase tracking-widest px-6 py-3 rounded-md transition-all duration-300">
        Ver perfumes →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const filterGender = document.getElementById('filter-gender') as HTMLSelectElement | null;
  const filterType = document.getElementById('filter-type') as HTMLSelectElement | null;
  const filterColor = document.getElementById('filter-color') as HTMLSelectElement | null;
  const filterSize = document.getElementById('filter-size') as HTMLSelectElement | null;
  const filterStatus = document.getElementById('filter-status') as HTMLSelectElement | null;
  const filterReset = document.getElementById('filter-reset');
  const filterCount = document.getElementById('filter-count');
  const emptyState = document.getElementById('empty-state');
  const items = document.querySelectorAll('.product-item');
  const deptTabs = document.querySelectorAll('.dept-tab');

  // Soporte de Parámetros URL (ej: /chaquetas?genero=mujer&tipo=chaqueta&talla=M)
  const urlParams = new URLSearchParams(window.location.search);
  const rawParamGender = (urlParams.get('genero') || urlParams.get('gender') || urlParams.get('cat') || '').trim().toLowerCase();
  let activeGender = (rawParamGender === 'mujer' || rawParamGender === 'dama') ? 'mujer'
    : (rawParamGender === 'hombre' || rawParamGender === 'caballero') ? 'hombre'
    : 'all';

  const rawParamTipo = (urlParams.get('tipo') || urlParams.get('categoria') || '').trim().toUpperCase();
  const paramTipo = rawParamTipo.includes('CONJUNTO') ? 'CONJUNTO'
    : rawParamTipo.includes('BUSO') ? 'BUSO'
    : rawParamTipo.includes('CAMISETA') ? 'CAMISETA'
    : rawParamTipo.includes('BERMUDA') ? 'BERMUDA'
    : rawParamTipo.includes('JEAN') ? 'JEANS'
    : rawParamTipo.includes('BILLETERA') ? 'BILLETERA'
    : rawParamTipo.includes('CHAQUETA') ? 'CHAQUETA'
    : rawParamTipo;

  function updateHeroAndMeta() {
    const heroTitle = document.querySelector('#chaquetas-hero h1');
    const heroSlogan = document.querySelector('#chaquetas-hero p');

    if (activeGender === 'mujer') {
      if (heroTitle) heroTitle.textContent = paramTipo === 'CHAQUETA' ? 'Chaquetas Dama' : 'Colección Mujer';
      if (heroSlogan) heroSlogan.textContent = 'Prendas térmicas e impermeables diseñadas con silueta, tallas y confección exclusiva para mujer.';
      document.title = 'Colección Mujer | Estilo Nórdico Pasto';
    } else if (activeGender === 'hombre') {
      if (heroTitle) {
        heroTitle.textContent = paramTipo === 'CONJUNTO' ? 'Conjuntos Importados'
          : paramTipo === 'BUSO' ? 'Busos & Hoodies' 
          : paramTipo === 'CAMISETA' ? 'Camisetas Streetwear'
          : paramTipo === 'CHAQUETA' ? 'Chaquetas Hombre'
          : 'Colección Hombre';
      }
      if (heroSlogan) {
        heroSlogan.textContent = paramTipo === 'CONJUNTO' ? 'Conjuntos exclusivos de chaqueta y pantalón importados con stock real.'
          : 'Chaquetas térmicas, busos exclusivos y piezas urbanas con stock real para hombre.';
      }
      document.title = (paramTipo === 'CONJUNTO' ? 'Conjuntos Hombre' : 'Colección Hombre') + ' | Estilo Nórdico Pasto';
    } else {
      if (heroTitle) {
        heroTitle.textContent = paramTipo === 'CONJUNTO' ? 'Conjuntos Importados'
          : paramTipo === 'BUSO' ? 'Busos & Hoodies'
          : paramTipo === 'CAMISETA' ? 'Camisetas Streetwear'
          : paramTipo === 'BERMUDA' ? 'Bermudas'
          : 'Chaquetas & Moda Streetwear';
      }
      if (heroSlogan) {
        heroSlogan.textContent = paramTipo === 'CONJUNTO' ? 'Conjuntos exclusivos de chaqueta y pantalón importados de alta gama.'
          : 'Para quienes buscan estilo, comodidad y protección. Paga al recibir en Pasto.';
      }
      document.title = (paramTipo === 'CONJUNTO' ? 'Conjuntos Importados' : 'Chaquetas & Moda Streetwear') + ' | Estilo Nórdico Pasto';
    }
  }

  function syncDepartmentUI() {
    // 1. Sync tabs
    deptTabs.forEach(tab => {
      const tabDept = tab.getAttribute('data-dept') || 'all';
      const isActive = tabDept === activeGender;
      if (isActive) {
        tab.className = 'dept-tab active-dept px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5';
      } else {
        tab.className = 'dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5';
      }
    });

    // 2. Sync select
    if (filterGender) {
      filterGender.value = activeGender;
    }

    updateHeroAndMeta();
  }

  // Sincronizar select de tipo si viene en URL
  if (paramTipo && filterType) {
    for (let i = 0; i < filterType.options.length; i++) {
      if (filterType.options[i].value.toUpperCase() === paramTipo) {
        filterType.selectedIndex = i;
        break;
      }
    }
  }

  const paramTallas = (urlParams.get('talla') || urlParams.get('tallas') || urlParams.get('size') || '')
    .split(',')
    .map(s => s.trim().toUpperCase())
    .filter(Boolean);
  const paramColors = (urlParams.get('color') || urlParams.get('colores') || '')
    .split(',')
    .map(c => c.trim().toUpperCase())
    .filter(Boolean);

  if (paramColors.length === 1 && filterColor) {
    for (let i = 0; i < filterColor.options.length; i++) {
      if (filterColor.options[i].value.toUpperCase() === paramColors[0]) {
        filterColor.selectedIndex = i;
        break;
      }
    }
  }

  if (paramTallas.length === 1 && filterSize) {
    for (let i = 0; i < filterSize.options.length; i++) {
      if (filterSize.options[i].value.toUpperCase() === paramTallas[0]) {
        filterSize.selectedIndex = i;
        break;
      }
    }
  }

  function applyFilters() {
    const selectedGender = filterGender ? filterGender.value : activeGender;
    activeGender = selectedGender;
    const selectedType = filterType ? filterType.value : (paramTipo || 'all');
    const color = filterColor ? filterColor.value : 'all';
    const size = filterSize ? filterSize.value : 'all';
    const status = filterStatus ? filterStatus.value : 'all';
    let visible = 0;

    items.forEach((item) => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      const colors = (el.dataset.colors || '').toUpperCase().split(',').filter(Boolean);
      const sizes = (el.dataset.sizes || '').toUpperCase().split(',').filter(Boolean);
      const availableSizes = (el.dataset.availableSizes || '').toUpperCase().split(',').filter(Boolean);
      const itemStatus = el.dataset.status || '';

      let show = true;

      // 1. Filtro estricto por Departamento (Hombre / Mujer)
      if (selectedGender !== 'all' && itemGender !== selectedGender) {
        show = false;
      }

      // 2. Filtro por tipo de prenda
      if (selectedType !== 'all' && itemType !== selectedType) {
        show = false;
      }

      // 3. Filtro por color
      if (color !== 'all') {
        if (!colors.includes(color.toUpperCase())) show = false;
      } else if (paramColors.length > 0) {
        const matchesAnyColor = paramColors.some(pc => colors.includes(pc));
        if (!matchesAnyColor) show = false;
      }
      
      // 4. Filtrar por talla
      if (size !== 'all') {
        const checkSizes = status === 'disponible' ? availableSizes : sizes;
        if (!checkSizes.includes(size.toUpperCase())) show = false;
      } else if (paramTallas.length > 0) {
        const checkSizes = status === 'disponible' ? availableSizes : sizes;
        const matchesAny = paramTallas.some(pt => checkSizes.includes(pt));
        if (!matchesAny) show = false;
      }

      if (status !== 'all' && itemStatus !== status) show = false;

      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (filterCount) {
      const genderLabel = selectedGender === 'mujer' ? 'en Colección Mujer' : selectedGender === 'hombre' ? 'en Colección Hombre' : 'en Catálogo';
      let countText = `${visible} producto${visible !== 1 ? 's' : ''} ${genderLabel}`;
      const filterLabels = [];
      if (selectedType !== 'all') filterLabels.push(`Prenda: ${selectedType}`);
      if (paramTallas.length > 0 && size === 'all') filterLabels.push(`Talla: ${paramTallas.join(', ')}`);
      if (paramColors.length > 0 && color === 'all') filterLabels.push(`Color: ${paramColors.join(', ')}`);
      if (filterLabels.length > 0) {
        countText += ` · ${filterLabels.join(' | ')}`;
      }
      filterCount.textContent = countText;
    }
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  // Click listeners para Department Tabs
  deptTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetDept = tab.getAttribute('data-dept') || 'all';
      activeGender = targetDept;
      syncDepartmentUI();

      // Actualizar URL limpia
      const newParams = new URLSearchParams(window.location.search);
      if (targetDept === 'all') {
        newParams.delete('genero');
        newParams.delete('cat');
      } else {
        newParams.set('genero', targetDept);
        newParams.delete('cat');
      }
      const newQuery = newParams.toString();
      window.history.replaceState({}, '', `${window.location.pathname}${newQuery ? `?${newQuery}` : ''}`);

      applyFilters();
    });
  });

  filterGender?.addEventListener('change', () => {
    activeGender = filterGender.value;
    syncDepartmentUI();
    const newParams = new URLSearchParams(window.location.search);
    if (activeGender === 'all') {
      newParams.delete('genero');
      newParams.delete('cat');
    } else {
      newParams.set('genero', activeGender);
      newParams.delete('cat');
    }
    const newQuery = newParams.toString();
    window.history.replaceState({}, '', `${window.location.pathname}${newQuery ? `?${newQuery}` : ''}`);
    applyFilters();
  });

  filterType?.addEventListener('change', applyFilters);
  filterColor?.addEventListener('change', applyFilters);
  filterSize?.addEventListener('change', applyFilters);
  filterStatus?.addEventListener('change', applyFilters);

  filterReset?.addEventListener('click', () => {
    activeGender = 'all';
    syncDepartmentUI();
    if (filterGender) filterGender.value = 'all';
    if (filterType) filterType.value = 'all';
    if (filterColor) filterColor.value = 'all';
    if (filterSize) filterSize.value = 'all';
    if (filterStatus) filterStatus.value = 'all';
    if (window.location.search) {
      window.history.replaceState({}, '', window.location.pathname);
    }
    applyFilters();
  });

  // Inicialización
  syncDepartmentUI();
  applyFilters();
</script>
