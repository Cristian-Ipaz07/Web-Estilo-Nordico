/**
 * /chaquetas/index.astro — Catálogo de chaquetas y prendas del ERP (Estilo Dark Mode Streetwear)
 * Filtros grupales multiselección por Prendas y Tallas, con Estado Disponible por defecto
 * y excepción permanente para Chaquetas Insignia 5080 y 5081.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { fetchJacketsFromERP } from '../../lib/erpApi';
import { getUniqueColors, getUniqueSizes } from '../../data/products';

const jackets = await fetchJacketsFromERP();
const colors = getUniqueColors(jackets);
const sizes = getUniqueSizes(jackets);

// Tipos de prendas disponibles en el catálogo
const apparelTypes = Array.from(new Set(jackets.map(j => {
  const sub = (j.subcategory || '').toUpperCase();
  const name = (j.name || '').toUpperCase();
  if (sub.includes('CHAQUETA')) return 'CHAQUETA';
  if (sub.includes('CONJUNTO') || name.includes('CONJUNTO')) return 'CONJUNTO';
  if (sub.includes('BUSO') || name.includes('BUSO') || name.includes('CAPUCHA')) return 'BUSO';
  if (sub.includes('CAMISETA')) return 'CAMISETA';
  if (sub.includes('BERMUDA')) return 'BERMUDA';
  if (sub.includes('JEAN')) return 'JEANS';
  if (sub.includes('PANTALON')) return 'PANTALON';
  return sub || 'PRENDA';
}))).filter(Boolean).sort();

// Conteo de productos disponibles por defecto (incluye Chaquetas 5080 y 5081)
const availableCount = jackets.filter(j => {
  const sub = (j.subcategory || '').toUpperCase();
  const isEvergreen = j.id.includes('5080') || j.id.includes('5081') || sub.includes('CHAQUETA');
  return isEvergreen || j.status === 'disponible';
}).length;

// Referencias únicas del catálogo para el desplegable de referencia / modelo
const referenceMap = new Map<string, { code: string; label: string; count: number }>();
for (const j of jackets) {
  const refCode = (j.reference || (
    j.id.match(/(5080|5081|3708|30861|1326|7647|7650|7651|8942|4978|\d{3,})/)?.[1] ||
    j.variants?.[0]?.referencia?.split('-')[0] ||
    'OTRO'
  )).toUpperCase();

  const refLabel = j.referenceName || (
    refCode === '5080' ? 'Chaqueta · Impermeable Hombre (5080)' :
    refCode === '5081' ? 'Chaqueta · Impermeable Dama (5081)' :
    refCode === '3708' ? 'Buso · Izan (3708)' :
    refCode === '30861' ? 'Buso · Mónaco Capucha (30861)' :
    refCode === '1326' ? 'Conjunto · Importado (1326)' :
    refCode === '8942' ? 'Camiseta · Ibk Oversize (8942)' :
    refCode === '7647' ? 'Camiseta · Importada (7647)' :
    refCode === '7650' ? 'Camiseta · Clemont / Estampada (7650)' :
    refCode === '7651' ? 'Camiseta · Multimarca (7651)' :
    refCode === '4978' ? 'Camiseta · Superdry (4978)' :
    `Prenda · Ref. ${refCode}`
  );

  if (!referenceMap.has(refCode)) {
    referenceMap.set(refCode, { code: refCode, label: refLabel, count: 0 });
  }
  referenceMap.get(refCode)!.count++;
}

// Subcategorías / Tipos de prenda únicos del catálogo (directo desde la app / ERP)
const subcategoryMap = new Map<string, { code: string; label: string; count: number; icon: string }>();

for (const j of jackets) {
  const sub = (j.subcategory || '').toUpperCase().trim();
  const name = (j.name || '').toUpperCase().trim();
  
  let code = 'OTRO';
  let label = 'Otras Prendas';
  let icon = '👕';

  if (sub.includes('CHAQUETA') || j.id.includes('5080') || j.id.includes('5081')) {
    code = 'CHAQUETA';
    label = 'Chaquetas';
    icon = '🧥';
  } else if (sub.includes('CAMISETA') || name.includes('CAMISETA') || name.includes('POLO')) {
    code = 'CAMISETA';
    label = 'Camisetas';
    icon = '👕';
  } else if (sub.includes('BUSO') || name.includes('BUSO') || name.includes('CAPUCHA')) {
    code = 'BUSO';
    label = 'Busos';
    icon = '🥋';
  } else if (sub.includes('CONJUNTO') || name.includes('CONJUNTO')) {
    code = 'CONJUNTO';
    label = 'Conjuntos';
    icon = '🏃‍♂️';
  } else if (sub.includes('BERMUDA')) {
    code = 'BERMUDA';
    label = 'Bermudas';
    icon = '🩳';
  } else if (sub.includes('JEAN')) {
    code = 'JEANS';
    label = 'Jeans';
    icon = '👖';
  } else if (sub.includes('PANTALON')) {
    code = 'PANTALON';
    label = 'Pantalones';
    icon = '👖';
  } else if (sub.includes('BILLETERA')) {
    code = 'BILLETERA';
    label = 'Billeteras';
    icon = '👛';
  } else if (sub) {
    code = sub;
    label = sub.charAt(0) + sub.slice(1).toLowerCase();
  }

  if (!subcategoryMap.has(code)) {
    subcategoryMap.set(code, { code, label, count: 0, icon });
  }
  subcategoryMap.get(code)!.count++;
}

const uniqueSubcategories = Array.from(subcategoryMap.values()).sort((a, b) => {
  const order = ['CHAQUETA', 'CAMISETA', 'BUSO', 'CONJUNTO', 'JEANS', 'PANTALON', 'BERMUDA', 'BILLETERA'];
  const idxA = order.indexOf(a.code);
  const idxB = order.indexOf(b.code);
  if (idxA !== -1 && idxB !== -1) return idxA - idxB;
  if (idxA !== -1) return -1;
  if (idxB !== -1) return 1;
  return a.label.localeCompare(b.label);
});

const uniqueReferences = Array.from(referenceMap.values()).sort((a, b) => {
  if (a.code === '5080') return -1;
  if (b.code === '5080') return 1;
  if (a.code === '5081') return -1;
  if (b.code === '5081') return 1;
  return a.label.localeCompare(b.label);
});
