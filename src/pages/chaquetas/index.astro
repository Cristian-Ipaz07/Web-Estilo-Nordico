<BaseLayout title="Ropa para Hombre y Mujer | Estilo Nórdico" description="Prendas de alta confección con stock real para hombre y mujer. Filtros grupales por prenda, color y talla. Paga al recibir en Pasto y envíos a todo el país.">
  
  <!-- Page Header (Premium Banner with bottom white fade) -->
  <section class="relative w-full h-[70vh] sm:h-[80vh] flex items-end overflow-hidden bg-black" id="chaquetas-hero">
    <!-- Image Background -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/baner cha.png" 
        alt="Colección Estilo Nórdico" 
        class="w-full h-full object-cover brightness-[0.75]"
        style="object-position: 80% center;"
        loading="eager"
      />
      <!-- Dark bottom gradient overlay that fades to white at the bottom edge -->
      <div class="absolute inset-0 bg-gradient-to-t from-white via-black/60 to-transparent z-10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-20 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
      <div class="max-w-2xl text-left">
        
        <!-- Minimalist Tagline -->
        <span class="inline-block border border-white/20 bg-white/5 backdrop-blur-md text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-widest mb-3">
          COLECCIÓN 2026 · HOMBRE & MUJER
        </span>

        <!-- Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-title font-black text-white leading-tight tracking-wider uppercase mb-3">
          Ropa para Hombre y Mujer
        </h1>

        <!-- Slogan -->
        <p class="text-xs sm:text-sm text-zinc-200 mb-5 font-light leading-relaxed max-w-md">
          Prendas urbanas, térmicas e importadas con stock real en Pasto. Paga en efectivo o Nequi al recibir en tu puerta.
        </p>

        <!-- Trust Signals (List style) -->
        <ul class="space-y-1.5 mb-6 text-xs text-white/90 font-semibold tracking-wider uppercase">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Calidad Premium Garantizada
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Entrega Inmediata en Pasto
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
            Pago Contra Entrega
          </li>
        </ul>

        <!-- CTA con scroll directo hacia las prendas y flecha animada -->
        <div>
          <a 
            href="#products-grid"
            class="inline-flex items-center justify-center gap-2.5 bg-[#C9A962] hover:bg-[#D4B878] text-[#0B0B0C] border-2 border-[#C9A962] hover:border-[#D4B878] font-black text-[11px] sm:text-xs uppercase tracking-widest px-7 py-3.5 rounded-md transition-all duration-300 cursor-pointer shadow-md group"
          >
            <span>Ver Colección Abajo</span>
            <svg class="w-4 h-4 text-black group-hover:translate-y-1 transition-transform animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Filters + Products -->
  <section class="py-8 sm:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Department Selector Tabs (Koaj / Zara / Mattelsa Style) -->
      <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6" id="department-tabs">
        <button 
          type="button" 
          class="dept-tab active-dept px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5"
          data-dept="all"
        >
          <span>🔥</span> Todo el Catálogo
        </button>
        <button 
          type="button" 
          class="dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5"
          data-dept="hombre"
        >
          <span>👔</span> Colección Hombre
        </button>
        <button 
          type="button" 
          class="dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5"
          data-dept="mujer"
        >
          <span>👗</span> Colección Mujer
        </button>
      </div>

      <!-- Filter Bar (Light Theme con Filtros Grupales) -->
      <div class="mb-8 p-5 sm:p-6 bg-[#F9F9FB] rounded-xl border border-[#E5E7EB] shadow-sm" id="filter-bar">
        
        <!-- Grupo 1: Selector Múltiple de Prendas (Botones Grandes) -->
        {uniqueSubcategories.length > 0 && (
          <div class="mb-5 pb-5 border-b border-[#E5E7EB]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-black text-text-main uppercase tracking-widest flex items-center gap-1.5">
                <span>👕</span> Tipo de Prenda <span class="text-text-muted font-normal lowercase tracking-normal">(selecciona una o varias: ej. Camisetas y Busos)</span>
              </span>
              <span id="badge-types-count" class="hidden text-[10px] font-black bg-[#0B0B0C] text-white px-2.5 py-0.5 rounded-full uppercase tracking-wider"></span>
            </div>
            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5" id="type-chips">
              <button 
                type="button" 
                class="type-chip active-chip px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5 select-none"
                data-type="all"
              >
                <span>🔥</span> Todas las prendas
              </button>
              {uniqueSubcategories.map(subItem => (
                <button 
                  type="button" 
                  class="type-chip px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wider transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5 select-none shadow-xs"
                  data-type={subItem.code}
                >
                  <span>{subItem.icon}</span>
                  <span>{subItem.label}</span>
                  <span class="text-[10px] text-text-muted font-normal">({subItem.count})</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Grupo 2: Selector Múltiple de Tallas (Chips) -->
        {sizes.length > 0 && (
          <div class="mb-5 pb-5 border-b border-[#E5E7EB]">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-[10px] font-black text-text-main uppercase tracking-widest flex items-center gap-1.5">
                <span>📏</span> Talla <span class="text-text-muted font-normal lowercase tracking-normal">(multiselección: ej. M y L a la vez)</span>
              </span>
              <span id="badge-sizes-count" class="hidden text-[9px] font-black bg-[#0B0B0C] text-white px-2 py-0.5 rounded-full uppercase tracking-wider"></span>
            </div>
            <div class="flex flex-wrap gap-2" id="size-chips">
              <button 
                type="button" 
                class="size-chip active-chip px-3.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5 select-none"
                data-size="all"
              >
                Todas las tallas
              </button>
              {sizes.map(size => (
                <button 
                  type="button" 
                  class="size-chip px-3.5 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F3F4F6] flex items-center gap-1.5 select-none min-w-[42px] justify-center"
                  data-size={size}
                >
                  {size}
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Toggle Desplegable para Filtros Avanzados (Referencia, Color, Estado) -->
        <div class="pt-2">
          <button 
            type="button" 
            id="toggle-advanced-btn" 
            class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-lg border border-[#E5E7EB] bg-white hover:bg-[#F3F4F6] text-xs font-black uppercase tracking-wider text-text-main transition-all cursor-pointer select-none shadow-sm"
          >
            <div class="flex items-center gap-2">
              <span class="text-sm">⚡</span>
              <span>Más Filtros (Tipo de Prenda, Referencia, Color, Estado)</span>
              <span id="badge-advanced-indicator" class="hidden text-[9px] bg-[#0B0B0C] text-white px-2 py-0.5 rounded-full font-bold">Activo</span>
            </div>
            <div class="flex items-center gap-1.5 text-text-muted">
              <span class="text-[10px] font-bold" id="toggle-advanced-text">Mostrar</span>
              <svg id="arrow-advanced-icon" class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>

          <!-- Panel Desplegable de Filtros Avanzados (Inicialmente Colapsado para ahorrar espacio) -->
          <div id="advanced-filters-panel" class="hidden mt-3 pt-3 border-t border-[#E5E7EB]">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
              
              <!-- Reference Filter Dropdown (con opciones para ir mostrando o quitando) -->
                            <!-- Subcategory / Tipo de Prenda Filter Dropdown (IGUAL COMO LAS REFERENCIAS) -->
              {uniqueSubcategories.length > 0 && (
                <div class="relative" id="subcat-dropdown-wrapper">
                  <label class="block text-[9px] font-black text-text-main mb-1.5 uppercase tracking-widest flex items-center justify-between">
                    <span>Tipo de Prenda / Subcategoría</span>
                    <span id="subcat-count-badge" class="hidden text-[8px] bg-[#0B0B0C] text-white px-1.5 py-0.5 rounded-full font-bold"></span>
                  </label>
                  
                  <button 
                    type="button" 
                    id="subcat-dropdown-btn"
                    class="w-full px-3 py-2 rounded-lg border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C] flex items-center justify-between transition-all cursor-pointer text-left shadow-xs"
                  >
                    <span id="subcat-dropdown-label" class="truncate pr-2">Todas las prendas</span>
                    <svg class="w-3.5 h-3.5 text-neutral-500 shrink-0 transition-transform duration-200" id="subcat-dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>

                  <!-- Menú de Subcategorías -->
                  <div 
                    id="subcat-dropdown-menu" 
                    class="hidden absolute top-full left-0 right-0 mt-1.5 bg-white border border-[#E5E7EB] rounded-xl shadow-2xl z-50 max-h-64 overflow-y-auto p-2 space-y-1"
                  >
                    <div class="flex items-center justify-between px-2 py-1.5 border-b border-[#F3F4F6] mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-text-muted">Mostrar / Ocultar</span>
                      <button type="button" id="subcat-select-all" class="text-[9px] font-bold text-blue-600 hover:underline cursor-pointer">Ver todas</button>
                    </div>
                    {uniqueSubcategories.map(subItem => (
                      <label class="subcat-checkbox-label flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg hover:bg-[#F9F9FB] cursor-pointer text-xs font-semibold text-text-main select-none transition-colors">
                        <input 
                          type="checkbox" 
                          class="subcat-checkbox rounded border-neutral-300 text-black focus:ring-0 w-3.5 h-3.5 accent-black cursor-pointer" 
                          value={subItem.code} 
                        />
                        <span class="mr-0.5">{subItem.icon}</span>
                        <span class="flex-1 truncate subcat-name">{subItem.label}</span>
                        <span class="text-[9px] text-text-muted font-bold shrink-0">({subItem.count})</span>
                      </label>
                    ))}
                  </div>
                </div>
              )}

              {uniqueReferences.length > 0 && (
                <div class="relative" id="ref-dropdown-wrapper">
                  <label class="block text-[9px] font-black text-text-main mb-1.5 uppercase tracking-widest flex items-center justify-between">
                    <span>Referencia / Modelo</span>
                    <span id="ref-count-badge" class="hidden text-[8px] bg-[#0B0B0C] text-white px-1.5 py-0.5 rounded-full font-bold"></span>
                  </label>
                  
                  <button 
                    type="button" 
                    id="ref-dropdown-btn"
                    class="w-full px-3 py-2 rounded-lg border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C] flex items-center justify-between transition-all cursor-pointer text-left"
                  >
                    <span id="ref-dropdown-label" class="truncate pr-2">Todas las referencias</span>
                    <svg class="w-3.5 h-3.5 text-neutral-500 shrink-0 transition-transform duration-200" id="ref-dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>

                  <!-- Menú de Referencias -->
                  <div 
                    id="ref-dropdown-menu" 
                    class="hidden absolute top-full left-0 right-0 mt-1.5 bg-white border border-[#E5E7EB] rounded-xl shadow-2xl z-50 max-h-64 overflow-y-auto p-2 space-y-1"
                  >
                    <div class="flex items-center justify-between px-2 py-1.5 border-b border-[#F3F4F6] mb-1">
                      <span class="text-[9px] font-black uppercase tracking-wider text-text-muted">Mostrar / Ocultar</span>
                      <button type="button" id="ref-select-all" class="text-[9px] font-bold text-blue-600 hover:underline cursor-pointer">Ver todas</button>
                    </div>
                    {uniqueReferences.map(refItem => (
                      <label class="ref-checkbox-label flex items-center gap-2.5 px-2.5 py-1.5 rounded-lg hover:bg-[#F9F9FB] cursor-pointer text-xs font-semibold text-text-main select-none transition-colors">
                        <input 
                          type="checkbox" 
                          class="ref-checkbox rounded border-neutral-300 text-black focus:ring-0 w-3.5 h-3.5 accent-black cursor-pointer" 
                          value={refItem.code} 
                        />
                        <span class="flex-1 truncate">{refItem.label}</span>
                        <span class="ref-count text-[9px] text-text-muted font-bold shrink-0">({refItem.count})</span>
                      </label>
                    ))}
                  </div>
                </div>
              )}

              <!-- Color filter -->
              <div>
                <label class="block text-[9px] font-black text-text-main mb-1.5 uppercase tracking-widest">Color</label>
                <select id="filter-color" class="w-full px-3 py-2 rounded-lg border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
                  <option value="all">Todos los colores</option>
                  {colors.map(color => (
                    <option value={color}>{color}</option>
                  ))}
                </select>
              </div>

              <!-- Status filter (Predeterminado: Disponibles) -->
              <div>
                <label class="block text-[9px] font-black text-text-main mb-1.5 uppercase tracking-widest">Estado</label>
                <select id="filter-status" class="w-full px-3 py-2 rounded-lg border border-[#E5E7EB] bg-white text-xs text-text-main uppercase tracking-wider font-semibold focus:outline-none focus:border-[#0B0B0C]">
                  <option value="disponible" selected>Disponibles (En Stock)</option>
                  <option value="all">Ver Todos (Incluye Agotados)</option>
                  <option value="agotado">Solo Agotados</option>
                </select>
              </div>

              <!-- Reset button -->
              <div>
                <button id="filter-reset" class="w-full py-2 px-3 rounded-lg text-[10px] font-black uppercase tracking-widest text-text-main border border-[#E5E7EB] bg-white hover:border-[#0B0B0C] hover:bg-[#F3F4F6] transition-all cursor-pointer">
                  Limpiar Filtros
                </button>
              </div>

            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-[#E5E7EB] flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-[11px] text-text-muted uppercase tracking-wider font-semibold" id="filter-count">
            {availableCount} productos disponibles
          </p>
          <a 
            href="#products-grid" 
            id="scroll-to-products" 
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-[10px] sm:text-[11px] font-black uppercase tracking-widest bg-[#0B0B0C] hover:bg-neutral-800 text-white transition-all shadow-sm group cursor-pointer"
          >
            <span>Ver prendas abajo</span>
            <svg class="w-3.5 h-3.5 text-[#C9A962] group-hover:translate-y-1 transition-transform animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Banner de disponibilidad por género (cuando se elige una prenda que solo existe para hombre) -->
      <div id="notice-gender-apparel" class="hidden mb-8 p-5 sm:p-6 bg-[#FEF3C7] border border-[#F59E0B]/60 rounded-2xl text-amber-950 shadow-sm transition-all">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
          <div class="flex items-center gap-3">
            <span class="text-3xl">🧥</span>
            <div>
              <h4 id="notice-gender-title" class="text-xs font-black uppercase tracking-wider text-amber-900 font-title">
                Prenda Disponible en Colección Hombre
              </h4>
              <p id="notice-gender-desc" class="text-xs text-amber-800 mt-0.5 font-light">
                Actualmente esta categoría está disponible en <strong>Colección Hombre</strong>. Para mujer tenemos Chaquetas Columbia y The North Face en 7 colores disponibles.
              </p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 justify-center sm:justify-end shrink-0">
            <button type="button" id="btn-notice-switch-hombre" class="px-4 py-2 bg-[#0B0B0C] hover:bg-neutral-800 text-white text-[11px] font-black uppercase tracking-wider rounded-lg transition-colors cursor-pointer shadow-sm">
              Ver en Colección Hombre →
            </button>
            <button type="button" id="btn-notice-switch-chaquetas" class="px-4 py-2 bg-[#C9A962] hover:bg-[#D4B878] text-black text-[11px] font-black uppercase tracking-wider rounded-lg transition-colors cursor-pointer shadow-sm">
              Ver Chaquetas de Mujer
            </button>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="products-grid">
        {jackets.map((product) => {
          const rawSub = (product.subcategory || '').toUpperCase();
          const rawName = (product.name || '').toUpperCase();
          const normalizedType = rawSub.includes('CHAQUETA') ? 'CHAQUETA'
            : (rawSub.includes('CONJUNTO') || rawName.includes('CONJUNTO')) ? 'CONJUNTO'
            : (rawSub.includes('BUSO') || rawName.includes('BUSO') || rawName.includes('CAPUCHA')) ? 'BUSO'
            : rawSub.includes('CAMISETA') ? 'CAMISETA'
            : rawSub.includes('BERMUDA') ? 'BERMUDA'
            : rawSub.includes('JEAN') ? 'JEANS'
            : rawSub.includes('PANTALON') ? 'PANTALON'
                        : rawSub || 'PRENDA';
          
          // Chaquetas 5080 y 5081 son productos evergreen permanentes que admiten sobrepedido constante de fábrica
          const isEvergreenJacket = normalizedType === 'CHAQUETA' || 
            product.id.includes('5080') || 
            product.id.includes('5081') || 
            product.slug.includes('5080') || 
            product.slug.includes('5081') ||
            product.slug.includes('chaqueta');

          const refCode = (product.reference || (
            product.id.match(/(5080|5081|3708|30861|1326|7647|7650|7651|8942|4978|\d{3,})/)?.[1] ||
            product.variants?.[0]?.referencia?.split('-')[0] ||
            'OTRO'
          )).toUpperCase();

          return (
              <div 
                class="product-item"
                data-id={product.id}
                data-ref={refCode}
                data-ref-name={product.referenceName || ''}
                data-type={normalizedType}
                data-gender={product.gender || 'hombre'}
              data-subcategory={rawSub}
              data-name={rawName}
              data-colors={product.variants?.map(v => v.color).join(',')}
              data-sizes={product.variants?.map(v => v.talla).join(',')}
              data-status={product.status}
              data-available-sizes={product.variants?.filter(v => v.status === 'disponible' && (v.stock || 0) > 0).map(v => v.talla).join(',')}
              data-is-evergreen={isEvergreenJacket ? 'true' : 'false'}
            >
              <ProductCard
                id={product.id}
                slug={product.slug}
                name={product.name}
                brand={product.brand}
                price={product.price}
                anchorPrice={product.anchorPrice}
                image={product.image}
                images={product.images}
                description={product.description}
                category="chaquetas"
                gender={product.gender}
                stock={product.stock}
                status={product.status}
                colorHex={product.colorHex}
                variants={product.variants}
              />
            </div>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-16">
        <span class="text-3xl mb-4 block">🔍</span>
        <p class="text-sm font-black text-text-main uppercase tracking-widest">No hay prendas con estos filtros</p>
        <p class="text-xs text-text-muted mt-1 uppercase tracking-wider">Intenta cambiar la combinación de prendas o probar con otras tallas</p>
        <button id="empty-reset-btn" class="mt-4 inline-block px-5 py-2.5 rounded-lg text-xs font-black uppercase tracking-widest bg-[#0B0B0C] text-white hover:bg-black transition-all cursor-pointer">
          Ver todas las prendas disponibles
        </button>
      </div>
    </div>
  </section>

  <!-- Cross-sell Banner -->
  <section class="py-16 bg-[#121214] border-t border-[#262626] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-title font-black uppercase tracking-widest mb-3">¿Y si le sumas un perfume?</h2>
      <p class="text-xs sm:text-sm text-[#A3A3A3] mb-6 max-w-lg mx-auto font-light leading-relaxed">
        Combo prenda + perfume original desde <strong>$130.000 COP</strong> con entrega inmediata hoy mismo en Pasto.
      </p>
      <a href="/perfumes" class="inline-flex items-center gap-2 border border-white hover:bg-white hover:text-[#0B0B0C] font-black text-[10px] sm:text-xs uppercase tracking-widest px-6 py-3 rounded-md transition-all duration-300">
        Ver perfumes →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const filterGender = document.getElementById('filter-gender') as HTMLSelectElement | null;
  const filterColor = document.getElementById('filter-color') as HTMLSelectElement | null;
  const filterStatus = document.getElementById('filter-status') as HTMLSelectElement | null;
  const filterReset = document.getElementById('filter-reset');
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const filterCount = document.getElementById('filter-count');
  const emptyState = document.getElementById('empty-state');
  const items = document.querySelectorAll('.product-item');
  const deptTabs = document.querySelectorAll('.dept-tab');

  // Estado de Filtros Grupales (Multiselección: Géneros, Prendas, Tallas y Referencias)
  const selectedGenders = new Set<string>();
  const selectedTypes = new Set<string>();
  const selectedSizes = new Set<string>();
  const selectedRefs = new Set<string>();

  const ACTIVE_TYPE_CLASS = 'type-chip active-chip px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-wider transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5 select-none';
  const INACTIVE_TYPE_CLASS = 'type-chip px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wider transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5 select-none shadow-xs';

  const ACTIVE_SIZE_CLASS = 'size-chip active-chip px-3.5 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5 select-none';
  const INACTIVE_SIZE_CLASS = 'size-chip px-3.5 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F3F4F6] flex items-center gap-1.5 select-none min-w-[42px] justify-center';

  // Soporte de Parámetros URL (ej: /chaquetas?genero=hombre&tipo=camiseta,buso&talla=M,L&estado=disponible)
  const urlParams = new URLSearchParams(window.location.search);
  const rawParamGender = (urlParams.get('genero') || urlParams.get('gender') || urlParams.get('cat') || '').trim().toLowerCase();
  let activeGender = 'all';
  if (rawParamGender.includes('hombre') || rawParamGender.includes('caballero')) selectedGenders.add('hombre');
  if (rawParamGender.includes('mujer') || rawParamGender.includes('dama')) selectedGenders.add('mujer');
  if (selectedGenders.size === 1) {
    activeGender = selectedGenders.has('hombre') ? 'hombre' : 'mujer';
  }

  // Parsear tipos iniciales desde URL (soporta múltiples separados por coma)
  const rawParamTipos = (urlParams.get('tipo') || urlParams.get('tipos') || urlParams.get('categoria') || '')
    .split(',')
    .map(s => s.trim().toUpperCase())
    .filter(Boolean);

  rawParamTipos.forEach(t => {
    const norm = t.includes('CONJUNTO') ? 'CONJUNTO'
      : t.includes('BUSO') ? 'BUSO'
      : t.includes('CAMISETA') ? 'CAMISETA'
      : t.includes('BERMUDA') ? 'BERMUDA'
      : t.includes('JEAN') ? 'JEANS'
      : t.includes('PANTALON') ? 'PANTALON'
            : t.includes('CHAQUETA') ? 'CHAQUETA'
      : t;
    selectedTypes.add(norm);
  });

  // Parsear tallas iniciales desde URL (soporta múltiples: ?talla=M,L)
  const rawParamTallas = (urlParams.get('talla') || urlParams.get('tallas') || urlParams.get('size') || '')
    .split(',')
    .map(s => s.trim().toUpperCase())
    .filter(Boolean);

  rawParamTallas.forEach(s => selectedSizes.add(s));

  // Parsear referencias iniciales desde URL (?ref=5080,3708 o ?referencia=...)
  const rawParamRefs = (urlParams.get('ref') || urlParams.get('referencia') || '')
    .split(',')
    .map(s => s.trim().toUpperCase())
    .filter(Boolean);

  rawParamRefs.forEach(r => selectedRefs.add(r));

  // Parsear colores iniciales desde URL
  const paramColors = (urlParams.get('color') || urlParams.get('colores') || '')
    .split(',')
    .map(c => c.trim().toUpperCase())
    .filter(Boolean);

  if (paramColors.length === 1 && filterColor) {
    for (let i = 0; i < filterColor.options.length; i++) {
      if (filterColor.options[i].value.toUpperCase() === paramColors[0]) {
        filterColor.selectedIndex = i;
        break;
      }
    }
  }

  // Parsear estado inicial desde URL (Por defecto: 'disponible')
  const paramEstado = (urlParams.get('estado') || urlParams.get('status') || 'disponible').toLowerCase();
  if (filterStatus) {
    filterStatus.value = (paramEstado === 'all' || paramEstado === 'agotado') ? paramEstado : 'disponible';
  }

  const ACTIVE_DEPT_CLASS = 'dept-tab active-dept px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-black uppercase tracking-widest transition-all cursor-pointer border border-[#0B0B0C] bg-[#0B0B0C] text-white shadow-sm flex items-center gap-1.5';
  const INACTIVE_DEPT_CLASS = 'dept-tab px-5 py-2.5 rounded-full text-[11px] sm:text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer border border-[#E5E7EB] bg-white text-text-main hover:border-[#0B0B0C] hover:bg-[#F9F9FB] flex items-center gap-1.5';

  // Funciones para calcular dinámicamente qué prendas, tallas y referencias existen para el género activo
  function getAvailableTypesForGender(gender: string): Set<string> {
    const set = new Set<string>();
    items.forEach(item => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      if (gender === 'all' || itemGender === gender) {
        if (itemType) set.add(itemType);
      }
    });
    return set;
  }

  function getAvailableSizesForContext(gender: string, types: Set<string>): Set<string> {
    const set = new Set<string>();
    items.forEach(item => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      const sizes = (el.dataset.sizes || '').toUpperCase().split(',').filter(Boolean);
      const matchesGender = (gender === 'all' || itemGender === gender);
      const matchesType = (types.size === 0 || types.has(itemType));
      if (matchesGender && matchesType) {
        sizes.forEach(s => set.add(s));
      }
    });
    return set;
  }

  function getRefCountsForContext(gender: string, types: Set<string>): Map<string, number> {
    const counts = new Map<string, number>();
    items.forEach(item => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      const itemRef = (el.dataset.ref || '').toUpperCase();
      const matchesGender = (gender === 'all' || itemGender === gender);
      const matchesType = (types.size === 0 || types.has(itemType));
      if (matchesGender && matchesType && itemRef) {
        counts.set(itemRef, (counts.get(itemRef) || 0) + 1);
      }
    });
    return counts;
  }

  function getAvailableColorsForContext(gender: string, types: Set<string>): Set<string> {
    const set = new Set<string>();
    items.forEach(item => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      const colors = (el.dataset.colors || '').toUpperCase().split(',').map(c => c.trim()).filter(Boolean);
      const matchesGender = (gender === 'all' || itemGender === gender);
      const matchesType = (types.size === 0 || types.has(itemType));
      if (matchesGender && matchesType) {
        colors.forEach(c => set.add(c));
      }
    });
    return set;
  }

  function syncDepartmentUI() {
    const allTab = document.querySelector('.dept-tab[data-dept="all"]');
    const hombreTab = document.querySelector('.dept-tab[data-dept="hombre"]');
    const mujerTab = document.querySelector('.dept-tab[data-dept="mujer"]');

    if (selectedGenders.size === 0) {
      // Todo el catálogo activo
      if (allTab) allTab.className = ACTIVE_DEPT_CLASS;
      if (hombreTab) hombreTab.className = INACTIVE_DEPT_CLASS;
      if (mujerTab) mujerTab.className = INACTIVE_DEPT_CLASS;
      if (filterGender) filterGender.value = 'all';
      activeGender = 'all';
    } else if (selectedGenders.size === 2) {
      // Ambos (Hombre y Mujer) seleccionados al tiempo!
      if (allTab) allTab.className = ACTIVE_DEPT_CLASS;
      if (hombreTab) hombreTab.className = ACTIVE_DEPT_CLASS;
      if (mujerTab) mujerTab.className = ACTIVE_DEPT_CLASS;
      if (filterGender) filterGender.value = 'all';
      activeGender = 'all';
    } else {
      // Solo uno seleccionado
      if (allTab) allTab.className = INACTIVE_DEPT_CLASS;
      const isHombre = selectedGenders.has('hombre');
      if (hombreTab) hombreTab.className = isHombre ? ACTIVE_DEPT_CLASS : INACTIVE_DEPT_CLASS;
      if (mujerTab) mujerTab.className = !isHombre ? ACTIVE_DEPT_CLASS : INACTIVE_DEPT_CLASS;
      if (filterGender) filterGender.value = isHombre ? 'hombre' : 'mujer';
      activeGender = isHombre ? 'hombre' : 'mujer';
    }

    updateHeroAndMeta();
  }

  function syncTypeChipsUI() {
    const typeChips = document.querySelectorAll('.type-chip');
    const badge = document.getElementById('badge-types-count');
    const allChip = document.querySelector('.type-chip[data-type="all"]') as HTMLElement | null;

    const availableTypesInCurrentDept = getAvailableTypesForGender(activeGender);

    // REGLA CRÍTICA: MANTENER SIEMPRE VISIBLES TODOS LOS CHIPS DE PRENDA
    // Así el usuario puede seleccionar cualquier prenda libremente tanto para hombre como para mujer
    typeChips.forEach(c => {
      const chip = c as HTMLElement;
      const t = (chip.getAttribute('data-type') || '').toUpperCase();
      chip.style.display = '';

      // Indicador informativo si la prenda actualmente solo existe en Hombre (Busos, Camisetas, Conjuntos) y se está en Mujer
      let badgeHombre = chip.querySelector('.chip-gender-badge') as HTMLElement | null;
      if (activeGender === 'mujer' && t !== 'ALL' && !availableTypesInCurrentDept.has(t)) {
        if (!badgeHombre) {
          badgeHombre = document.createElement('span');
          badgeHombre.className = 'chip-gender-badge text-[8px] bg-neutral-200 text-neutral-600 px-1 py-0.2 rounded font-black ml-1 select-none';
          badgeHombre.textContent = 'Hombre';
          chip.appendChild(badgeHombre);
        }
      } else {
        if (badgeHombre) badgeHombre.remove();
      }
    });

    if (selectedTypes.size === 0) {
      if (allChip) allChip.className = ACTIVE_TYPE_CLASS;
      if (badge) badge.classList.add('hidden');
      typeChips.forEach(c => {
        const chip = c as HTMLElement;
        if (chip.getAttribute('data-type') !== 'all') {
          chip.className = INACTIVE_TYPE_CLASS;
        }
      });
    } else {
      if (allChip) allChip.className = INACTIVE_TYPE_CLASS;
      if (badge) {
        badge.classList.remove('hidden');
        badge.textContent = `${selectedTypes.size} seleccionada${selectedTypes.size > 1 ? 's' : ''}`;
      }
      typeChips.forEach(c => {
        const chip = c as HTMLElement;
        const t = (chip.getAttribute('data-type') || '').toUpperCase();
        if (t && t !== 'ALL') {
          chip.className = selectedTypes.has(t) ? ACTIVE_TYPE_CLASS : INACTIVE_TYPE_CLASS;
        }
      });
    }
  }

  function syncSizeChipsUI() {
    const sizeChips = document.querySelectorAll('.size-chip');
    const badge = document.getElementById('badge-sizes-count');
    const allChip = document.querySelector('.size-chip[data-size="all"]') as HTMLElement | null;

    const availableSizes = getAvailableSizesForContext(activeGender, selectedTypes);

    // Ocultar tallas que no existan para el género y prendas actualmente activas
    sizeChips.forEach(c => {
      const chip = c as HTMLElement;
      const s = (chip.getAttribute('data-size') || '').toUpperCase();
      if (s === 'ALL') {
        chip.style.display = '';
      } else if (availableSizes.has(s)) {
        chip.style.display = '';
      } else {
        chip.style.display = 'none';
        if (selectedSizes.has(s)) {
          selectedSizes.delete(s);
        }
      }
    });

    if (selectedSizes.size === 0) {
      if (allChip) allChip.className = ACTIVE_SIZE_CLASS;
      if (badge) badge.classList.add('hidden');
      sizeChips.forEach(c => {
        const chip = c as HTMLElement;
        if (chip.getAttribute('data-size') !== 'all') {
          chip.className = INACTIVE_SIZE_CLASS;
        }
      });
    } else {
      if (allChip) allChip.className = INACTIVE_SIZE_CLASS;
      if (badge) {
        badge.classList.remove('hidden');
        badge.textContent = `${selectedSizes.size} seleccionada${selectedSizes.size > 1 ? 's' : ''}`;
      }
      sizeChips.forEach(c => {
        const chip = c as HTMLElement;
        const s = (chip.getAttribute('data-size') || '').toUpperCase();
        if (s && s !== 'ALL') {
          chip.className = selectedSizes.has(s) ? ACTIVE_SIZE_CLASS : INACTIVE_SIZE_CLASS;
        }
      });
    }
  }

  function updateURL() {
    const newParams = new URLSearchParams();
    if (selectedGenders.size === 1) {
      newParams.set('genero', Array.from(selectedGenders)[0]);
    } else if (selectedGenders.size === 2) {
      newParams.set('genero', 'hombre,mujer');
    }
    if (selectedTypes.size > 0) {
      newParams.set('tipo', Array.from(selectedTypes).join(',').toLowerCase());
    }
    if (selectedSizes.size > 0) {
      newParams.set('talla', Array.from(selectedSizes).join(','));
    }
    if (selectedRefs.size > 0) {
      newParams.set('ref', Array.from(selectedRefs).join(',').toLowerCase());
    }
    if (filterColor && filterColor.value !== 'all') {
      newParams.set('color', filterColor.value.toLowerCase());
    }
    if (filterStatus && filterStatus.value !== 'disponible') {
      newParams.set('estado', filterStatus.value);
    }
    const newQuery = newParams.toString();
    window.history.replaceState({}, '', `${window.location.pathname}${newQuery ? `?${newQuery}` : ''}`);
  }

  function updateHeroAndMeta() {
    const heroTitle = document.querySelector('#chaquetas-hero h1');
    const heroSlogan = document.querySelector('#chaquetas-hero p');

    const typesList = Array.from(selectedTypes);
    const singleType = typesList.length === 1 ? typesList[0] : null;

    // Nombres limpios y generales de subcategoría
    const cleanLabel = singleType === 'CHAQUETA' ? 'Chaquetas'
      : singleType === 'CONJUNTO' ? 'Conjuntos'
      : singleType === 'BUSO' ? 'Busos'
      : singleType === 'CAMISETA' ? 'Camisetas'
      : singleType === 'BERMUDA' ? 'Bermudas'
      : singleType === 'JEANS' ? 'Jeans'
      : singleType === 'PANTALON' ? 'Pantalones'
      : singleType ? singleType.toLowerCase()
      : null;

    const typesInMujer = getAvailableTypesForGender('mujer');

    if (activeGender === 'mujer') {
      if (singleType && !typesInMujer.has(singleType)) {
        // La prenda seleccionada aún no existe para mujer: explicamos que está en Hombre
        if (heroTitle) heroTitle.textContent = `${cleanLabel} · Colección Hombre`;
        if (heroSlogan) heroSlogan.textContent = `Actualmente los ${cleanLabel} están disponibles en Colección Hombre. Para mujer disponemos de Chaquetas térmicas e impermeables.`;
        document.title = `${cleanLabel} | Estilo Nórdico Pasto`;
      } else {
        if (heroTitle) {
          heroTitle.textContent = cleanLabel ? `${cleanLabel} Mujer` : 'Colección Mujer';
        }
        if (heroSlogan) heroSlogan.textContent = 'Prendas con diseño, horma y confección exclusiva para mujer. Entrega inmediata en Pasto.';
        document.title = (cleanLabel ? `${cleanLabel} Mujer` : 'Colección Mujer') + ' | Estilo Nórdico Pasto';
      }
    } else if (activeGender === 'hombre') {
      if (heroTitle) {
        heroTitle.textContent = cleanLabel ? `${cleanLabel} Hombre` : 'Colección Hombre';
      }
      if (heroSlogan) {
        heroSlogan.textContent = 'Prendas urbanas, confortables y durables con stock real en Pasto y envíos nacionales.';
      }
      document.title = (cleanLabel ? `${cleanLabel} Hombre` : 'Colección Hombre') + ' | Estilo Nórdico Pasto';
    } else {
      if (heroTitle) {
        heroTitle.textContent = cleanLabel || (typesList.length > 1 ? 'Ropa Seleccionada' : 'Ropa para Hombre y Mujer');
      }
      if (heroSlogan) {
        heroSlogan.textContent = 'Prendas urbanas con confección nacional e importada. Paga en efectivo o Nequi al recibir en Pasto.';
      }
      document.title = (cleanLabel ? `${cleanLabel}` : 'Ropa para Hombre y Mujer') + ' | Estilo Nórdico Pasto';
    }
  }

  function applyFilters() {
    const selectedGender = filterGender ? filterGender.value : activeGender;
    activeGender = selectedGender;
    const color = filterColor ? filterColor.value : 'all';
    // Estado predeterminado en 'disponible' si no está definido
    const status = filterStatus ? filterStatus.value : 'disponible';
    let visible = 0;

    // REORGANIZACIÓN / ORDENAMIENTO POR TALLA:
    // Al filtrar por una o más tallas (ej. M), se organizan primero en el DOM las prendas que tienen disponible esa talla en stock
    if (selectedSizes.size > 0) {
      const grid = document.getElementById('products-grid');
      if (grid) {
        const sortedItems = Array.from(items).sort((a, b) => {
          const elA = a as HTMLElement;
          const elB = b as HTMLElement;
          const availA = (elA.dataset.availableSizes || '').toUpperCase().split(',').filter(Boolean);
          const availB = (elB.dataset.availableSizes || '').toUpperCase().split(',').filter(Boolean);
          const hasA = Array.from(selectedSizes).some(s => availA.includes(s));
          const hasB = Array.from(selectedSizes).some(s => availB.includes(s));
          if (hasA && !hasB) return -1;
          if (!hasA && hasB) return 1;
          return 0;
        });
        sortedItems.forEach(item => grid.appendChild(item));
      }
    }

    items.forEach((item) => {
      const el = item as HTMLElement;
      const itemGender = (el.dataset.gender || 'hombre').toLowerCase();
      const itemType = (el.dataset.type || '').toUpperCase();
      const colors = (el.dataset.colors || '').toUpperCase().split(',').filter(Boolean);
      const sizes = (el.dataset.sizes || '').toUpperCase().split(',').filter(Boolean);
      const availableSizes = (el.dataset.availableSizes || '').toUpperCase().split(',').filter(Boolean);
      const itemStatus = el.dataset.status || '';
      const itemRef = (el.dataset.ref || '').toUpperCase();
      const isEvergreen = el.dataset.isEvergreen === 'true';

      let show = true;

      // 1. Filtro grupal por Departamento (Hombre / Mujer seleccionables al tiempo)
      if (selectedGenders.size === 1) {
        if (!selectedGenders.has(itemGender)) {
          show = false;
        }
      }

      // 2. Filtro grupal por tipo de prenda (Multiselección: ej. Camisetas y Busos)
      if (selectedTypes.size > 0 && !selectedTypes.has(itemType)) {
        show = false;
      }

      // 3. Filtro por color
      if (color !== 'all') {
        if (!colors.includes(color.toUpperCase())) show = false;
      } else if (paramColors.length > 0) {
        const matchesAnyColor = paramColors.some(pc => colors.includes(pc));
        if (!matchesAnyColor) show = false;
      }
      
      // 4. Filtro grupal por talla (Multiselección: ej. M y L a la vez)
      if (selectedSizes.size > 0) {
        // En modo 'disponible' (por defecto), evaluamos exclusivamente las tallas con stock real disponible.
        // Esto evita que chaquetas o prendas agotadas en talla M aparezcan cuando el cliente busca específicamente talla M.
        const checkSizes = (status === 'disponible') ? availableSizes : sizes;
        const matchesAnySelectedSize = Array.from(selectedSizes).some(sz => checkSizes.includes(sz));
        if (!matchesAnySelectedSize) show = false;
      }

      // 5. Filtro por estado (Disponibles / Agotados / Todos)
      // REGLA CRÍTICA DE NEGOCIO: Las chaquetas 5080 y 5081 NUNCA se ocultan cuando el filtro es 'disponible'
      if (status === 'disponible') {
        if (!isEvergreen && itemStatus !== 'disponible') {
          show = false;
        }
      } else if (status === 'agotado') {
        if (isEvergreen || itemStatus !== 'agotado') {
          show = false;
        }
      }

      // 6. Filtro por referencia / modelo (Multiselección desde el desplegable)
      if (selectedRefs.size > 0 && !selectedRefs.has(itemRef)) {
        show = false;
      }

      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    // Control del aviso de género / prendas disponibles
    const noticeGender = document.getElementById('notice-gender-apparel');
    const noticeTitle = document.getElementById('notice-gender-title');
    const noticeDesc = document.getElementById('notice-gender-desc');
    const typesInMujer = getAvailableTypesForGender('mujer');
    const onlyHombreSelected = selectedTypes.size > 0 && Array.from(selectedTypes).every(t => !typesInMujer.has(t));

    if (activeGender === 'mujer' && onlyHombreSelected && visible === 0) {
      if (noticeGender) {
        noticeGender.classList.remove('hidden');
        const typesStr = Array.from(selectedTypes).map(t => {
          return t === 'BUSO' ? 'Busos' : t === 'CAMISETA' ? 'Camisetas' : t === 'CONJUNTO' ? 'Conjuntos' : t;
        }).join(', ');
        if (noticeTitle) noticeTitle.textContent = `Aún no hay ${typesStr} disponibles para Mujer`;
        if (noticeDesc) noticeDesc.innerHTML = `Actualmente los ${typesStr} están disponibles en <strong>Colección Hombre</strong> (stock para entrega hoy en Pasto). Para mujer disponemos de <strong>Chaquetas térmicas Columbia y The North Face</strong> en 7 colores.`;
      }
    } else {
