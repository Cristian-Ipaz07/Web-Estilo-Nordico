---
/**
 * index.astro — Página de inicio de Estilo Nórdico (Ajustada a Fondo Claro con Banners Oscuros)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchJacketsFromERP } from '../lib/erpApi';
import { perfumes, relojes, formatPrice } from '../data/products';
import { STORE_CONFIG } from '../config/store';

// Fetch dynamic jackets from ERP
const jackets = await fetchJacketsFromERP();

// Selección curada de 8 productos destacados top (prendas emblemáticas + perfume insignia + reloj insignia)
const topClothing = [
  jackets.find(j => j.id.includes('5080') && j.name.includes('Negro')) || jackets.find(j => j.id.includes('5080')),
  jackets.find(j => j.id.includes('5081')) || jackets.find(j => j.gender === 'mujer'),
  jackets.find(j => j.reference === '3708' || j.name.toLowerCase().includes('izan')),
  jackets.find(j => j.reference === '8942' || j.name.toLowerCase().includes('ibk')),
  jackets.find(j => j.reference === '1326' || j.name.toLowerCase().includes('conjunto')),
  jackets.find(j => j.reference === '1536' || j.name.toLowerCase().includes('polo')),
].filter(Boolean) as typeof jackets;

const topPerfume = perfumes.find(p => p.id === 'perf-01' || p.name.includes('Ohm')) || perfumes[0];
const topReloj = relojes.find(r => r.id === 'rel-01' || r.name.includes('Curren')) || relojes[0];

const featuredProducts = [...topClothing, topPerfume, topReloj].slice(0, 8);

// Find the hook jacket
const hookProduct = jackets.find(j => j.hook) || jackets[0];
---

<BaseLayout title="Moda & Fragancias Premium" description="Chaquetas de confección nacional, perfumes de catálogo y relojes de lujo. Paga al recibir en Pasto y envíos nacionales rápidos.">
  
  <!-- Hero Section (lifestyle background fading to white at the bottom) -->
  <Hero product={hookProduct} />

  <!-- 1. Trust Signals (Streetwear Minimalist divide, No Emojis, No Icons) -->
  <section class="py-12 bg-white border-b border-[#E5E7EB] relative z-20" id="trust-signals">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-8 lg:gap-y-0 divide-y lg:divide-y-0 lg:divide-[#E5E7EB] divide-[#E5E7EB]">
        
        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">01 / Entrega en Pasto</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Paga al Recibir</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Domicilio y pago en casa gratis en Pasto</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">02 / Envíos</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Cobertura Nacional</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Envíos seguros de 3 a 5 días hábiles</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">03 / Confección</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Calidad Premium</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Producción nacional con costura reforzada</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">04 / Soporte</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Atención Express</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Asesoría directa vía chat de WhatsApp</p>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Banners de Categorías (Grilla Editorial de Fotos 3:4 con Texto en la Esquina Inferior Izquierda) -->
  <section class="py-16 sm:py-24 bg-white" id="categories">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest mb-3">Colección Principal</span>
        <h2 class="text-2xl sm:text-4xl font-title font-black text-text-main uppercase tracking-widest">Categorías</h2>
      </div>

      <!-- Categories Editorial Grid (Aspect Ratio 3:4) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        
        <!-- Category: Chaquetas -->
        <a href="/chaquetas" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/Estilo nordico a futuro.png" 
            alt="Chaquetas Estilo Nórdico" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.4] group-hover:scale-105 group-hover:brightness-[0.45] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Chaquetas</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Confección Nacional Premium</p>
          </div>
        </a>

        <!-- Category: Perfumes -->
        <a href="/perfumes" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/products/perfumes/Ohm Perfume.jpg" 
            alt="Perfumes de Catálogo" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.35] group-hover:scale-105 group-hover:brightness-[0.4] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Perfumes</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Fragancias de Catálogo</p>
          </div>
        </a>

        <!-- Category: Relojes -->
        <a href="/relojes" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/products/relojes/rel-04.png" 
            alt="Relojes de Lujo" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.35] group-hover:scale-105 group-hover:brightness-[0.4] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Relojes</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Cronógrafos Premium</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- 4. Seccion de Oferta Especial: Dúo 2 Chaquetas por $160.000 -->
  <section class="py-16 sm:py-24 bg-[#0E0E10] border-t border-[#262626] text-white relative overflow-hidden" id="combos">
    <!-- Luz ambiental de fondo -->
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-[#C9A962]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-10 w-80 h-80 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Encabezado de la Seccion -->
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <div class="inline-flex items-center gap-2 bg-red-600/20 border border-red-500/40 text-red-400 text-[10px] font-black px-3.5 py-1.5 rounded-full uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>¡Promoción Especial Vigente!</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black font-title uppercase tracking-wider text-white">
          Lleva 2 Chaquetas por solo <span class="text-[#C9A962]">$160.000</span>
        </h2>
        <p class="text-xs sm:text-sm text-[#A3A3A3] mt-3 font-light leading-relaxed">
          Ahorras $20.000 COP en tu combo. Puedes elegir y combinar libremente entre 7 colores para hombre y 7 colores para mujer con pago contraentrega en Pasto.
        </p>
      </div>

      <!-- Contenedor Principal de la Promocion -->
      <div class="bg-[#141416] border border-[#2E2E32] hover:border-[#C9A962]/50 rounded-2xl p-5 sm:p-8 lg:p-10 shadow-2xl transition-all duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Flyer Oficial de la Promocion -->
          <div class="lg:col-span-5 flex flex-col items-center">
            <a
              href="/assets/promocion-2-chaquetas.jpg"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block w-full max-w-md overflow-hidden rounded-xl border border-white/10 hover:border-[#C9A962] shadow-xl bg-black transition-all duration-300"
              title="Click para ver el flyer en tamaño completo"
            >
              <img
                src="/assets/promocion-2-chaquetas.jpg"
                alt="Promoción Especial: Lleva 2 Chaquetas por $160.000 en Estilo Nórdico Pasto"
                class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-4">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider bg-black/80 text-[#C9A962] border border-[#C9A962]/50 px-3 py-1.5 rounded-md backdrop-blur-sm">
                  🔍 Ver Flyer Completo en HD
                </span>
              </div>
            </a>
            <p class="text-[10px] text-neutral-400 mt-2.5 font-medium tracking-wide text-center">
              * Flyer oficial con especificaciones y muestrario de colores.
            </p>
          </div>

          <!-- Columna Derecha: Ficha de Beneficios, Colores y Boton WhatsApp -->
          <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
            
            <!-- Precios y Descuento -->
            <div>
              <div class="flex flex-wrap items-center gap-2.5 mb-2">
                <span class="bg-[#C9A962] text-black text-[10px] font-black px-2.5 py-1 rounded uppercase tracking-widest">
                  Pack Dúo Pareja / Amigos
                </span>
                <span class="bg-red-600 text-white text-[10px] font-black px-2.5 py-1 rounded uppercase tracking-widest shadow-sm">
                  Ahorras $20.000
                </span>
                <span class="text-xs text-neutral-400 font-medium">
                  1 Chaqueta: <strong class="text-white">$90.000</strong>
                </span>
              </div>

              <div class="flex items-baseline gap-3 mt-2">
                <span class="text-3xl sm:text-5xl font-black text-white font-title tracking-tight">$160.000</span>
                <span class="text-base sm:text-lg text-neutral-500 line-through font-semibold">$180.000</span>
                <span class="text-xs sm:text-sm font-black text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded">
                  $80.000 c/u
                </span>
              </div>
              <p class="text-xs text-[#A3A3A3] mt-1 font-light">
                Aplica llevando 2 chaquetas térmicas de cualquier combinación de color y talla.
              </p>
            </div>

            <!-- Caracteristicas Tecnicas (Destacadas del Flyer) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 border-y border-[#262626] py-4">
              <div class="flex items-start gap-2.5">
                <span class="text-base">🪶</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Livianas</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Cómodas sin sensación pesada</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base">🔥</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Abrigadoras</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Térmicas para clima de Pasto</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base">🌧️</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Impermeables</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Resistentes a lluvia y viento</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base">🧥</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Capucha</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Capucha integrada y cuello alto</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base">🔒</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Bolsillos</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Bolsillos laterales con cierre</p>
                </div>
              </div>

              <div class="flex items-start gap-2.5">
                <span class="text-base">⭐</span>
                <div>
                  <h4 class="text-xs font-bold text-white uppercase tracking-wider">Garantía</h4>
                  <p class="text-[10px] text-neutral-400 font-light">Cambio de talla garantizado</p>
                </div>
              </div>
            </div>

            <!-- Desglose de Colores Disponibles -->
            <div class="space-y-3">
              <span class="text-[11px] font-black uppercase tracking-widest text-[#C9A962] block">
                Disponibles en 7 Colores por Género:
              </span>
              
              <!-- Hombre -->
              <div>
                <span class="text-[10px] font-black uppercase tracking-wider text-neutral-300 block mb-1.5">
                  Para Hombre:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Negro</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Beige</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Rojo</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Azul Oscuro</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Verde Militar</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Gris Claro</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Gris Ratón</span>
                </div>
              </div>

              <!-- Mujer -->
              <div>
                <span class="text-[10px] font-black uppercase tracking-wider text-neutral-300 block mb-1.5">
                  Para Mujer:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Negro</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Rojo</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Verde Menta</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Palo de Rosa</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Azul</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Beige</span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-neutral-800 text-white border border-neutral-700">Blanco</span>
                </div>
              </div>
            </div>

            <!-- Botones de Accion y WhatsApp -->
            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <a
                href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent('*SOLICITUD DE PROMOCIÓN 2 CHAQUETAS POR $160.000 (PASTO)*\n\n¡Hola! Deseo aprovechar la promoción especial de 2 chaquetas por $160.000 COP.\n\n📍 _Por favor confírmame disponibilidad de colores y tallas para hombre/mujer y coordino mi entrega con pago contraentrega en Pasto._')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 py-4 px-6 text-center bg-red-600 hover:bg-red-700 text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all duration-300 shadow-xl hover:shadow-red-600/30 hover:scale-[1.02] flex items-center justify-center gap-2 group cursor-pointer"
              >
                <span>💬 Escríbenos y Pide tu Promoción por WhatsApp</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>

              <a
                href="/chaquetas"
                class="py-4 px-6 text-center bg-neutral-900 hover:bg-neutral-800 text-neutral-200 border border-neutral-700 hover:border-[#C9A962] font-black text-xs uppercase tracking-widest rounded-xl transition-all duration-300"
              >
                Ver Modelos en Catálogo
              </a>
            </div>

            <!-- Confianza local Pasto -->
            <div class="flex flex-wrap items-center justify-between text-[10px] text-neutral-400 pt-1 border-t border-[#1F1F23]">
              <span class="flex items-center gap-1">✅ Pago contraentrega en Pasto</span>
              <span class="flex items-center gap-1">🚚 Entrega hoy mismo</span>
              <span class="flex items-center gap-1">📍 Showroom físico en Pasto</span>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>

  
  <!-- 3. Featured Products (Light Mode Streetwear Grid) -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#E5E7EB]" id="featured-products">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest mb-3">Top Ventas</span>
        <h2 class="text-2xl sm:text-4xl font-title font-black text-text-main uppercase tracking-widest">Productos Destacados</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {featuredProducts.map((product, index) => (
          <div class={`fade-in fade-in-delay-${(index % 4) + 1}`}>
            <ProductCard
              id={product.id}
              slug={product.slug}
              name={product.name}
              brand={product.brand}
              price={product.price}
              anchorPrice={product.anchorPrice}
              image={product.image}
              images={product.images}
              description={product.description}
              category={product.category}
              stock={product.stock}
              status={product.status}
              colorHex={product.colorHex}
              variants={product.variants}
            />
          </div>
        ))}
      </div>

      <!-- Botón para ver todo el catálogo completo -->
      <div class="mt-12 text-center">
        <a 
          href="/chaquetas"
          class="inline-flex items-center justify-center gap-3 bg-[#0B0B0C] hover:bg-neutral-800 text-white font-black text-xs sm:text-sm uppercase tracking-widest px-8 py-4.5 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-[1.02] cursor-pointer border border-white/10 group"
        >
          <span>Ver Todo el Catálogo de Ropa (50+ Modelos Disponibles)</span>
          <svg class="w-4 h-4 text-[#C9A962] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Showroom & Tienda Física en Pasto (Mapa y Video Cómo Llegar) -->
  <section class="py-16 sm:py-24 bg-[#FAFBFC] border-t border-[#E5E7EB]" id="tienda-fisica">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="inline-block text-[#C9A962] text-[10px] font-black uppercase tracking-widest mb-2">Visítanos en Pasto</span>
        <h2 class="text-2xl sm:text-4xl font-title font-black text-text-main uppercase tracking-widest">Tienda Física & Showroom</h2>
        <p class="text-xs sm:text-sm text-text-muted mt-2 font-light leading-relaxed">
          Pruébate tus prendas favoritas, conoce nuestras fragancias originales y recibe atención personalizada en nuestro punto físico en Pasto.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        
        <!-- Columna 1: Mapa Interactivo de Google Maps -->
        <div class="bg-white border border-[#E5E7EB] rounded-2xl p-4 sm:p-6 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div>
                <span class="text-[9px] font-black uppercase tracking-widest text-text-muted">Ubicación GPS</span>
                <h3 class="text-base sm:text-lg font-black uppercase tracking-wider text-text-main font-title">Punto Showroom Pasto</h3>
              </div>
              <span class="bg-[#10B981]/10 text-[#10B981] text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
                Abierto Hoy
              </span>
            </div>

            <!-- Google Maps Embed -->
            <div class="relative w-full h-80 sm:h-[460px] rounded-xl overflow-hidden border border-[#E5E7EB] shadow-inner mb-4">
