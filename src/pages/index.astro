---
/**
 * index.astro — Página de inicio de Estilo Nórdico (Ajustada a Fondo Claro con Banners Oscuros)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchJacketsFromERP } from '../lib/erpApi';
import { perfumes, relojes, formatPrice } from '../data/products';
import { STORE_CONFIG } from '../config/store';

// Fetch dynamic jackets from ERP
const jackets = await fetchJacketsFromERP();

// Filter featured products
const featuredJackets = jackets.filter(j => j.featured);
const featuredPerfumes = perfumes.filter(p => p.featured);
const featuredRelojes = relojes.filter(r => r.featured);
const featuredProducts = [...featuredJackets, ...featuredPerfumes, ...featuredRelojes];

// Find the hook jacket
const hookProduct = jackets.find(j => j.hook) || jackets[0];
---

<BaseLayout title="Moda & Fragancias Premium" description="Chaquetas de confección nacional, perfumes de catálogo y relojes de lujo. Paga al recibir en Pasto y envíos nacionales rápidos.">
  
  <!-- Hero Section (lifestyle background fading to white at the bottom) -->
  <Hero product={hookProduct} />

  <!-- 1. Trust Signals (Streetwear Minimalist divide, No Emojis, No Icons) -->
  <section class="py-12 bg-white border-b border-[#E5E7EB] relative z-20" id="trust-signals">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-8 lg:gap-y-0 divide-y lg:divide-y-0 lg:divide-[#E5E7EB] divide-[#E5E7EB]">
        
        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">01 / Entrega en Pasto</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Paga al Recibir</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Domicilio y pago en casa gratis en Pasto</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">02 / Envíos</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Cobertura Nacional</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Envíos seguros de 3 a 5 días hábiles</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">03 / Confección</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Calidad Premium</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Producción nacional con costura reforzada</p>
        </div>

        <div class="flex flex-col gap-1 px-6 py-2 justify-center text-left pt-6 lg:pt-2">
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest">04 / Soporte</span>
          <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-widest font-title mt-1">Atención Express</h3>
          <p class="text-[11px] text-text-muted font-light mt-0.5 leading-relaxed">Asesoría directa vía chat de WhatsApp</p>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Banners de Categorías (Grilla Editorial de Fotos 3:4 con Texto en la Esquina Inferior Izquierda) -->
  <section class="py-16 sm:py-24 bg-white" id="categories">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest mb-3">Colección Principal</span>
        <h2 class="text-2xl sm:text-4xl font-title font-black text-text-main uppercase tracking-widest">Categorías</h2>
      </div>

      <!-- Categories Editorial Grid (Aspect Ratio 3:4) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        
        <!-- Category: Chaquetas -->
        <a href="/chaquetas" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/Estilo nordico a futuro.png" 
            alt="Chaquetas Estilo Nórdico" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.4] group-hover:scale-105 group-hover:brightness-[0.45] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Chaquetas</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Confección Nacional Premium</p>
          </div>
        </a>

        <!-- Category: Perfumes -->
        <a href="/perfumes" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/products/perfumes/Ohm Perfume.jpg" 
            alt="Perfumes de Catálogo" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.35] group-hover:scale-105 group-hover:brightness-[0.4] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Perfumes</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Fragancias de Catálogo</p>
          </div>
        </a>

        <!-- Category: Relojes -->
        <a href="/relojes" class="group block relative overflow-hidden rounded-md aspect-[3/4] border border-[#E5E7EB] transition-all duration-500">
          <img 
            src="/assets/products/relojes/rel-04.png" 
            alt="Relojes de Lujo" 
            class="object-cover absolute inset-0 w-full h-full brightness-[0.35] group-hover:scale-105 group-hover:brightness-[0.4] transition-all duration-700" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-transparent"></div>
          <div class="absolute bottom-6 left-6 text-left text-white z-10">
            <h3 class="text-lg font-title font-black uppercase tracking-widest">Relojes</h3>
            <p class="text-[9px] text-[#A3A3A3] mt-1 font-black tracking-widest uppercase">Cronógrafos Premium</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- 3. Featured Products (Light Mode Streetwear Grid) -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#E5E7EB]" id="featured-products">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest mb-3">Top Ventas</span>
        <h2 class="text-2xl sm:text-4xl font-title font-black text-text-main uppercase tracking-widest">Productos Destacados</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {featuredProducts.map((product, index) => (
          <div class={`fade-in fade-in-delay-${(index % 4) + 1}`}>
            <ProductCard
              id={product.id}
              slug={product.slug}
              name={product.name}
              brand={product.brand}
              price={product.price}
              anchorPrice={product.anchorPrice}
              image={product.image}
              description={product.description}
              category={product.category}
              stock={product.stock}
              status={product.status}
              colorHex={product.colorHex}
              variants={product.variants}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Seccion Arma tu Look / Combos Streetwear (Dynamo Brand CRO Booster > $130k) -->
  <section class="py-16 sm:py-24 bg-[#121214] border-t border-[#262626] text-white" id="combos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[#C9A962] text-[10px] font-black uppercase tracking-widest block mb-2">Ofertas Exclusivas</span>
        <h2 class="text-2xl sm:text-4xl font-black font-title uppercase tracking-widest">Arma tu Look & Combos</h2>
        <p class="text-xs sm:text-sm text-[#A3A3A3] mt-2 font-light">
          Combina tus prendas favoritas y ahorra hasta $80.000 COP con entrega express y pago contraentrega en Pasto.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Combo 1: Chaqueta + Camiseta -->
        <div class="bg-[#0B0B0C] border border-[#262626] rounded-md p-6 flex flex-col justify-between hover:border-[#C9A962] transition-colors group">
          <div>
            <span class="bg-[#C9A962]/10 border border-[#C9A962]/30 text-[#C9A962] text-[9px] font-black px-2 py-0.5 rounded-sm uppercase tracking-widest inline-block mb-3">Street Pack</span>
            <h3 class="text-lg font-black uppercase tracking-wider font-title">Chaqueta + Camiseta</h3>
            <p class="text-xs text-[#A3A3A3] mt-1 font-light leading-relaxed">Chaqueta impermeable térmica + Camiseta oversize algodón pesado.</p>
            <div class="my-5 flex items-baseline gap-3">
              <span class="text-2xl font-black text-white font-title">$130.000</span>
              <span class="text-xs text-neutral-500 line-through">$210.000</span>
              <span class="text-xs text-red-500 font-black">-38%</span>
            </div>
          </div>
          <a
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent('*SOLICITUD DE COMBO STREET PACK (PASTO)*\n\n📦 *Combo:* Chaqueta Impermeable + Camiseta Streetwear\n💰 *Precio:* $130.000 COP\n\n📍 _Por favor indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 text-center bg-white hover:bg-[#C9A962] text-black font-black text-xs uppercase tracking-widest rounded-md transition-colors"
          >
            Pedir Combo por WhatsApp →
          </a>
        </div>

        <!-- Combo 2: Chaqueta + Perfume (Destacado) -->
        <div class="bg-[#0B0B0C] border-2 border-[#C9A962] rounded-md p-6 flex flex-col justify-between relative shadow-2xl">
          <span class="absolute -top-3 right-4 bg-[#C9A962] text-black text-[9px] font-black px-2.5 py-0.5 rounded-sm uppercase tracking-widest shadow-md">Más Popular</span>
          <div>
            <span class="text-[#C9A962] text-[9px] font-black uppercase tracking-widest inline-block mb-3">Fragancia & Estilo</span>
            <h3 class="text-lg font-black uppercase tracking-wider font-title">Chaqueta + Perfume</h3>
            <p class="text-xs text-[#A3A3A3] mt-1 font-light leading-relaxed">Chaqueta térmica + Fragancia original Yanbal (Ohm, Solo o Zentro).</p>
            <div class="my-5 flex items-baseline gap-3">
              <span class="text-2xl font-black text-white font-title">$135.000</span>
              <span class="text-xs text-neutral-500 line-through">$260.000</span>
              <span class="text-xs text-red-500 font-black">-48%</span>
            </div>
          </div>
          <a
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent('*SOLICITUD DE COMBO CHAQUETA + PERFUME (PASTO)*\n\n📦 *Combo:* Chaqueta Impermeable + Perfume Yanbal\n💰 *Precio Especial:* $135.000 COP\n\n📍 _Por favor indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 text-center bg-[#C9A962] hover:bg-[#D4B878] text-black font-black text-xs uppercase tracking-widest rounded-md transition-colors shadow-md"
          >
            Pedir Combo por WhatsApp →
          </a>
        </div>

        <!-- Combo 3: Dúo Chaquetas -->
        <div class="bg-[#0B0B0C] border border-[#262626] rounded-md p-6 flex flex-col justify-between hover:border-[#C9A962] transition-colors group">
          <div>
            <span class="bg-neutral-800 text-neutral-300 text-[9px] font-black px-2 py-0.5 rounded-sm uppercase tracking-widest inline-block mb-3">Pack Dúo Pareja / Amigos</span>
            <h3 class="text-lg font-black uppercase tracking-wider font-title">Pack 2 Chaquetas</h3>
            <p class="text-xs text-[#A3A3A3] mt-1 font-light leading-relaxed">2 Chaquetas impermeables térmicas en colores y tallas a tu elección.</p>
            <div class="my-5 flex items-baseline gap-3">
              <span class="text-2xl font-black text-white font-title">$160.000</span>
              <span class="text-xs text-neutral-500 line-through">$240.000</span>
              <span class="text-xs text-emerald-400 font-black">$80k c/u</span>
            </div>
          </div>
          <a
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent('*SOLICITUD DE PACK DÚO 2 CHAQUETAS (PASTO)*\n\n📦 *Combo:* 2 Chaquetas Impermeables Térmicas\n💰 *Precio Dúo:* $160.000 COP\n\n📍 _Por favor indícame las tallas y colores que deseas en Pasto._')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 text-center bg-white hover:bg-[#C9A962] text-black font-black text-xs uppercase tracking-widest rounded-md transition-colors"
          >
            Pedir Pack Dúo por WhatsApp →
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. Landing Informativa (Ubicación, Misión, Propósito - Estilo Minimalista) -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#E5E7EB]" id="landing-info">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        
        <!-- Story / Brand Identity -->
        <div class="space-y-6">
          <span class="inline-block text-text-muted text-[9px] font-black uppercase tracking-widest">Nuestra Filosofía</span>
          <h2 class="text-2xl sm:text-3xl font-title font-black text-text-main uppercase tracking-widest leading-none">Elegancia con Propósito</h2>
          <div class="h-0.5 w-12 bg-neutral-200"></div>
          <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed">
            Estilo Nórdico representa una comunidad joven y emprendedora que busca transformar la manera de vestir en Pasto. Nuestra propuesta impulsa una mentalidad sólida: verse bien, sentirse bien y crecer juntos.
          </p>
          <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed">
            Inspiramos a las personas a vestirse con estilo y actitud, mientras acompañamos su proceso de crecimiento personal y profesional con prendas icónicas y perfumes seleccionados.
          </p>
        </div>

        <!-- Location, Schedule and Contact -->
        <div class="space-y-8 bg-[#F9F9FB] border border-[#E5E7EB] p-8 sm:p-10 rounded-md">
          <div class="space-y-4">
            <span class="text-text-muted text-[9px] font-black uppercase tracking-widest block">Ubicación y Entregas</span>
            <h3 class="text-lg font-title font-black text-text-main uppercase tracking-widest">Showroom / Local</h3>
            <p class="text-xs sm:text-sm text-text-muted font-light leading-relaxed">
              📍 Calle 18, Centro Histórico de Pasto, Colombia.<br />
              Horario de atención: Lunes a Sábado | 9:00 AM a 7:00 PM.
            </p>
          </div>
          
          <div class="space-y-2 border-t border-[#E5E7EB] pt-6">
            <span class="text-text-muted text-[9px] font-black uppercase tracking-widest block mb-2">Canal Directo</span>
            <p class="text-sm text-text-main font-black tracking-widest">📞 WHATSAPP: +57 321 888 8046</p>
            <p class="text-[11px] text-text-muted mt-1 font-light leading-relaxed">Escríbenos para programar envíos inmediatos el mismo día en Pasto.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 6. Final CTA (Monochrome minimalist) -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#E5E7EB]" id="final-cta">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-title font-black text-text-main uppercase tracking-widest mb-4">¿Listo para renovar tu estilo?</h2>
      <p class="text-xs sm:text-sm text-text-muted mb-8 max-w-md mx-auto leading-relaxed">
        Escríbenos por WhatsApp y programamos tu entrega inmediata hoy mismo en Pasto. Paga al recibir en la puerta de tu casa.
      </p>
      <a
        href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        id="final-cta-whatsapp"
        class="inline-flex items-center justify-center gap-3 bg-text-main hover:bg-neutral-800 text-white font-black text-[10px] sm:text-xs uppercase tracking-widest px-8 py-4.5 rounded-md transition-all duration-300 shadow-md cursor-pointer"
      >
        Chatear con un Asesor
      </a>
    </div>
  </section>

</BaseLayout>
