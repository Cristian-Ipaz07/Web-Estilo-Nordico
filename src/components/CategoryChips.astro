---
/**
 * CategoryChips.astro — Barra táctil horizontal deslizable para navegación móvil ágil (Mattelsa / Bershka CRO)
 * Sincronizado en tiempo real con el ERP:
 * Solo muestra chips de categorías activas, publicadas y con stock disponible (>0).
 */
import { fetchNavigationFromERP } from '../lib/erpApi';

interface Props {
  activeCategory?: string;
}

const { activeCategory = 'all' } = Astro.props;

const navData = await fetchNavigationFromERP();
const activeSubs = new Set((navData.active_subcategories || []).map(s => s.toUpperCase().trim()));

// Definición de chips con su correspondiente subcategoría del ERP
const chipDefinitions = [
  { id: 'all', label: '🔥 Todo', href: '/', always: true },
  { id: 'mujer', label: '👗 Mujer', href: '/chaquetas?genero=mujer', always: true },
  { id: 'hombre', label: '👔 Hombre', href: '/chaquetas?genero=hombre', always: true },
  { id: 'chaquetas', code: 'CHAQUETA', label: '🧥 Chaquetas', href: '/chaquetas' },
  { id: 'conjuntos', code: 'CONJUNTO', label: '🏃 Conjuntos', href: '/chaquetas?tipo=conjunto' },
  { id: 'busos', code: 'BUSO', label: '🧥 Busos & Sacos', href: '/chaquetas?tipo=buso' },
  { id: 'billeteras', code: 'BILLETERA', label: '👛 Billeteras', href: '/chaquetas?tipo=billetera' },
  { id: 'camisetas', code: 'CAMISETA', label: '👕 Camisetas', href: '/chaquetas?tipo=camiseta' },
  { id: 'jeans', code: 'JEANS', label: '👖 Jeans & Denim', href: '/chaquetas?tipo=jeans' },
  { id: 'pantalones', code: 'PANTALON', label: '👖 Pantalones', href: '/chaquetas?tipo=pantalon' },
  { id: 'bermudas', code: 'BERMUDA', label: '🩳 Bermudas', href: '/chaquetas?tipo=bermuda' },
  { id: 'blusas', code: 'BLUSAS', label: '👚 Blusas & Tops', href: '/chaquetas?tipo=blusas' },
  { id: 'perfumes', label: '🧴 Perfumes', href: '/perfumes', always: true },
  { id: 'relojes', label: '⌚ Relojes', href: '/relojes', always: true },
  { id: 'combos', label: '💥 Combos Look', href: '/#combos', always: true },
];

// Filtrar únicamente los chips activos
const categories = chipDefinitions.filter(chip => {
  if (chip.always) return true;
  return chip.code && activeSubs.has(chip.code);
});
---

<div class="w-full bg-[#0B0B0C] border-b border-[#262626] py-2 px-3 md:hidden sticky top-16 z-30 shadow-md">
  <div class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap px-1">
    {categories.map((cat) => {
      const isActive = activeCategory === cat.id;
      return (
        <a
          href={cat.href}
          class:list={[
            "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider transition-all duration-200 border",
            isActive
              ? "bg-[#C9A962] text-[#0B0B0C] border-[#C9A962] shadow-sm scale-105"
              : "bg-[#16161A] text-[#D1D5DB] border-[#2E2E33] hover:text-white hover:border-[#C9A962]"
          ]}
        >
          {cat.label}
        </a>
      );
    })}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
