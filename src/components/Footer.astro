---
/**
 * Footer.astro — Footer del sitio (Estilo Dark Mode Streetwear)
 */
import { STORE_CONFIG } from '../config/store';
---

<footer class="bg-[#0B0B0C] border-t border-[#262626] text-white" id="footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Brand & Drakkar Symbol -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 overflow-hidden relative">
            <img 
              src="/assets/logo-nordico.png" 
              alt="Estilo Nórdico" 
              class="absolute top-0 left-0 w-full h-[145%] object-cover object-top" 
            />
          </div>
          <div>
            <h3 class="text-sm font-black uppercase tracking-widest font-title">{STORE_CONFIG.name}</h3>
            <p class="text-[9px] text-[#A3A3A3] font-black uppercase tracking-widest mt-0.5">{STORE_CONFIG.city}</p>
          </div>
        </div>
        <p class="text-xs text-[#A3A3A3] leading-relaxed max-w-xs font-light">
          {STORE_CONFIG.description}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-widest mb-4 text-white">Catálogo</h4>
        <ul class="space-y-2">
          {STORE_CONFIG.navigation.map((item) => (
            <li>
              <a href={item.href} class="text-xs text-[#A3A3A3] hover:text-white transition-colors duration-200">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info (Monochrome, No Emojis) -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-widest mb-4 text-white">Información</h4>
        <ul class="space-y-2 text-xs text-[#A3A3A3] font-light">
          <li>Paga al Recibir en Pasto (Contraentrega)</li>
          <li>Envíos Nacionales Rápidos (3-5 días)</li>
          <li>Calidad Premium Colombiana Reforzada</li>
          <li>Entrega Same-Day en tu domicilio</li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-xs font-black uppercase tracking-widest mb-4 text-white">Contacto</h4>
        <div class="space-y-3">
          <a 
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            id="footer-whatsapp"
            class="flex items-center gap-2 text-xs text-[#A3A3A3] hover:text-white transition-colors duration-200"
          >
            <span class="font-black text-white">WA:</span> {STORE_CONFIG.whatsapp.displayNumber}
          </a>
          <p class="text-xs text-[#A3A3A3] font-light">
            📍 {STORE_CONFIG.city}, {STORE_CONFIG.department}
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-[#262626] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[10px] text-neutral-600 uppercase tracking-wider font-medium">
        © {new Date().getFullYear()} {STORE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <p class="text-[10px] text-neutral-700 uppercase tracking-widest font-black">
        Hecho con actitud en Pasto, Colombia
      </p>
    </div>
  </div>
</footer>
