---
/**
 * ProductPage.astro — Layout de página de producto individual (AliExpress / Page Pilot style)
 * 
 * Secciones:
 * 1. Breadcrumbs
 * 2. Grid principal (Imagen a la izquierda, detalles y compra a la derecha)
 * 3. Urgency Offer Banner (Oferta 1 por $90k, 2 por $160k, 3 por $234k)
 * 4. AliExpress style trust bar
 * 5. AliExpress style reviews (Testimonios)
 * 6. FAQ Accordion (Preguntas Frecuentes)
 */
import { formatPrice, getDiscount } from '../data/products';
import type { Product } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  product: Product;
  categoryLabel: string;
  categoryHref: string;
  allProducts?: Product[];
}

const { product, categoryLabel, categoryHref, allProducts = [] } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
const hasVariants = product.variants && product.variants.length > 0;
const whatsappNumber = STORE_CONFIG.whatsapp.number;

// Find other color variants of this jacket family
const colorVariants = product.category === 'chaquetas'
  ? allProducts.filter(p => p.category === 'chaquetas')
  : [];

// Dynamic reviews based on category
const reviews = product.category === 'perfumes'
  ? [
      {
        name: "María F.",
        rating: 5,
        date: "Hace 2 días",
        text: "Me encantó el perfume. Es 100% original, venía sellado y con su caja intacta de fábrica. La fragancia dura muchísimo. Me lo entregaron el mismo día aquí en Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Andrés G.",
        rating: 5,
        date: "Hace 4 días",
        text: "Excelente servicio. Pedí la loción Bleu Intense y me llegó a Ipiales en 2 días por Servientrega. El pago contra entrega me dio mucha seguridad.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Liliana R.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Súper recomendado. Compré Vibranza de Ésika y el aroma es exquisito, tal cual el catálogo original de Ésika. El precio es el mejor de Nariño.",
        verified: true,
        avatar: "👩"
      }
    ]
  : product.category === 'relojes'
  ? [
      {
        name: "Roberto T.",
        rating: 5,
        date: "Hace 3 días",
        text: "El reloj es precioso, el diseño minimalista combina con todo. La correa de cuero es suave y de buena calidad. Me lo entregaron gratis en Pasto.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Claudia V.",
        rating: 5,
        date: "Hace 6 días",
        text: "Pedí el modelo Elegance en acero y tiene unos acabados muy finos. Se ve muy costoso. Llegó rápido y bien empacado.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Fernando S.",
        rating: 5,
        date: "Hace 2 semanas",
        text: "Soporta salpicaduras de agua y el cristal es resistente. Por este precio es un regalo. Excelente producto.",
        verified: true,
        avatar: "👨"
      }
    ]
  : [
      {
        name: "Cristian I.",
        rating: 5,
        date: "Hace 1 día",
        text: "Excelente calidad, la tela es impermeable y es forrada por dentro súper calientica. El gorro se puede quitar y poner fácil. Talla L me quedó excelente. Me la entregaron a domicilio hoy mismo en Pasto y pagué al recibir.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Marta P.",
        rating: 5,
        date: "Hace 3 días",
        text: "Pedí el Pack 2 (Duo Estilo) para mi esposo y para mí. Nos ahorramos 20 mil pesos y el material es excelente. Súper abrigadas para el frío de Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Carlos E.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Tenía dudas de comprar porque soy de Ipiales, pero me hicieron el envío nacional por Servientrega y pagué en efectivo al recibir a los 3 días. La chaqueta es de horma un poco reducida pero pedí una talla más como recomiendan y quedó perfecta.",
        verified: true,
        avatar: "👨"
      }
    ];

// Dynamic FAQs based on category
const faqs = product.category === 'perfumes'
  ? [
      {
        question: "¿En cuánto tiempo llega mi pedido de loción?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles a cualquier municipio de Colombia."
      },
      {
        question: "¿Puedo pagar al recibir?",
        answer: "Sí. Ofrecemos pago contra entrega tanto para Pasto como para envíos nacionales en todo Colombia. Pagas en efectivo, Nequi o Daviplata al recibir tu paquete."
      },
      {
        question: "¿Las fragancias son 100% originales de catálogo?",
        answer: "Sí. Todos nuestros perfumes son 100% originales, adquiridos directamente en los canales de venta oficial de Yanbal, Ésika, Cyzone, Avon y L'Bel. Vienen en sus empaques originales sellados de fábrica con celofán y códigos de lote verificables."
      },
      {
        question: "¿Cómo funciona la garantía de perfumes?",
        answer: "Garantizamos el perfecto estado del producto. Si tu perfume presenta fallas en la válvula, atomizador o filtración durante los primeros 5 días hábiles, te realizamos el cambio inmediato sin costo en nuestro punto físico en Pasto."
      }
    ]
  : product.category === 'relojes'
  ? [
      {
        question: "¿En cuánto tiempo llega mi reloj?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles."
      },
      {
        question: "¿Puedo pagar contra entrega?",
        answer: "Sí. Ofrecemos pago contra entrega tanto para Pasto como para envíos nacionales en todo Colombia. Pagas únicamente al recibir tu reloj."
      },
      {
        question: "¿Tienen garantía los relojes?",
        answer: "Sí, todos nuestros relojes cuentan con 30 días de garantía por maquinaria o defectos de fabricación. Los cambios de modelo o devoluciones se pueden realizar en nuestro punto físico en Pasto durante los primeros 5 días."
      },
      {
        question: "¿Los relojes son resistentes al agua?",
        answer: "Nuestros relojes soportan salpicaduras de agua leves por lavado de manos o lluvia. No son aptos para sumergir, bañarse o nadar."
      }
    ]
  : [
      {
        question: "¿En cuánto tiempo llega mi pedido?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles a cualquier ciudad de Colombia."
      },
      {
        question: "¿Puedo pagar cuando reciba el producto?",
        answer: "Sí. Ofrecemos pago contra entrega en efectivo, Nequi o Daviplata tanto para entrega a domicilio en Pasto como para envíos nacionales en todo Colombia. Pagas únicamente al recibir tu paquete."
      },
      {
        question: "¿Qué talla debo elegir y cuáles son las medidas?",
        answer: "Ten en cuenta que nuestras chaquetas son de horma un poco reducida. 😉 Te aconsejamos pedir una talla más de la habitual si te gusta usarla holgada.\n\nMedidas disponibles:\n• Talla M: Largo 63.5 cm, Ancho 53.5 cm\n• Talla L: Largo 67 cm, Ancho 57 cm\n• Talla XL: Largo 70 cm, Ancho 60 cm\n• Talla XXL: Largo 74 cm, Ancho 64 cm"
      },
      {
        question: "¿Cómo funciona la garantía y cambios?",
        answer: "Ofrecemos cambio de talla durante los primeros 5 días. En Pasto puedes realizar el cambio directamente en nuestro punto físico o coordinarlo a domicilio. Cuentas también con 30 días de garantía por cualquier defecto de fábrica."
      }
    ];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  <Breadcrumbs items={[
    { label: categoryLabel, href: categoryHref },
    { label: product.name }
  ]} />

  <!-- 1. Main Grid -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 bg-white rounded-3xl border border-border-light shadow-sm p-4 sm:p-8 mb-12">
    <!-- Left Column: Media -->
    <div class="lg:col-span-7 space-y-4">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-gray-50 to-gray-100 aspect-square border border-border-light">
        <img 
          src={product.image} 
          alt={product.name}
          class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
          id="main-product-image"
          loading="eager"
        />
        {discount > 0 && (
          <div class="absolute top-4 left-4 bg-red-500 text-white text-xs font-black px-3.5 py-1.5 rounded-full badge-discount shadow-lg uppercase tracking-wider">
            Oferta -{discount}%
          </div>
        )}
        {product.status === 'agotado' && (
          <div class="absolute top-4 right-4 bg-gray-800 text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase">
            Agotado
          </div>
        )}
      </div>
      
      {/* Visual thumbnails */}
      {product.images && product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-2">
          {product.images.map((img, i) => (
            <button class="rounded-lg overflow-hidden border-2 border-transparent hover:border-primary transition-all aspect-square thumbnail-btn" data-img={img}>
              <img src={img} alt={`${product.name} vista ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Buying controls & Conversion details -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <!-- Brand & Rating header -->
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-bold text-accent bg-accent/10 px-2.5 py-1 rounded-md uppercase tracking-wider">Calidad Premium Colombiana</span>
          <div class="flex items-center text-gold text-sm font-semibold gap-1">
            <span>★★★★★</span>
            <span class="text-text-muted text-xs font-medium">4.7 (48 valoraciones)</span>
          </div>
        </div>
        
        <!-- Title -->
        <h1 class="text-2xl sm:text-3xl font-black text-text-main leading-tight mb-2" id="product-title">
          {product.name}
        </h1>

        <!-- Price AliExpress style -->
        <div class="p-4 bg-bg rounded-2xl mb-6 border border-border-light">
          <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">Precio Especial Contraentrega</span>
          <div class="flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-black text-primary" id="display-price">${formatPrice(product.price)}</span>
            <span class="text-base text-text-light line-through font-medium" id="display-anchor-price">${formatPrice(product.anchorPrice)}</span>
            <span class="bg-red-500 text-white text-[10px] font-black px-2 py-0.5 rounded-md uppercase tracking-wide" id="display-saving-badge">AHORRAS {getDiscount(product.price, product.anchorPrice)}%</span>
          </div>
        </div>

        <!-- Color selector (swatches) -->
        {colorVariants.length > 0 && (
          <div class="mb-6">
            <label class="block text-sm font-bold text-text-main mb-2">Color:</label>
            <div class="flex flex-wrap gap-2.5">
              {colorVariants.map((cv) => {
                const isActive = cv.slug === product.slug;
                const colorName = cv.name.replace('Chaqueta Impermeable ', '');
                return (
                  <a
                    href={`/chaquetas/${cv.slug}`}
                    class:list={[
                      'w-9 h-9 rounded-full border-2 transition-all duration-200 flex items-center justify-center relative hover:scale-110 shadow-sm',
                      isActive
                        ? 'border-primary ring-2 ring-primary/20 scale-105'
                        : 'border-border hover:border-text-muted'
                    ]}
                    style={`background-color: ${cv.colorHex || '#ccc'}`}
                    title={colorName}
                  >
                    {isActive && (
                      <span class="absolute w-2 h-2 rounded-full bg-white shadow-sm"></span>
                    )}
                  </a>
                );
              })}
            </div>
            <p class="mt-2 text-xs text-text-muted">Color seleccionado: <span class="font-bold text-text-main">{product.name.replace('Chaqueta Impermeable ', '')}</span></p>
          </div>
        )}

        <!-- Variant selector (sizes) -->
        {hasVariants && (
          <div class="mb-6" id="variant-selector">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-sm font-bold text-text-main">Talla:</label>
              <span class="text-xs text-primary font-bold bg-primary/5 px-2 py-0.5 rounded-md border border-primary/10">Horma reducida 😉</span>
            </div>
            <div class="flex flex-wrap gap-2" id="size-options">
              {product.variants!.map((v) => (
                <button
                  class:list={[
                    'size-btn px-4 py-2.5 rounded-xl text-sm font-bold border-2 transition-all duration-200 shadow-sm flex items-center gap-1.5',
                    v.status === 'disponible'
                      ? 'border-border hover:border-primary hover:bg-primary/5 cursor-pointer bg-white text-text-main'
                      : 'border-border-light text-text-light line-through cursor-not-allowed opacity-50 bg-bg'
                  ]}
                  data-talla={v.talla}
                  data-stock={v.stock}
                  data-ref={v.referencia}
                  data-available={v.status === 'disponible' ? 'true' : 'false'}
                  disabled={v.status !== 'disponible'}
                >
                  {v.talla}
                  {v.status === 'disponible' && (
                    <span class="text-[10px] text-text-muted font-normal bg-bg border border-border px-1.5 py-0.5 rounded-md">({v.stock})</span>
                  )}
                </button>
              ))}
            </div>
            <p class="mt-2 text-xs text-text-muted" id="selected-size-info">Selecciona una talla para pedir</p>

            <!-- Mini visual measurements table -->
            <div class="mt-4 p-3 bg-bg rounded-xl border border-border-light">
              <span class="text-[10px] font-bold text-text-muted uppercase block mb-2">Guía de medidas de costura:</span>
              <div class="grid grid-cols-4 gap-2 text-center text-[10px] font-bold text-text-main">
                <div class="p-1.5 bg-white rounded-lg border border-border-light">M: 63x53 cm</div>
                <div class="p-1.5 bg-white rounded-lg border border-border-light">L: 67x57 cm</div>
                <div class="p-1.5 bg-white rounded-lg border border-border-light">XL: 70x60 cm</div>
                <div class="p-1.5 bg-white rounded-lg border border-border-light">XXL: 74x64 cm</div>
              </div>
            </div>
          </div>
        )}

        <!-- 3. AliExpress Package Selector Widget -->
        {product.category === 'chaquetas' && (
          <div class="mb-6">
            <label class="block text-sm font-bold text-text-main mb-3">Elige tu mejor oferta hoy:</label>
            <div class="grid grid-cols-1 gap-3">
              <!-- Pack 1 -->
              <button 
                class="pack-option border-2 border-primary bg-primary/5 rounded-2xl p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="1"
                data-pack-name="Pack 1 Individual"
                data-pack-price="90000"
                data-pack-anchor="120000"
                data-pack-desc="1 Chaqueta (Ideal para probar)"
              >
                <div>
                  <span class="inline-block bg-primary/10 text-primary text-[9px] font-bold px-2 py-0.5 rounded-md uppercase mb-1">Individual</span>
                  <p class="text-sm font-black text-text-main">1 Chaqueta</p>
                  <p class="text-xs text-text-muted">Largo y ancho exacto</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-black text-primary">$90.000</p>
                  <p class="text-xs text-text-light line-through">$120.000</p>
                </div>
                <div class="absolute -top-2 -right-2 bg-primary text-white w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold" id="pack-check-1">✓</div>
              </button>

              <!-- Pack 2 -->
              <button 
                class="pack-option border-2 border-border hover:border-primary/50 bg-white rounded-2xl p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="2"
                data-pack-name="Pack 2 Duo Estilo"
                data-pack-price="160000"
                data-pack-anchor="240000"
                data-pack-desc="2 Chaquetas (Ahorras $20.000)"
              >
                <div>
                  <span class="inline-block bg-gold text-primary text-[9px] font-black px-2 py-0.5 rounded-md uppercase mb-1">Más vendido</span>
                  <p class="text-sm font-black text-text-main">2 Chaquetas</p>
                  <p class="text-xs text-text-muted">Ahorras $20.000 en combo</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-black text-text-main">$160.000</p>
                  <p class="text-xs text-text-light line-through">$240.000</p>
                </div>
                <div class="absolute -top-2 -right-2 bg-primary text-white w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold hidden" id="pack-check-2">✓</div>
              </button>

              <!-- Pack 3 -->
              <button 
                class="pack-option border-2 border-border hover:border-primary/50 bg-white rounded-2xl p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="3"
                data-pack-name="Pack 3 Combo Familiar"
                data-pack-price="234000"
                data-pack-anchor="360000"
                data-pack-desc="3 Chaquetas ($78.000 c/u)"
              >
                <div>
                  <span class="inline-block bg-green-100 text-green-800 text-[9px] font-bold px-2 py-0.5 rounded-md uppercase mb-1">Ahorro Máximo</span>
                  <p class="text-sm font-black text-text-main">3 Chaquetas</p>
                  <p class="text-xs text-text-muted">Mejor precio por unidad</p>
                </div>
                <div class="text-right">
                  <p class="text-lg font-black text-text-main">$234.000</p>
                  <p class="text-xs text-text-light line-through">$360.000</p>
                </div>
                <div class="absolute -top-2 -right-2 bg-primary text-white w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold hidden" id="pack-check-3">✓</div>
              </button>
            </div>
          </div>
        )}

        <!-- Stock state -->
        {product.stock !== undefined && (
          <div class="mb-6 flex items-center gap-2">
            <span class="flex h-2.5 w-2.5 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
            </span>
            <span class="text-xs font-semibold text-green-700">Stock real en local Pasto disponible para entrega hoy</span>
          </div>
        )}
      </div>

      <!-- Actions -->
      <div class="space-y-4">
        <!-- WhatsApp CTA -->
        <button
          id="product-buy-btn"
          class="w-full btn-whatsapp py-4 px-6 rounded-2xl text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg font-black tracking-wide cursor-pointer"
          data-product-name={product.name}
          data-product-brand={product.brand}
          data-product-id={product.id}
          data-product-price={product.price}
          data-phone={whatsappNumber}
          data-has-variants={hasVariants ? 'true' : 'false'}
        >
          <svg class="w-6 h-6 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span id="buy-btn-text">Pedir por WhatsApp (Pago Contraentrega)</span>
        </button>

        <!-- Social Proof Widget -->
        <div class="p-3 bg-green-50 border border-green-200 rounded-2xl flex items-center justify-center gap-2 text-center shadow-sm">
          <span class="text-lg">📦</span>
          <span class="text-xs font-black text-green-800">
            {product.category === 'chaquetas' && 'Más de 500 chaquetas entregadas en Nariño'}
            {product.category === 'perfumes' && 'Más de 800 lociones entregadas en Nariño'}
            {product.category === 'relojes' && 'Más de 300 relojes entregados en Nariño'}
          </span>
        </div>

        <!-- Trust seals AliExpress style -->
        <div class="grid grid-cols-3 gap-3 text-center border-t border-border-light pt-4">
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">🏠</span>
            <span class="text-[10px] font-black text-text-main uppercase">Pago en Casa</span>
            <span class="text-[9px] text-text-muted">Domicilio en Pasto</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">🇨🇴</span>
            <span class="text-[10px] font-black text-text-main uppercase">Envíos del país</span>
            <span class="text-[9px] text-text-muted">Llega de 3 a 5 días</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">
              {product.category === 'chaquetas' && '🧥'}
              {product.category === 'perfumes' && '🧴'}
              {product.category === 'relojes' && '⌚'}
            </span>
            <span class="text-[10px] font-black text-text-main uppercase">
              {product.category === 'chaquetas' && 'Premium'}
              {product.category === 'perfumes' && 'Original'}
              {product.category === 'relojes' && 'Nórdico'}
            </span>
            <span class="text-[9px] text-text-muted">
              {product.category === 'chaquetas' && 'Confección nacional'}
              {product.category === 'perfumes' && 'Distribuidor oficial'}
              {product.category === 'relojes' && 'Garantía de máquina'}
            </span>
          </div>
        </div>

        <!-- Callout Banner for Direct Distributor request (for Perfumes/Watches only) -->
        {product.category !== 'chaquetas' && (
          <div class="p-3.5 bg-purple-50 border border-purple-200 rounded-2xl text-center shadow-sm mt-4">
            <p class="text-[11px] font-black text-purple-900 uppercase">✨ ¿No encuentras tu loción favorita?</p>
            <p class="text-[10px] text-purple-700 mt-0.5 leading-tight">Trabajamos directo con distribuidor de fábrica. Te conseguimos cualquier loción de catálogo.</p>
            <a 
              href={`https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(`Hola, estoy buscando un perfume de catálogo que no veo en la web. ¿Me ayudan a conseguirlo?`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-2 text-[10px] font-black text-white bg-purple-600 px-4 py-2 rounded-xl hover:bg-purple-700 transition-all cursor-pointer"
            >
              Preguntar por WhatsApp
            </a>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- 2. AliExpress Description & Marketing Sections -->
  <div class="grid lg:grid-cols-3 gap-8 mb-12">
    <!-- Description & Features (Left/Middle 2 Columns) -->
    <div class="lg:col-span-2 space-y-8">
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Detalles del Producto</h2>
        
        <p class="text-sm sm:text-base text-text-muted mb-6 leading-relaxed">
          {product.description}
        </p>

        <!-- High conversion features grid with icons -->
        {product.features && product.features.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4">
            {product.features.map((feature) => (
              <div class="flex items-center gap-3 p-3 bg-bg rounded-xl border border-border-light">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/10 text-primary text-xs font-bold">✓</span>
                <span class="text-xs sm:text-sm font-semibold text-text-main">{feature}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Guarantee Section (AliExpress style) -->
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Nuestra Garantía de Satisfacción</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">{product.category === 'chaquetas' ? '🏠' : '✨'}</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">
              {product.category === 'chaquetas' ? 'Pruébalo en Casa' : '100% Original'}
            </h3>
            <p class="text-[10px] text-text-muted">
              {product.category === 'chaquetas' 
                ? 'Te lo llevamos a domicilio en Pasto. Te lo mides y si te queda bien, lo pagas.' 
                : 'Fragancias oficiales selladas de fábrica y directas del catálogo oficial.'}
            </p>
          </div>
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">📍</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">Punto Físico</h3>
            <p class="text-[10px] text-text-muted">
              {product.category === 'chaquetas'
                ? 'Si necesitas un cambio de talla, puedes acercarte a nuestro local físico en Pasto.'
                : 'Para cualquier reclamo o cambio, puedes visitarnos en nuestro punto físico en Pasto.'}
            </p>
          </div>
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">🔒</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">Garantía Segura</h3>
            <p class="text-[10px] text-text-muted">
              {product.category === 'chaquetas'
                ? 'Garantizamos cambio de talla sin complicaciones dentro de los primeros 5 días.'
                : 'Garantizamos cambio inmediato por fallas en válvula o defectos en los primeros 5 días.'}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Sidebar FAQ (1 Column) -->
    <div class="space-y-8">
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Preguntas Frecuentes</h2>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group bg-bg border border-border-light rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
              <summary class="flex justify-between items-center p-4 cursor-pointer select-none">
                <span class="text-xs font-extrabold text-text-main tracking-tight pr-4">{faq.question}</span>
                <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">▼</span>
              </summary>
              <div class="p-4 pt-0 border-t border-border-light/50">
                <p class="text-xs text-text-muted leading-relaxed whitespace-pre-line">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 3. AliExpress Customer Reviews Section -->
  <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm mb-12" id="reviews-section">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-border-light pb-4 mb-6 gap-4">
      <div>
        <h2 class="text-lg sm:text-xl font-black text-text-main uppercase tracking-wide">Valoraciones de Clientes</h2>
        <p class="text-xs text-text-muted mt-1">Opiniones verificadas de compradores de San Juan de Pasto y Nariño</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-black text-text-main">4.7</span>
        <div class="flex flex-col">
          <span class="text-gold text-sm font-semibold">★★★★★</span>
          <span class="text-[10px] text-text-muted font-medium">Basado en valoraciones reales del local</span>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="p-5 bg-bg rounded-2xl border border-border-light flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xl">{rev.avatar}</span>
                <div>
                  <h3 class="text-xs font-black text-text-main">{rev.name}</h3>
                  <span class="text-[9px] text-green-600 font-bold flex items-center gap-1">
                    <span class="text-xs">✓</span> Comprador verificado
                  </span>
                </div>
              </div>
              <span class="text-[10px] text-text-light">{rev.date}</span>
            </div>
            <div class="text-gold text-xs font-semibold mb-2">★★★★★</div>
            <p class="text-xs text-text-muted leading-relaxed">{rev.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  // Size selector and WhatsApp button logic
  const sizeButtons = document.querySelectorAll('.size-btn');
  const buyBtn = document.getElementById('product-buy-btn') as HTMLButtonElement;
  const buyBtnText = document.getElementById('buy-btn-text');
  const sizeInfo = document.getElementById('selected-size-info');
  const packOptions = document.querySelectorAll('.pack-option');
  
  let selectedSize = '';
  let selectedRef = '';
  let selectedPack = '1';
  let selectedPackName = 'Pack 1 Individual';
  let selectedPackPrice = buyBtn ? parseFloat(buyBtn.getAttribute('data-product-price') || '90000') : 90000;
  let selectedPackDesc = '1 Chaqueta (Ideal para probar)';

  // Handle pack selections
  packOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      // Remove selection classes
      packOptions.forEach(o => {
        o.classList.remove('border-primary', 'bg-primary/5');
        o.classList.add('border-border', 'bg-white');
        const check = document.getElementById(`pack-check-${o.getAttribute('data-pack-id')}`);
        if (check) check.classList.add('hidden');
      });

      // Add selection classes
      opt.classList.remove('border-border', 'bg-white');
      opt.classList.add('border-primary', 'bg-primary/5');
      const packId = opt.getAttribute('data-pack-id') || '1';
      const check = document.getElementById(`pack-check-${packId}`);
      if (check) check.classList.remove('hidden');

      selectedPack = packId;
      selectedPackName = opt.getAttribute('data-pack-name') || '';
      selectedPackPrice = parseFloat(opt.getAttribute('data-pack-price') || '90000');
      selectedPackDesc = opt.getAttribute('data-pack-desc') || '';

      // Update display prices
      const displayPrice = document.getElementById('display-price');
      const displayAnchorPrice = document.getElementById('display-anchor-price');
      const displaySavingBadge = document.getElementById('display-saving-badge');
      
      const formattedPrice = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(selectedPackPrice);
      const anchorVal = parseFloat(opt.getAttribute('data-pack-anchor') || '120000');
      const formattedAnchor = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(anchorVal);
      const discountPct = Math.round(((anchorVal - selectedPackPrice) / anchorVal) * 100);

      if (displayPrice) displayPrice.textContent = `$${formattedPrice}`;
      if (displayAnchorPrice) displayAnchorPrice.textContent = `$${formattedAnchor}`;
      if (displaySavingBadge) displaySavingBadge.textContent = `AHORRAS ${discountPct}%`;

      // Update WhatsApp checkout button text
      updateCheckoutButton();
    });
  });

  // Handle size selections
  sizeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.getAttribute('data-available') !== 'true') return;
      
      // Deselect all
      sizeButtons.forEach(b => {
        b.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
        b.classList.add('border-border');
      });
      
      // Select this one
      btn.classList.remove('border-border');
      btn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
      
      selectedSize = btn.getAttribute('data-talla') || '';
      selectedRef = btn.getAttribute('data-ref') || '';
      const stock = btn.getAttribute('data-stock') || '0';
      
      if (sizeInfo) {
        sizeInfo.textContent = `Talla ${selectedSize} seleccionada — ${stock} unidades disponibles`;
        sizeInfo.classList.add('text-primary', 'font-bold');
        sizeInfo.classList.remove('text-red-500');
      }

      // Clear any validation highlight
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.remove('ring-4', 'ring-red-500/50');
      }
      
      updateCheckoutButton();
    });
  });

  function updateCheckoutButton() {
    if (!buyBtnText) return;
    
    let text = 'Pedir por WhatsApp (Pago Contraentrega)';
    
    if (selectedPack === '1') {
      text = selectedSize ? `Pedir Talla ${selectedSize} por WhatsApp` : 'Selecciona una talla para pedir';
    } else if (selectedPack === '2') {
      text = 'Pedir Duo Estilo (2 Chaquetas) por WhatsApp';
    } else if (selectedPack === '3') {
      text = 'Pedir Combo Familiar (3 Chaquetas) por WhatsApp';
    }

    buyBtnText.textContent = text;
  }

  buyBtn?.addEventListener('click', () => {
    const hasVariants = buyBtn.getAttribute('data-has-variants') === 'true';
    
    if (hasVariants && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = '⚠️ Por favor selecciona una talla antes de pedir';
        sizeInfo.classList.add('text-red-500', 'font-bold');
      }
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.add('ring-4', 'ring-red-500/50', 'animate-shake');
        sizeOptions.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          sizeOptions.classList.remove('animate-shake');
        }, 500);
      }
      return;
    }

    const name = buyBtn.getAttribute('data-product-name') || '';
    const brand = buyBtn.getAttribute('data-product-brand') || '';
    const id = buyBtn.getAttribute('data-product-id') || '';
    const phone = buyBtn.getAttribute('data-phone') || '';

    const formattedPrice = new Intl.NumberFormat('es-CO', {
      style: 'decimal',
      minimumFractionDigits: 0,
    }).format(selectedPackPrice);

    let orderDetailText = `📦 *Pedido:* ${selectedPackName} (${selectedPackDesc})`;
    let sizeText = '';

    if (selectedPack === '1') {
      sizeText = `\n👕 *Talla:* ${selectedSize}`;
      if (selectedRef) sizeText += ` (Ref: ${selectedRef})`;
    } else {
      sizeText = `\n👕 *Talla Solicitada de Referencia:* ${selectedSize}\n📝 _(Coordinaré las tallas de las otras chaquetas del combo contigo en este chat)_`;
    }

    const message = 
      `*SOLICITUD DE PEDIDO CONTRAENTREGA*\n\n` +
      `🧥 *Producto:* ${name} (${brand})` +
      `\n${orderDetailText}` +
      sizeText +
      `\n🆔 *Código Base:* ${id}\n` +
      `💰 *Valor Total:* $${formattedPrice} COP\n\n` +
      `📍 _Por favor, indícame tu nombre, ciudad (Pasto o envío nacional) y dirección para coordinar el envío hoy mismo._`;

    const encodedMessage = encodeURIComponent(message);
    const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;

    // Meta Pixel event
    if (typeof window !== 'undefined' && (window as any).fbq) {
      (window as any).fbq('track', 'InitiateCheckout', {
        content_ids: [id],
        content_type: 'product',
        content_name: name,
        value: selectedPackPrice,
        currency: 'COP'
      }, { eventID: `evt-${id}-${Date.now()}` });
    }

    setTimeout(() => {
      window.open(whatsAppUrl, '_blank');
    }, 300);
  });
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }
  .animate-shake {
    animation: shake 0.4s ease-in-out;
  }
</style>
