---
/**
 * ProductPage.astro — Layout de página de producto individual (Omnicanal E-Commerce CRO)
 * 
 * Secciones:
 * 1. Breadcrumbs
 * 2. Grid principal (Galería interactiva a la izquierda, detalles, packs y compra a la derecha)
 * 3. Selector de Oferta / Packs por volumen (1, 2 o 3 unidades con promo de Domicilio Gratis)
 * 4. Selector dinámico de modelo/diseño y tallas según categoría
 * 5. Barra de confianza y garantías locales Estilo Nórdico (Pasto y Nacional)
 * 6. Testimonios y Preguntas Frecuentes dinámicas
 */
import { formatPrice, getDiscount } from '../data/products';
import type { Product, ProductVariant } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  product: Product;
  categoryLabel: string;
  categoryHref: string;
  allProducts?: Product[];
}

const { product, categoryLabel, categoryHref, allProducts = [] } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
const whatsappNumber = STORE_CONFIG.whatsapp.number;

// Clasificación dinámica de la prenda / producto
const subcatUpper = (product.subcategory || '').toUpperCase();
const nameUpper = (product.name || '').toUpperCase();

const isJacket = subcatUpper.includes('CHAQUETA') || product.id.includes('5080');
const isWallet = subcatUpper.includes('BILLETERA');
const isCap = subcatUpper.includes('GORRA');
const isBelt = subcatUpper.includes('CORREA');
const isHoodie = subcatUpper.includes('BUSO') || nameUpper.includes('BUSO') || nameUpper.includes('CAPUCHA');
const isShirt = subcatUpper.includes('CAMISETA');
const isPants = subcatUpper.includes('PANTALON') || subcatUpper.includes('JEAN');
const isPerfume = product.category === 'perfumes';
const isWatch = product.category === 'relojes';

const unitName = isJacket ? 'Chaqueta'
  : isWallet ? 'Billetera'
  : isCap ? 'Gorra'
  : isBelt ? 'Correa'
  : isHoodie ? 'Buso'
  : isShirt ? 'Camiseta'
  : isPants ? 'Pantalón'
  : isPerfume ? 'Loción'
  : isWatch ? 'Reloj'
  : (product.subcategory || 'Prenda');

const unitNamePlural = isJacket ? 'Chaquetas'
  : isWallet ? 'Billeteras'
  : isCap ? 'Gorras'
  : isBelt ? 'Correas'
  : isHoodie ? 'Busos'
  : isShirt ? 'Camisetas'
  : isPants ? 'Pantalones'
  : isPerfume ? 'Lociones'
  : isWatch ? 'Relojes'
  : `${unitName}s`;

// Solo las chaquetas tienen variantes de color que navegan a otras páginas estáticas de chaqueta
const colorVariants = isJacket
  ? allProducts.filter(p => 
      p.category === 'chaquetas' && 
      (p.subcategory || '').toUpperCase().includes('CHAQUETA') &&
      p.slug.startsWith('chaqueta-impermeable-') &&
      p.slug !== 'chaqueta-impermeable-'
    )
  : [];

// Variantes internas del producto (diseños/modelos o colores de esta referencia)
const rawVariants = product.variants || [];
const hasModelVariants = !isJacket && rawVariants.length > 1;

// Detectar si el producto requiere selección de talla textil (S, M, L, XL, XXL)
const hasSizes = rawVariants.some(v => 
  v.talla && !['ÚNICA', 'UNICA', 'NONE', 'NULL', ''].includes(v.talla.toUpperCase().trim())
);
const hasVariants = hasSizes || hasModelVariants;

// Cálculo de Precios para Ofertas por Paquete (Packs 1, 2 y 3)
const price1 = product.price;
const anchor1 = product.anchorPrice || Math.round(product.price * 1.4);

// Pack 2 (2 unidades)
const price2 = isJacket
  ? Math.round(product.price * 2 - 20000)
  : Math.round(product.price * 2 * 0.95);
const anchor2 = anchor1 * 2;

// Pack 3 (3 unidades)
const price3 = isJacket
  ? Math.round(product.price * 3 * 0.87)
  : Math.round(product.price * 3 * 0.90);
const anchor3 = anchor1 * 3;

// Reseñas dinámicas según categoría
const reviews = isPerfume
  ? [
      {
        name: "María F.",
        rating: 5,
        date: "Hace 2 días",
        text: "Me encantó el perfume. Es 100% original, venía sellado y con su caja intacta de fábrica. La fragancia dura muchísimo. Me lo entregaron el mismo día aquí en Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Andrés G.",
        rating: 5,
        date: "Hace 4 días",
        text: "Excelente servicio. Pedí la loción Bleu Intense y me llegó a Ipiales en 2 días por Servientrega. El pago contra entrega me dio mucha seguridad.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Liliana R.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Súper recomendado. Compré Vibranza de Ésika y el aroma es exquisito, tal cual el catálogo original de Ésika. El precio es el mejor de Nariño.",
        verified: true,
        avatar: "👩"
      }
    ]
  : isWatch
  ? [
      {
        name: "Roberto T.",
        rating: 5,
        date: "Hace 3 días",
        text: "El reloj es precioso, el diseño minimalista combina con todo. La correa es suave y de buena calidad. Me lo entregaron gratis en Pasto.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Claudia V.",
        rating: 5,
        date: "Hace 6 días",
        text: "Pedí el modelo en acero y tiene acabados muy finos. Se ve muy elegante. Llegó rápido y bien empacado.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Fernando S.",
        rating: 5,
        date: "Hace 2 semanas",
        text: "Soporta salpicaduras de agua y el cristal es resistente. Por este precio es una excelente compra. Muy cumplidos.",
        verified: true,
        avatar: "👨"
      }
    ]
  : isJacket
  ? [
      {
        name: "Cristian I.",
        rating: 5,
        date: "Hace 1 día",
        text: "Excelente calidad, la tela es impermeable y es forrada por dentro súper calientica. El gorro se puede quitar y poner fácil. Talla L me quedó excelente. Me la entregaron a domicilio hoy mismo en Pasto y pagué al recibir.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Marta P.",
        rating: 5,
        date: "Hace 3 días",
        text: "Pedí el Pack 2 (Dúo Estilo) para mi esposo y para mí. Nos ahorramos 20 mil pesos y el material es excelente. Súper abrigadas para el frío de Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Carlos E.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Tenía dudas de comprar porque soy de Ipiales, pero me hicieron el envío nacional por Servientrega y pagué en efectivo al recibir a los 3 días. Excelente prenda.",
        verified: true,
        avatar: "👨"
      }
    ]
  : [
      {
        name: "David M.",
        rating: 5,
        date: "Hace 2 días",
        text: `Excelente producto. Compré la ${unitName.toLowerCase()} y los acabados son impecables, tal cual como se ve en las fotos. Me la trajeron a domicilio aquí en Pasto y pagué al recibir en efectivo.`,
        verified: true,
        avatar: "👨"
      },
      {
        name: "Camila S.",
        rating: 5,
        date: "Hace 4 días",
        text: `Aproveché la promo llevando 2 ${unitNamePlural.toLowerCase()} y me dieron el domicilio gratis en Pasto. Muy buena atención por WhatsApp y entrega súper rápida.`,
        verified: true,
        avatar: "👩"
      },
      {
        name: "Julián P.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Pedí para envío a Ipiales y llegó por Servientrega en 2 días. Pago contraentrega muy confiable y la calidad de Estilo Nórdico 10/10.",
        verified: true,
        avatar: "👨"
      }
    ];

// FAQs dinámicas según producto
const faqs = [
  {
    question: "¿En cuánto tiempo llega mi pedido?",
    answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles a cualquier municipio de Colombia."
  },
  {
    question: "¿Puedo pagar cuando reciba el producto?",
    answer: "Sí. Ofrecemos pago contra entrega en efectivo, Nequi o Daviplata tanto para entrega a domicilio en Pasto como para envíos nacionales en todo Colombia. Pagas únicamente al recibir tu paquete."
  },
  ...(hasSizes ? [{
    question: "¿Qué talla debo elegir y cómo es la horma?",
    answer: isJacket
      ? "Nuestras chaquetas son de horma ajustada/reducida. Te aconsejamos pedir una talla más si te gusta usarla holgada.\n\nMedidas de costura:\n• Talla M: Largo 63.5 cm, Ancho 53.5 cm\n• Talla L: Largo 67 cm, Ancho 57 cm\n• Talla XL: Largo 70 cm, Ancho 60 cm\n• Talla XXL: Largo 74 cm, Ancho 64 cm"
      : "Prendas confeccionadas en corte estándar moderno. Si tienes dudas entre dos tallas, te sugerimos la superior para mayor confort."
  }] : [{
    question: "¿Cómo son los materiales y acabados?",
    answer: "Todos los artículos de Estilo Nórdico pasan por control de calidad de confección y materiales de alta durabilidad. Cuentas con respaldo directo y atención en nuestro punto físico en Pasto (Manzana G3 Casa 14, Nueva Aranda)."
  }]),
  {
    question: "¿Cómo funciona la garantía y cambios?",
    answer: "Ofrecemos garantía de satisfacción y cambio directo durante los primeros 5 días. En Pasto puedes realizar el cambio directamente en nuestro showroom físico o coordinarlo a domicilio."
  }
];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 md:pb-10">
  <Breadcrumbs items={[
    { label: categoryLabel, href: categoryHref },
    { label: product.name }
  ]} />

  <!-- 1. Main Grid -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 bg-white rounded-md border border-[#E5E7EB] p-4 sm:p-8 mb-12">
    <!-- Left Column: Media Gallery -->
    <div class="lg:col-span-7 space-y-4">
      <div class="relative overflow-hidden rounded-md bg-[#F3F4F6] aspect-square border border-[#E5E7EB]">
        <img 
          src={product.image} 
          alt={product.name}
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          id="main-product-image"
          loading="eager"
        />
        {discount > 0 && (
          <div class="absolute top-4 left-4 bg-red-600 text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-wider shadow-lg">
            Oferta -{discount}%
          </div>
        )}
        {product.status === 'agotado' && (
          <div class="absolute top-4 right-4 bg-neutral-850 text-neutral-400 text-[9px] font-black px-3 py-1.5 rounded-md uppercase tracking-wider">
            Agotado
          </div>
        )}
      </div>
      
      {/* Visual thumbnails sincronizados con el selector de modelos */}
      {product.images && product.images.length > 1 && (
        <div class="grid grid-cols-5 gap-2" id="thumbnail-gallery">
          {product.images.map((img, i) => (
            <button 
              type="button"
              class:list={[
                "rounded-md overflow-hidden border transition-all aspect-square thumbnail-btn cursor-pointer bg-[#F9F9FB] relative group",
                i === 0 ? "border-[#0B0B0C] ring-2 ring-[#0B0B0C] shadow-sm is-active" : "border-[#E5E7EB] hover:border-black"
              ]}
              data-img={img}
              data-index={i}
              title={`Vista / Modelo ${i + 1}`}
            >
              <img src={img} alt={`${product.name} vista ${i + 1}`} class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105" loading="lazy" />
              <span class:list={[
                "thumb-active-indicator absolute bottom-0 inset-x-0 h-1 bg-[#C9A962] transition-opacity duration-200",
                i === 0 ? "opacity-100" : "opacity-0"
              ]}></span>
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Buying controls & Conversion details -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <!-- Brand & Rating header -->
        <div class="flex items-center gap-2 mb-2">
          <span class="text-[9px] font-black text-text-main bg-[#F9F9FB] border border-[#E5E7EB] px-2.5 py-1 rounded-md uppercase tracking-widest">
            {product.brand && product.brand !== 'Estilo Nórdico' ? product.brand : 'Estilo Nórdico'}
          </span>
          <div class="flex items-center text-gold text-xs font-semibold gap-1">
            <span>★★★★★</span>
            <span class="text-text-muted text-[10px] font-medium ml-1">4.8 (36)</span>
          </div>
        </div>
        
        <!-- Title -->
        <h1 class="text-xl sm:text-2xl font-black text-text-main uppercase tracking-wider leading-tight mb-2 font-title" id="product-title">
          {product.name}
        </h1>

        <!-- Urgencia y Beneficio de Entrega Pasto -->
        <div class="mb-4 space-y-2">
          <!-- Barra de Urgencia / Últimas Unidades -->
          <div class="flex items-center justify-between p-2.5 bg-red-50 border border-red-200 rounded-md shadow-xs">
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600"></span>
              </span>
              <span class="text-[10px] font-black text-red-700 uppercase tracking-wider">
                🔥 ¡ÚLTIMAS UNIDADES EN BODEGA! ALTA DEMANDA
              </span>
            </div>
            <span class="text-[9px] font-bold text-red-600 bg-white px-2 py-0.5 rounded border border-red-200 uppercase tracking-widest">
              Pasto y Nacional
            </span>
          </div>

          <!-- Banner de Entrega / Domicilio Gratis -->
          {isJacket ? (
            <div class="flex items-center gap-2.5 p-2.5 bg-emerald-50 border border-emerald-200 rounded-md shadow-xs">
              <span class="text-base leading-none">🚚</span>
              <div class="leading-tight">
                <span class="text-[10px] font-black text-emerald-800 uppercase tracking-wider block">
                  ¡DOMICILIO GRATIS EN PASTO! (Pagas al recibir en casa)
                </span>
                <span class="text-[9px] text-emerald-700 font-medium">
                  Beneficio exclusivo Chaquetas Ref 5080 hoy
                </span>
              </div>
            </div>
          ) : (
            <div class="flex items-center gap-2.5 p-2.5 bg-amber-50 border border-amber-200 rounded-md shadow-xs">
              <span class="text-base leading-none">🎁</span>
              <div class="leading-tight">
                <span class="text-[10px] font-black text-amber-900 uppercase tracking-wider block">
                  ¡LLEVA 2 O MÁS PRODUCTOS Y TU DOMICILIO ES GRATIS EN PASTO!
                </span>
                <span class="text-[9px] text-amber-800 font-medium">
                  Pagas contra entrega al recibir en la puerta de tu casa
                </span>
              </div>
            </div>
          )}
        </div>

        <!-- Price Anchoring Comparison Block -->
        <div class="p-4 bg-[#F9F9FB] rounded-md mb-6 border border-[#E5E7EB] shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] text-text-muted uppercase font-black tracking-widest">Oferta Local Contraentrega</span>
            <span class="bg-red-600 text-white text-[10px] font-black px-2.5 py-0.5 rounded-md uppercase tracking-widest shadow-sm" id="display-saving-badge">
              AHORRAS {getDiscount(product.price, product.anchorPrice)}%
            </span>
          </div>
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs text-text-muted">
              <span>Precio Comercial:</span>
              <span class="line-through font-semibold text-text-light" id="display-anchor-price">${formatPrice(product.anchorPrice)} COP</span>
            </div>
            <div class="flex items-center justify-between text-base sm:text-lg font-black text-text-main font-title pt-1 border-t border-[#E5E7EB]">
              <span>Precio Estilo Nórdico:</span>
              <span class="text-2xl sm:text-3xl text-emerald-600 font-black font-title" id="display-price">${formatPrice(product.price)} COP</span>
            </div>
          </div>
        </div>

        <!-- Color selector para Chaquetas 5080 con Mini-Preview Real de cada prenda -->
        {colorVariants.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-black text-text-main uppercase tracking-widest">Color disponible:</label>
              <span class="text-xs font-black text-[#C9A962] uppercase tracking-wider">{product.name.replace('Chaqueta Impermeable ', '')}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {colorVariants.map((cv) => {
                const isActive = cv.slug === product.slug;
                const colorName = cv.name.replace('Chaqueta Impermeable ', '');
                return (
                  <a
                    href={`/chaquetas/${cv.slug}`}
                    class:list={[
                      'w-12 h-12 rounded-md border-2 transition-all duration-200 flex items-center justify-center relative hover:scale-105 shadow-xs overflow-hidden group bg-[#F9F9FB]',
                      isActive
                        ? 'border-[#0B0B0C] ring-2 ring-[#C9A962] scale-105 shadow-md'
                        : 'border-[#E5E7EB] hover:border-black'
                    ]}
                    title={`Color: ${colorName}`}
                  >
                    <img 
                      src={cv.image} 
                      alt={colorName} 
                      class="w-full h-full object-cover" 
                      loading="lazy" 
                    />
                    <div 
                      class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-tl border-t border-l border-white/60 shadow-xs" 
                      style={`background-color: ${cv.colorHex || '#333'}`}
                      title={colorName}
                    ></div>
                    {isActive && (
                      <div class="absolute inset-0 bg-black/25 flex items-center justify-center">
                        <span class="w-2.5 h-2.5 rounded-full bg-white shadow-md ring-2 ring-[#C9A962]"></span>
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
            <p class="mt-2 text-[11px] text-text-muted">Color seleccionado: <span class="font-bold text-text-main">{product.name.replace('Chaqueta Impermeable ', '')}</span></p>
          </div>
        )}

        <!-- Selector de Diseños / Modelos para Productos con Variantes (ej. Billeteras, Accesorios) -->
        {hasModelVariants && (
          <div class="mb-6">
            <label class="block text-xs font-black text-text-main uppercase tracking-widest mb-2">Diseño / Modelo Disponible:</label>
            <div class="flex flex-wrap gap-2" id="model-variants">
              {rawVariants.map((v, i) => (
                <button
                  type="button"
                  class:list={[
                    "model-btn px-3 py-2 rounded-md text-xs font-black uppercase tracking-wider border transition-all duration-200 flex items-center gap-2 cursor-pointer shadow-xs",
                    i === 0 
                      ? "border-[#C9A962] bg-[#0B0B0C] text-white is-active ring-2 ring-[#C9A962]/40" 
                      : "border-[#E5E7EB] bg-white text-text-main hover:border-black"
                  ]}
                  data-variant-id={v.id}
                  data-image={v.image || ''}
                  data-color={v.color}
                  data-brand={v.brand || ''}
                  data-ref={v.referencia}
                  data-stock={v.stock}
                  data-index={i}
                >
                  {v.image && (
                    <img src={v.image} alt={v.color} class="w-5 h-5 rounded object-cover border border-white/20 shrink-0" />
                  )}
                  <span>{v.brand && v.brand !== 'Estilo Nórdico' ? `${v.brand} · ${v.color}` : v.color}</span>
                  <span class="text-[9px] opacity-75 font-normal">({v.stock} disp.)</span>
                </button>
              ))}
            </div>
            <p class="mt-2 text-xs text-text-muted" id="selected-model-text">
              Modelo seleccionado: <span class="font-bold text-text-main">{rawVariants[0]?.brand && rawVariants[0].brand !== 'Estilo Nórdico' ? `${rawVariants[0].brand} - ` : ''}{rawVariants[0]?.color}</span>
            </p>
          </div>
        )}

        <!-- Variant selector (sizes) — Solo para prendas con tallas reales -->
        {hasSizes && (
          <div class="mb-6" id="variant-selector">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-black text-text-main uppercase tracking-widest">{rawVariants.length === 1 ? 'Talla de esta pieza única:' : 'Talla:'}</label>
              {isJacket && (
                <span class="text-[9px] text-text-main font-black bg-[#F9F9FB] border border-[#E5E7EB] px-2.5 py-1 rounded-md uppercase tracking-wider">Horma reducida 😉</span>
              )}
            </div>
            <div class="flex flex-wrap gap-2" id="size-options">
              {rawVariants.map((v) => {
                const isDisponible = v.status === 'disponible' && v.stock > 0;
                return (
                  <button
                    type="button"
                    class:list={[
                      'size-btn px-4 py-2.5 rounded-md text-xs font-black uppercase tracking-widest border transition-all duration-200 shadow-sm flex items-center justify-center gap-1.5 cursor-pointer relative',
                      isDisponible
                        ? 'border-[#E5E7EB] bg-white text-[#0B0B0C] hover:border-[#0B0B0C]'
                        : 'border-dashed border-amber-300 bg-amber-50/60 text-[#0B0B0C] hover:border-amber-500'
                    ]}
                    data-talla={v.talla}
                    data-stock={v.stock}
                    data-ref={v.referencia}
                    data-variant-id={v.id}
                    data-available={isDisponible ? 'true' : 'false'}
                    data-status={isDisponible ? 'disponible' : 'agotado'}
                  >
                    <span class="size-letter font-black">{v.talla}</span>
                    <span class:list={[
                      "size-badge font-black px-1.5 py-0.5 rounded-sm border",
                      isDisponible
                        ? "text-[9px] bg-[#F3F4F6] text-[#6B7280] border-[#E5E7EB]"
                        : "text-[8px] bg-amber-100 text-amber-800 border-amber-200"
                    ]}>
                      {isDisponible ? `${v.stock} un.` : 'PEDIR'}
                    </span>
                  </button>
                );
              })}
            </div>
            <p id="size-selection-info" class="mt-2 text-[10px] text-text-muted uppercase tracking-wider font-semibold"></p>

            {/* Medidas de costura exclusivas para chaquetas */}
            {isJacket && (
              <div class="mt-4 p-3.5 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
                <span class="text-[9px] font-black text-text-muted uppercase tracking-widest block mb-2.5">Medidas de costura:</span>
                <div class="grid grid-cols-4 gap-2 text-center text-[10px] font-black text-text-main uppercase">
                  <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">M: 63x53 cm</div>
                  <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">L: 67x57 cm</div>
                  <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">XL: 70x60 cm</div>
                  <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">XXL: 74x64 cm</div>
