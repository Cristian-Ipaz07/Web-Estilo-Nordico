---
/**
 * ProductPage.astro — Layout de página de producto individual (AliExpress / Page Pilot style)
 * 
 * Secciones:
 * 1. Breadcrumbs
 * 2. Grid principal (Imagen a la izquierda, detalles y compra a la derecha)
 * 3. Urgency Offer Banner (Oferta 2 por $160.000)
 * 4. AliExpress style trust bar
 * 5. AliExpress style reviews (Testimonios)
 * 6. FAQ Accordion (Preguntas Frecuentes)
 */
import { formatPrice, getDiscount } from '../data/products';
import type { Product } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  product: Product;
  categoryLabel: string;
  categoryHref: string;
  allProducts?: Product[];
}

const { product, categoryLabel, categoryHref, allProducts = [] } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
const hasVariants = product.variants && product.variants.length > 0;
const availableVariants = product.variants?.filter(v => v.status === 'disponible') || [];
const whatsappNumber = STORE_CONFIG.whatsapp.number;

// Find other color variants of this jacket family
const colorVariants = product.category === 'chaquetas'
  ? allProducts.filter(p => p.category === 'chaquetas')
  : [];

// Standard testimonials customized for Pasto
const reviews = [
  {
    name: "Cristian I.",
    rating: 5,
    date: "Hace 1 día",
    text: "Excelente calidad, la tela es 100% impermeable, ideal para el frío y lluvia de Pasto. La talla L me quedó perfecta, y el envío fue súper rápido en el mismo día. La pagué al recibir.",
    verified: true,
    avatar: "👨"
  },
  {
    name: "Marta P.",
    rating: 5,
    date: "Hace 3 días",
    text: "Compré el combo de la chaqueta beige con el perfume de Yanbal por $130mil y me pareció un regalo completo. Súper originales los productos y muy amables en WhatsApp.",
    verified: true,
    avatar: "👩"
  },
  {
    name: "Carlos E.",
    rating: 5,
    date: "Hace 1 semana",
    text: "Muy recomendados, vivo por el sector de Unicentro y me llegó la chaqueta en menos de 3 horas. Buena atención y producto tal cual como en la foto.",
    verified: true,
    avatar: "👨"
  }
];

// FAQs native accordion data
const faqs = [
  {
    question: "¿Cómo funciona el envío gratis en Pasto?",
    answer: "El envío es 100% gratuito en todo el casco urbano de Pasto. Entregamos el mismo día (same-day) para compras confirmadas antes de las 4:00 PM."
  },
  {
    question: "¿Qué métodos de pago aceptan?",
    answer: "Manejamos Pago Contraentrega en Pasto, es decir, pagas en efectivo o transferencia (Nequi/Daviplata) al momento de recibir el producto en tu puerta. ¡Cero riesgos!"
  },
  {
    question: "¿Qué pasa si la talla no me queda?",
    answer: "No te preocupes. Hacemos cambios de talla sin costo adicional en Pasto durante los primeros 5 días tras recibir el pedido, siempre que la prenda esté limpia y con sus etiquetas."
  },
  {
    question: "¿Los perfumes y relojes son originales?",
    answer: "Sí, garantizamos al 100% que todos nuestros perfumes son de catálogo directo (Yanbal, Ésika, Avon) originales. Todos los relojes cuentan con garantía de funcionamiento."
  }
];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  <Breadcrumbs items={[
    { label: categoryLabel, href: categoryHref },
    { label: product.name }
  ]} />

  <!-- 1. Main Grid -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 bg-white rounded-3xl border border-border-light shadow-sm p-4 sm:p-8 mb-12">
    <!-- Left Column: Media (AliExpress style slider feel) -->
    <div class="lg:col-span-7 space-y-4">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-gray-50 to-gray-100 aspect-square border border-border-light">
        <img 
          src={product.image} 
          alt={product.name}
          class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
          id="main-product-image"
          loading="eager"
        />
        {discount > 0 && (
          <div class="absolute top-4 left-4 bg-red-500 text-white text-xs font-black px-3.5 py-1.5 rounded-full badge-discount shadow-lg uppercase tracking-wider">
            Oferta -{discount}%
          </div>
        )}
        {product.status === 'agotado' && (
          <div class="absolute top-4 right-4 bg-gray-800 text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase">
            Agotado
          </div>
        )}
      </div>
      
      {/* Visual thumbnails */}
      {product.images && product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-2">
          {product.images.map((img, i) => (
            <button class="rounded-lg overflow-hidden border-2 border-transparent hover:border-primary transition-all aspect-square thumbnail-btn" data-img={img}>
              <img src={img} alt={`${product.name} vista ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Buying controls & Conversion details -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <!-- AliExpress Brand & Rating header -->
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-bold text-accent bg-accent/10 px-2.5 py-1 rounded-md uppercase tracking-wider">{product.brand}</span>
          <div class="flex items-center text-gold text-sm font-semibold gap-1">
            <span>★★★★★</span>
            <span class="text-text-muted text-xs font-medium">5.0 (48 valoraciones)</span>
          </div>
        </div>
        
        <!-- Title -->
        <h1 class="text-2xl sm:text-3xl font-black text-text-main leading-tight mb-2" id="product-title">
          {product.name}
        </h1>

        <!-- Price AliExpress style -->
        <div class="p-4 bg-bg rounded-2xl mb-6 border border-border-light">
          <span class="text-[10px] text-text-muted uppercase font-bold tracking-wider block mb-1">Precio Especial Contraentrega</span>
          <div class="flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-black text-primary">${formatPrice(product.price)}</span>
            <span class="text-base text-text-light line-through font-medium">${formatPrice(product.anchorPrice)}</span>
            <span class="bg-red-500 text-white text-[10px] font-black px-2 py-0.5 rounded-md uppercase tracking-wide">AHORRAS ${getDiscount(product.price, product.anchorPrice)}%</span>
          </div>
        </div>

        <!-- Color selector (swatches) -->
        {colorVariants.length > 0 && (
          <div class="mb-6">
            <label class="block text-sm font-bold text-text-main mb-2">Color:</label>
            <div class="flex flex-wrap gap-2.5">
              {colorVariants.map((cv) => {
                const isActive = cv.slug === product.slug;
                const colorName = cv.name.replace('Chaqueta Impermeable ', '');
                return (
                  <a
                    href={`/chaquetas/${cv.slug}`}
                    class:list={[
                      'w-9 h-9 rounded-full border-2 transition-all duration-200 flex items-center justify-center relative hover:scale-110 shadow-sm',
                      isActive
                        ? 'border-primary ring-2 ring-primary/20 scale-105'
                        : 'border-border hover:border-text-muted'
                    ]}
                    style={`background-color: ${cv.colorHex || '#ccc'}`}
                    title={colorName}
                  >
                    {isActive && (
                      <span class="absolute w-2 h-2 rounded-full bg-white shadow-sm"></span>
                    )}
                  </a>
                );
              })}
            </div>
            <p class="mt-2 text-xs text-text-muted">Color seleccionado: <span class="font-bold text-text-main">{product.name.replace('Chaqueta Impermeable ', '')}</span></p>
          </div>
        )}

        <!-- Variant selector (sizes) -->
        {hasVariants && (
          <div class="mb-6" id="variant-selector">
            <label class="block text-sm font-bold text-text-main mb-2">Talla:</label>
            <div class="flex flex-wrap gap-2" id="size-options">
              {product.variants!.map((v) => (
                <button
                  class:list={[
                    'size-btn px-4 py-2.5 rounded-xl text-sm font-bold border-2 transition-all duration-200 shadow-sm flex items-center gap-1.5',
                    v.status === 'disponible'
                      ? 'border-border hover:border-primary hover:bg-primary/5 cursor-pointer bg-white text-text-main'
                      : 'border-border-light text-text-light line-through cursor-not-allowed opacity-50 bg-bg'
                  ]}
                  data-talla={v.talla}
                  data-stock={v.stock}
                  data-ref={v.referencia}
                  data-available={v.status === 'disponible' ? 'true' : 'false'}
                  disabled={v.status !== 'disponible'}
                >
                  {v.talla}
                  {v.status === 'disponible' && (
                    <span class="text-[10px] text-text-muted font-normal bg-bg border border-border px-1.5 py-0.5 rounded-md">({v.stock})</span>
                  )}
                </button>
              ))}
            </div>
            <p class="mt-2.5 text-xs text-text-muted" id="selected-size-info">Selecciona una talla para pedir</p>
          </div>
        )}

        <!-- Promotion Urgency Banner -->
        {product.category === 'chaquetas' && (
          <div class="p-3 bg-red-50 border border-red-100 rounded-xl mb-6 flex items-start gap-3">
            <span class="text-xl">🔥</span>
            <div>
              <p class="text-xs font-extrabold text-red-800 uppercase tracking-wide">¡PROMO DE HOY EN PASTO!</p>
              <p class="text-xs text-red-700 font-medium">Lleva 1 chaqueta por $90.000 COP o <strong class="text-red-900 font-black underline">2 por $160.000 COP</strong> (Ahorras $20.000). Envío gratis.</p>
            </div>
          </div>
        )}

        <!-- Stock state -->
        {product.stock !== undefined && (
          <div class="mb-6 flex items-center gap-2">
            <span class="flex h-2.5 w-2.5 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
            </span>
            <span class="text-xs font-semibold text-green-700">Stock real en local Pasto disponible para entrega hoy</span>
          </div>
        )}
      </div>

      <!-- Actions -->
      <div class="space-y-4">
        <!-- WhatsApp CTA -->
        <button
          id="product-buy-btn"
          class="w-full btn-whatsapp py-4 px-6 rounded-2xl text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg font-black tracking-wide"
          data-product-name={product.name}
          data-product-brand={product.brand}
          data-product-id={product.id}
          data-product-price={product.price}
          data-phone={whatsappNumber}
          data-has-variants={hasVariants ? 'true' : 'false'}
        >
          <svg class="w-6 h-6 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span id="buy-btn-text">Pedir por WhatsApp (Pago Contraentrega)</span>
        </button>

        <!-- Trust seals AliExpress style -->
        <div class="grid grid-cols-3 gap-3 text-center border-t border-border-light pt-4">
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">🚚</span>
            <span class="text-[10px] font-black text-text-main uppercase">Envío Gratis</span>
            <span class="text-[9px] text-text-muted">En Pasto mismo día</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">💰</span>
            <span class="text-[10px] font-black text-text-main uppercase">Contraentrega</span>
            <span class="text-[9px] text-text-muted">Pagas al recibir</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-xl mb-1">✅</span>
            <span class="text-[10px] font-black text-text-main uppercase">Original</span>
            <span class="text-[9px] text-text-muted">Garantía total</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. AliExpress Description & Marketing Sections -->
  <div class="grid lg:grid-cols-3 gap-8 mb-12">
    <!-- Description & Features (Left/Middle 2 Columns) -->
    <div class="lg:col-span-2 space-y-8">
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Detalles del Producto</h2>
        
        <p class="text-sm sm:text-base text-text-muted mb-6 leading-relaxed">
          {product.description}
        </p>

        <!-- High conversion features grid with icons -->
        {product.features && product.features.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4">
            {product.features.map((feature) => (
              <div class="flex items-center gap-3 p-3 bg-bg rounded-xl border border-border-light">
                <span class="flex items-center justify-center w-6 h-6 rounded-full bg-primary/10 text-primary text-xs font-bold">✓</span>
                <span class="text-xs sm:text-sm font-semibold text-text-main">{feature}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Guarantee Section (AliExpress style) -->
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Nuestra Garantía de Satisfacción</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">🤝</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">Pruébalo Primero</h3>
            <p class="text-[10px] text-text-muted">Te lo llevamos a casa, te lo mides, y si te gusta lo compras. ¡Cero riesgos!</p>
          </div>
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">🔄</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">Cambio de Talla</h3>
            <p class="text-[10px] text-text-muted">¿No te quedó? Te cambiamos la talla sin costo adicional de mensajería en Pasto.</p>
          </div>
          <div class="text-center p-4 bg-bg rounded-2xl border border-border-light">
            <span class="text-3xl mb-2 block">🔒</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">100% Seguro</h3>
            <p class="text-[10px] text-text-muted">Sin tarjetas de crédito. Pagas directamente al mensajero de confianza.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Sidebar FAQ (1 Column) -->
    <div class="space-y-8">
      <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg sm:text-xl font-black text-text-main border-b border-border-light pb-4 mb-6 uppercase tracking-wide">Preguntas Frecuentes</h2>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group bg-bg border border-border-light rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
              <summary class="flex justify-between items-center p-4 cursor-pointer select-none">
                <span class="text-xs font-extrabold text-text-main tracking-tight pr-4">{faq.question}</span>
                <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">▼</span>
              </summary>
              <div class="p-4 pt-0 border-t border-border-light/50">
                <p class="text-xs text-text-muted leading-relaxed">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 3. AliExpress Customer Reviews Section -->
  <div class="bg-white rounded-3xl border border-border-light p-6 sm:p-8 shadow-sm mb-12" id="reviews-section">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-border-light pb-4 mb-6 gap-4">
      <div>
        <h2 class="text-lg sm:text-xl font-black text-text-main uppercase tracking-wide">Valoraciones de Clientes</h2>
        <p class="text-xs text-text-muted mt-1">Opiniones verificadas de compradores de San Juan de Pasto</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-black text-text-main">5.0</span>
        <div class="flex flex-col">
          <span class="text-gold text-sm font-semibold">★★★★★</span>
          <span class="text-[10px] text-text-muted font-medium">Basado en 48 ventas recientes</span>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="p-5 bg-bg rounded-2xl border border-border-light flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xl">{rev.avatar}</span>
                <div>
                  <h3 class="text-xs font-black text-text-main">{rev.name}</h3>
                  <span class="text-[9px] text-green-600 font-bold flex items-center gap-1">
                    <span class="text-xs">✓</span> Comprador verificado en Pasto
                  </span>
                </div>
              </div>
              <span class="text-[10px] text-text-light">{rev.date}</span>
            </div>
            <div class="text-gold text-xs font-semibold mb-2">★★★★★</div>
            <p class="text-xs text-text-muted leading-relaxed">{rev.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  // Size selector and WhatsApp button logic
  const sizeButtons = document.querySelectorAll('.size-btn');
  const buyBtn = document.getElementById('product-buy-btn') as HTMLButtonElement;
  const buyBtnText = document.getElementById('buy-btn-text');
  const sizeInfo = document.getElementById('selected-size-info');
  let selectedSize = '';
  let selectedRef = '';

  sizeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.getAttribute('data-available') !== 'true') return;
      
      // Deselect all
      sizeButtons.forEach(b => {
        b.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
        b.classList.add('border-border');
      });
      
      // Select this one
      btn.classList.remove('border-border');
      btn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
      
      selectedSize = btn.getAttribute('data-talla') || '';
      selectedRef = btn.getAttribute('data-ref') || '';
      const stock = btn.getAttribute('data-stock') || '0';
      
      if (sizeInfo) {
        sizeInfo.textContent = `Talla ${selectedSize} seleccionada — ${stock} unidades disponibles`;
        sizeInfo.classList.add('text-primary', 'font-bold');
      }
      if (buyBtnText) {
        buyBtnText.textContent = `Pedir Talla ${selectedSize} por WhatsApp`;
      }
    });
  });

  buyBtn?.addEventListener('click', () => {
    const hasVariants = buyBtn.getAttribute('data-has-variants') === 'true';
    
    if (hasVariants && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = '⚠️ Por favor selecciona una talla antes de pedir';
        sizeInfo.classList.add('text-red-500', 'font-bold');
      }
      return;
    }

    const name = buyBtn.getAttribute('data-product-name') || '';
    const brand = buyBtn.getAttribute('data-product-brand') || '';
    const id = buyBtn.getAttribute('data-product-id') || '';
    const price = parseFloat(buyBtn.getAttribute('data-product-price') || '0');
    const phone = buyBtn.getAttribute('data-phone') || '';

    const formattedPrice = new Intl.NumberFormat('es-CO', {
      style: 'decimal',
      minimumFractionDigits: 0,
    }).format(price);

    let sizeText = '';
    if (selectedSize) {
      sizeText = `\n👕 *Talla:* ${selectedSize}`;
      if (selectedRef) sizeText += ` (Ref: ${selectedRef})`;
    }

    const message = 
      `*SOLICITUD DE PEDIDO CONTRAENTREGA (PASTO)*\n\n` +
      `📦 *Producto:* ${name} (${brand})` +
      sizeText +
      `\n🆔 *Código:* ${id}\n` +
      `💰 *Precio Especial:* $${formattedPrice} COP\n\n` +
      `📍 _Por favor, indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._`;

    const encodedMessage = encodeURIComponent(message);
    const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;

    // Meta Pixel event
    if (typeof window !== 'undefined' && (window as any).fbq) {
      (window as any).fbq('track', 'InitiateCheckout', {
        content_ids: [id],
        content_type: 'product',
        content_name: name,
        value: price,
        currency: 'COP'
      }, { eventID: `evt-${id}-${Date.now()}` });
    }

    setTimeout(() => {
      window.open(whatsAppUrl, '_blank');
    }, 300);
  });
</script>
