---
/**
 * ProductPage.astro — Layout de página de producto individual (tipo Shopify)
 * 
 * Two-column layout: imagen a la izquierda, info a la derecha.
 * Incluye selector de tallas (si aplica), características y CTA WhatsApp.
 */
import { formatPrice, getDiscount } from '../data/products';
import type { Product } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  product: Product;
  categoryLabel: string;
  categoryHref: string;
}

const { product, categoryLabel, categoryHref } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
const hasVariants = product.variants && product.variants.length > 0;
const availableVariants = product.variants?.filter(v => v.status === 'disponible') || [];
const whatsappNumber = STORE_CONFIG.whatsapp.number;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
  <Breadcrumbs items={[
    { label: categoryLabel, href: categoryHref },
    { label: product.name }
  ]} />

  <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
    <!-- Image Column -->
    <div class="space-y-4">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-gray-50 to-gray-100 aspect-square">
        <img 
          src={product.image} 
          alt={product.name}
          class="w-full h-full object-cover"
          loading="eager"
        />
        {discount > 0 && (
          <div class="absolute top-4 left-4 bg-red-500 text-white text-sm font-bold px-3 py-1.5 rounded-full badge-discount shadow-lg">
            -{discount}% OFF
          </div>
        )}
        {product.status === 'agotado' && (
          <div class="absolute top-4 right-4 bg-gray-800 text-white text-sm font-bold px-3 py-1.5 rounded-full">
            Agotado
          </div>
        )}
      </div>
      
      {/* Gallery thumbnails if multiple images */}
      {product.images && product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-2">
          {product.images.map((img, i) => (
            <div class="rounded-lg overflow-hidden border-2 border-transparent hover:border-primary transition-colors cursor-pointer aspect-square">
              <img src={img} alt={`${product.name} vista ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Info Column -->
    <div class="flex flex-col">
      <!-- Brand -->
      <span class="text-xs text-accent font-bold tracking-wider uppercase mb-1">{product.brand}</span>
      
      <!-- Name -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-text-main leading-tight mb-3" id="product-title">
        {product.name}
      </h1>

      <!-- Description -->
      <p class="text-sm sm:text-base text-text-muted mb-4 leading-relaxed">
        {product.description}
      </p>

      <!-- Price -->
      <div class="flex items-baseline gap-3 mb-6">
        <span class="text-3xl sm:text-4xl font-black text-text-main">${formatPrice(product.price)}</span>
        <span class="text-lg text-text-light line-through">${formatPrice(product.anchorPrice)}</span>
        <span class="text-sm text-text-muted">COP</span>
      </div>

      <!-- Stock info -->
      {product.stock !== undefined && (
        <div class="mb-4">
          {product.status === 'disponible' ? (
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-green-600">
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              {product.stock} unidades disponibles
            </span>
          ) : (
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-500">
              <span class="w-2 h-2 bg-red-500 rounded-full"></span>
              Temporalmente agotado
            </span>
          )}
        </div>
      )}

      <!-- Variant selector (sizes) -->
      {hasVariants && (
        <div class="mb-6" id="variant-selector">
          <label class="block text-sm font-bold text-text-main mb-2">Talla:</label>
          <div class="flex flex-wrap gap-2" id="size-options">
            {product.variants!.map((v) => (
              <button
                class:list={[
                  'size-btn px-4 py-2.5 rounded-xl text-sm font-semibold border-2 transition-all duration-200',
                  v.status === 'disponible'
                    ? 'border-border hover:border-primary hover:bg-primary/5 cursor-pointer'
                    : 'border-border-light text-text-light line-through cursor-not-allowed opacity-50'
                ]}
                data-talla={v.talla}
                data-stock={v.stock}
                data-ref={v.referencia}
                data-available={v.status === 'disponible' ? 'true' : 'false'}
                disabled={v.status !== 'disponible'}
              >
                {v.talla}
                {v.status === 'disponible' && (
                  <span class="ml-1 text-xs text-text-muted">({v.stock})</span>
                )}
              </button>
            ))}
          </div>
          <p class="mt-2 text-xs text-text-muted" id="selected-size-info">Selecciona una talla para pedir</p>
        </div>
      )}

      <!-- Badges -->
      <div class="flex flex-wrap gap-2 mb-6">
        <span class="inline-flex items-center gap-1.5 bg-bg rounded-full px-3 py-1.5 text-xs font-semibold text-text-main">
          🚚 Envío gratis en Pasto
        </span>
        <span class="inline-flex items-center gap-1.5 bg-bg rounded-full px-3 py-1.5 text-xs font-semibold text-text-main">
          💰 Pago contraentrega
        </span>
        <span class="inline-flex items-center gap-1.5 bg-bg rounded-full px-3 py-1.5 text-xs font-semibold text-text-main">
          ⚡ Entrega hoy mismo
        </span>
      </div>

      <!-- WhatsApp CTA -->
      <button
        id="product-buy-btn"
        class="w-full btn-whatsapp py-4 px-6 rounded-2xl text-base sm:text-lg flex items-center justify-center gap-3 shadow-lg mb-4"
        data-product-name={product.name}
        data-product-brand={product.brand}
        data-product-id={product.id}
        data-product-price={product.price}
        data-phone={whatsappNumber}
        data-has-variants={hasVariants ? 'true' : 'false'}
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span id="buy-btn-text">Pedir por WhatsApp</span>
      </button>

      <!-- Features -->
      {product.features && product.features.length > 0 && (
        <div class="mt-6 pt-6 border-t border-border-light">
          <h3 class="text-sm font-bold text-text-main mb-3 uppercase tracking-wider">Características</h3>
          <ul class="space-y-2">
            {product.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <span class="text-accent mt-0.5">✓</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Tags -->
      {product.tags.length > 0 && (
        <div class="mt-6 pt-4 border-t border-border-light">
          <div class="flex flex-wrap gap-1.5">
            {product.tags.map((tag) => (
              <span class="text-[10px] bg-bg text-text-muted rounded-full px-2.5 py-1 font-medium">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  // Size selector and WhatsApp button logic
  const sizeButtons = document.querySelectorAll('.size-btn');
  const buyBtn = document.getElementById('product-buy-btn') as HTMLButtonElement;
  const buyBtnText = document.getElementById('buy-btn-text');
  const sizeInfo = document.getElementById('selected-size-info');
  let selectedSize = '';
  let selectedRef = '';

  sizeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.getAttribute('data-available') !== 'true') return;
      
      // Deselect all
      sizeButtons.forEach(b => {
        b.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
        b.classList.add('border-border');
      });
      
      // Select this one
      btn.classList.remove('border-border');
      btn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
      
      selectedSize = btn.getAttribute('data-talla') || '';
      selectedRef = btn.getAttribute('data-ref') || '';
      const stock = btn.getAttribute('data-stock') || '0';
      
      if (sizeInfo) {
        sizeInfo.textContent = `Talla ${selectedSize} seleccionada — ${stock} disponibles`;
        sizeInfo.classList.add('text-primary', 'font-semibold');
      }
      if (buyBtnText) {
        buyBtnText.textContent = `Pedir talla ${selectedSize} por WhatsApp`;
      }
    });
  });

  buyBtn?.addEventListener('click', () => {
    const hasVariants = buyBtn.getAttribute('data-has-variants') === 'true';
    
    if (hasVariants && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = '⚠️ Por favor selecciona una talla';
        sizeInfo.classList.add('text-red-500', 'font-semibold');
      }
      return;
    }

    const name = buyBtn.getAttribute('data-product-name') || '';
    const brand = buyBtn.getAttribute('data-product-brand') || '';
    const id = buyBtn.getAttribute('data-product-id') || '';
    const price = parseFloat(buyBtn.getAttribute('data-product-price') || '0');
    const phone = buyBtn.getAttribute('data-phone') || '';

    const formattedPrice = new Intl.NumberFormat('es-CO', {
      style: 'decimal',
      minimumFractionDigits: 0,
    }).format(price);

    let sizeText = '';
    if (selectedSize) {
      sizeText = `\n👕 *Talla:* ${selectedSize}`;
      if (selectedRef) sizeText += ` (Ref: ${selectedRef})`;
    }

    const message = 
      `*SOLICITUD DE PEDIDO CONTRAENTREGA (PASTO)*\n\n` +
      `📦 *Producto:* ${name} (${brand})` +
      sizeText +
      `\n🆔 *Código:* ${id}\n` +
      `💰 *Precio Especial:* $${formattedPrice} COP\n\n` +
      `📍 _Por favor, indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._`;

    const encodedMessage = encodeURIComponent(message);
    const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;

    // Meta Pixel event
    if (typeof window !== 'undefined' && (window as any).fbq) {
      (window as any).fbq('track', 'InitiateCheckout', {
        content_ids: [id],
        content_type: 'product',
        content_name: name,
        value: price,
        currency: 'COP'
      }, { eventID: `evt-${id}-${Date.now()}` });
    }

    setTimeout(() => {
      window.open(whatsAppUrl, '_blank');
    }, 300);
  });
</script>
