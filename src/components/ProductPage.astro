---
/**
 * ProductPage.astro — Layout de página de producto individual (AliExpress / Page Pilot style)
 * 
 * Secciones:
 * 1. Breadcrumbs
 * 2. Grid principal (Imagen a la izquierda, detalles y compra a la derecha)
 * 3. Urgency Offer Banner (Oferta 1 por $90k, 2 por $160k, 3 por $234k)
 * 4. AliExpress style trust bar
 * 5. AliExpress style reviews (Testimonios)
 * 6. FAQ Accordion (Preguntas Frecuentes)
 */
import { formatPrice, getDiscount } from '../data/products';
import type { Product } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  product: Product;
  categoryLabel: string;
  categoryHref: string;
  allProducts?: Product[];
}

const { product, categoryLabel, categoryHref, allProducts = [] } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
const hasVariants = product.variants && product.variants.length > 0;
const whatsappNumber = STORE_CONFIG.whatsapp.number;

// Find other color variants of this jacket family
const colorVariants = product.category === 'chaquetas'
  ? allProducts.filter(p => p.category === 'chaquetas')
  : [];

// Dynamic reviews based on category
const reviews = product.category === 'perfumes'
  ? [
      {
        name: "María F.",
        rating: 5,
        date: "Hace 2 días",
        text: "Me encantó el perfume. Es 100% original, venía sellado y con su caja intacta de fábrica. La fragancia dura muchísimo. Me lo entregaron el mismo día aquí en Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Andrés G.",
        rating: 5,
        date: "Hace 4 días",
        text: "Excelente servicio. Pedí la loción Bleu Intense y me llegó a Ipiales en 2 días por Servientrega. El pago contra entrega me dio mucha seguridad.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Liliana R.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Súper recomendado. Compré Vibranza de Ésika y el aroma es exquisito, tal cual el catálogo original de Ésika. El precio es el mejor de Nariño.",
        verified: true,
        avatar: "👩"
      }
    ]
  : product.category === 'relojes'
  ? [
      {
        name: "Roberto T.",
        rating: 5,
        date: "Hace 3 días",
        text: "El reloj es precioso, el diseño minimalista combina con todo. La correa de cuero es suave y de buena calidad. Me lo entregaron gratis en Pasto.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Claudia V.",
        rating: 5,
        date: "Hace 6 días",
        text: "Pedí el modelo Elegance en acero y tiene unos acabados muy finos. Se ve muy costoso. Llegó rápido y bien empacado.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Fernando S.",
        rating: 5,
        date: "Hace 2 semanas",
        text: "Soporta salpicaduras de agua y el cristal es resistente. Por este precio es un regalo. Excelente producto.",
        verified: true,
        avatar: "👨"
      }
    ]
  : [
      {
        name: "Cristian I.",
        rating: 5,
        date: "Hace 1 día",
        text: "Excelente calidad, la tela es impermeable y es forrada por dentro súper calientica. El gorro se puede quitar y poner fácil. Talla L me quedó excelente. Me la entregaron a domicilio hoy mismo en Pasto y pagué al recibir.",
        verified: true,
        avatar: "👨"
      },
      {
        name: "Marta P.",
        rating: 5,
        date: "Hace 3 días",
        text: "Pedí el Pack 2 (Duo Estilo) para mi esposo y para mí. Nos ahorramos 20 mil pesos y el material es excelente. Súper abrigadas para el frío de Pasto.",
        verified: true,
        avatar: "👩"
      },
      {
        name: "Carlos E.",
        rating: 5,
        date: "Hace 1 semana",
        text: "Tenía dudas de comprar porque soy de Ipiales, pero me hicieron el envío nacional por Servientrega y pagué en efectivo al recibir a los 3 días. La chaqueta es de horma un poco reducida pero pedí una talla más como recomiendan y quedó perfecta.",
        verified: true,
        avatar: "👨"
      }
    ];

// Dynamic FAQs based on category
const faqs = product.category === 'perfumes'
  ? [
      {
        question: "¿En cuánto tiempo llega mi pedido de loción?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles a cualquier municipio de Colombia."
      },
      {
        question: "¿Puedo pagar al recibir?",
        answer: "Sí. Ofrecemos pago contra entrega tanto para Pasto como para envíos nacionales en todo Colombia. Pagas en efectivo, Nequi o Daviplata al recibir tu paquete."
      },
      {
        question: "¿Las fragancias son 100% originales de catálogo?",
        answer: "Sí. Todos nuestros perfumes son 100% originales, adquiridos directamente en los canales de venta oficial de Yanbal, Ésika, Cyzone, Avon y L'Bel. Vienen en sus empaques originales sellados de fábrica con celofán y códigos de lote verificables."
      },
      {
        question: "¿Cómo funciona la garantía de perfumes?",
        answer: "Garantizamos el perfecto estado del producto. Si tu perfume presenta fallas en la válvula, atomizador o filtración durante los primeros 5 días hábiles, te realizamos el cambio inmediato sin costo en nuestro punto físico en Pasto."
      }
    ]
  : product.category === 'relojes'
  ? [
      {
        question: "¿En cuánto tiempo llega mi reloj?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles."
      },
      {
        question: "¿Puedo pagar contra entrega?",
        answer: "Sí. Ofrecemos pago contra entrega tanto para Pasto como para envíos nacionales en todo Colombia. Pagas únicamente al recibir tu reloj."
      },
      {
        question: "¿Tienen garantía los relojes?",
        answer: "Sí, todos nuestros relojes cuentan con 30 días de garantía por maquinaria o defectos de fabricación. Los cambios de modelo o devoluciones se pueden realizar en nuestro punto físico en Pasto durante los primeros 5 días."
      },
      {
        question: "¿Los relojes son resistentes al agua?",
        answer: "Nuestros relojes soportan salpicaduras de agua leves por lavado de manos o lluvia. No son aptos para sumergir, bañarse o nadar."
      }
    ]
  : [
      {
        question: "¿En cuánto tiempo llega mi pedido?",
        answer: "Pasto: Entrega a domicilio inmediata el mismo día para pedidos confirmados antes de las 6:00 PM.\nNacional: Envíos nacionales por transportadora (Servientrega, Envía, Interrapidisimo) demoran entre 3 a 5 días hábiles a cualquier ciudad de Colombia."
      },
      {
        question: "¿Puedo pagar cuando reciba el producto?",
        answer: "Sí. Ofrecemos pago contra entrega en efectivo, Nequi o Daviplata tanto para entrega a domicilio en Pasto como para envíos nacionales en todo Colombia. Pagas únicamente al recibir tu paquete."
      },
      {
        question: "¿Qué talla debo elegir y cuáles son las medidas?",
        answer: "Ten en cuenta que nuestras chaquetas son de horma un poco reducida. 😉 Te aconsejamos pedir una talla más de la habitual si te gusta usarla holgada.\n\nMedidas disponibles:\n• Talla M: Largo 63.5 cm, Ancho 53.5 cm\n• Talla L: Largo 67 cm, Ancho 57 cm\n• Talla XL: Largo 70 cm, Ancho 60 cm\n• Talla XXL: Largo 74 cm, Ancho 64 cm"
      },
      {
        question: "¿Cómo funciona la garantía y cambios?",
        answer: "Ofrecemos cambio de talla durante los primeros 5 días. En Pasto puedes realizar el cambio directamente en nuestro punto físico o coordinarlo a domicilio. Cuentas también con 30 días de garantía por cualquier defecto de fábrica."
      }
    ];
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 md:pb-10">
  <Breadcrumbs items={[
    { label: categoryLabel, href: categoryHref },
    { label: product.name }
  ]} />

  <!-- 1. Main Grid -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 bg-white rounded-md border border-[#E5E7EB] p-4 sm:p-8 mb-12">
    <!-- Left Column: Media -->
    <div class="lg:col-span-7 space-y-4">
      <div class="relative overflow-hidden rounded-md bg-[#F3F4F6] aspect-square border border-[#E5E7EB]">
        <img 
          src={product.image} 
          alt={product.name}
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          id="main-product-image"
          loading="eager"
        />
        {discount > 0 && (
          <div class="absolute top-4 left-4 bg-red-600 text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-wider shadow-lg">
            Oferta -{discount}%
          </div>
        )}
        {product.status === 'agotado' && (
          <div class="absolute top-4 right-4 bg-neutral-850 text-neutral-400 text-[9px] font-black px-3 py-1.5 rounded-md uppercase tracking-wider">
            Agotado
          </div>
        )}
      </div>
      
      {/* Visual thumbnails */}
      {product.images && product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-2">
          {product.images.map((img, i) => (
            <button class="rounded-md overflow-hidden border border-[#E5E7EB] hover:border-text-main transition-all aspect-square thumbnail-btn" data-img={img}>
              <img src={img} alt={`${product.name} vista ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Buying controls & Conversion details -->
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div>
        <!-- Brand & Rating header -->
        <div class="flex items-center gap-2 mb-2">
          <span class="text-[9px] font-black text-text-main bg-[#F9F9FB] border border-[#E5E7EB] px-2.5 py-1 rounded-md uppercase tracking-widest">Calidad Premium</span>
          <div class="flex items-center text-gold text-xs font-semibold gap-1">
            <span>★★★★★</span>
            <span class="text-text-muted text-[10px] font-medium ml-1">4.7 (48)</span>
          </div>
        </div>
        
        <!-- Title -->
        <h1 class="text-xl sm:text-2xl font-black text-text-main uppercase tracking-wider leading-tight mb-2 font-title" id="product-title">
          {product.name}
        </h1>

        <!-- Price Anchoring Comparison Block -->
        <div class="p-4 bg-[#F9F9FB] rounded-md mb-6 border border-[#E5E7EB] shadow-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] text-text-muted uppercase font-black tracking-widest">Oferta Local Contraentrega</span>
            <span class="bg-red-600 text-white text-[10px] font-black px-2.5 py-0.5 rounded-md uppercase tracking-widest shadow-sm" id="display-saving-badge">
              AHORRAS {getDiscount(product.price, product.anchorPrice)}%
            </span>
          </div>
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs text-text-muted">
              <span>Precio Comercial:</span>
              <span class="line-through font-semibold text-text-light" id="display-anchor-price">${formatPrice(product.anchorPrice)} COP</span>
            </div>
            <div class="flex items-center justify-between text-base sm:text-lg font-black text-text-main font-title pt-1 border-t border-[#E5E7EB]">
              <span>Precio Estilo Nórdico:</span>
              <span class="text-2xl sm:text-3xl text-emerald-600 font-black font-title" id="display-price">${formatPrice(product.price)} COP</span>
            </div>
          </div>
        </div>

        <!-- Color selector (swatches) -->
        {colorVariants.length > 0 && (
          <div class="mb-6">
            <label class="block text-sm font-bold text-text-main mb-2">Color:</label>
            <div class="flex flex-wrap gap-2.5">
              {colorVariants.map((cv) => {
                const isActive = cv.slug === product.slug;
                const colorName = cv.name.replace('Chaqueta Impermeable ', '');
                return (
                  <a
                    href={`/chaquetas/${cv.slug}`}
                    class:list={[
                      'w-9 h-9 rounded-full border-2 transition-all duration-200 flex items-center justify-center relative hover:scale-110 shadow-sm',
                      isActive
                        ? 'border-primary ring-2 ring-primary/20 scale-105'
                        : 'border-border hover:border-text-muted'
                    ]}
                    style={`background-color: ${cv.colorHex || '#ccc'}`}
                    title={colorName}
                  >
                    {isActive && (
                      <span class="absolute w-2 h-2 rounded-full bg-white shadow-sm"></span>
                    )}
                  </a>
                );
              })}
            </div>
            <p class="mt-2 text-xs text-text-muted">Color seleccionado: <span class="font-bold text-text-main">{product.name.replace('Chaqueta Impermeable ', '')}</span></p>
          </div>
        )}

        <!-- Variant selector (sizes) -->
        {hasVariants && (
          <div class="mb-6" id="variant-selector">
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-black text-text-main uppercase tracking-widest">Talla:</label>
              <span class="text-[9px] text-text-main font-black bg-[#F9F9FB] border border-[#E5E7EB] px-2.5 py-1 rounded-md uppercase tracking-wider">Horma reducida 😉</span>
            </div>
            <div class="flex flex-wrap gap-2" id="size-options">
              {product.variants!.map((v) => (
                <button
                  class:list={[
                    'size-btn px-4 py-2.5 rounded-md text-xs font-black uppercase tracking-widest border transition-all duration-200 shadow-sm flex items-center gap-1.5',
                    v.status === 'disponible'
                      ? 'border-[#E5E7EB] hover:border-text-main cursor-pointer bg-white text-text-main'
                      : 'border-[#F3F4F6] text-text-light line-through cursor-not-allowed opacity-40 bg-[#F9F9FB]'
                  ]}
                  data-talla={v.talla}
                  data-stock={v.stock}
                  data-ref={v.referencia}
                  data-variant-id={v.id}
                  data-available={v.status === 'disponible' ? 'true' : 'false'}
                  disabled={v.status !== 'disponible'}
                >
                  {v.talla}
                  {v.status === 'disponible' && (
                    <span class="text-[9px] text-text-muted font-black bg-[#F9F9FB] border border-[#E5E7EB] px-1.5 py-0.5 rounded-sm">({v.stock})</span>
                  )}
                </button>
              ))}
            </div>
            <p class="mt-2 text-[10px] text-text-muted uppercase tracking-wider" id="selected-size-info">Selecciona una talla para pedir</p>

            {product.status === 'agotado' && (
              <div class="my-3.5 p-3.5 bg-amber-50 border border-amber-200 rounded-md text-amber-900 text-xs flex gap-2.5 items-start text-left">
                <span class="text-base leading-none">🔔</span>
                <div>
                  <p class="font-black uppercase tracking-wider text-[10px] text-amber-900">¿Buscabas este modelo/color?</p>
                  <p class="font-light mt-0.5 leading-relaxed text-[11px] text-amber-800">No te preocupes. Escríbenos y <strong>lo encargaremos en nuestro próximo pedido de fábrica</strong> sin ningún compromiso. ¡Te avisamos apenas esté listo!</p>
                </div>
              </div>
            )}

            <!-- Mini visual measurements table -->
            <div class="mt-4 p-3.5 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
              <span class="text-[9px] font-black text-text-muted uppercase tracking-widest block mb-2.5">Medidas de costura:</span>
              <div class="grid grid-cols-4 gap-2 text-center text-[10px] font-black text-text-main uppercase">
                <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">M: 63x53 cm</div>
                <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">L: 67x57 cm</div>
                <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">XL: 70x60 cm</div>
                <div class="p-1.5 bg-white rounded-md border border-[#E5E7EB]">XXL: 74x64 cm</div>
              </div>
            </div>
          </div>
        )}

        <!-- 3. AliExpress Package Selector Widget -->
        {product.category === 'chaquetas' && (
          <div class="mb-6">
            <label class="block text-xs font-black text-text-muted uppercase tracking-widest mb-3">Elige tu mejor oferta hoy:</label>
            <div class="grid grid-cols-1 gap-3">
              <!-- Pack 1 -->
              <button 
                class="pack-option border border-text-main bg-neutral-50 rounded-md p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="1"
                data-pack-name="Pack 1 Individual"
                data-pack-price={product.price}
                data-pack-anchor={product.anchorPrice}
                data-pack-desc="1 Chaqueta (Ideal para probar)"
              >
                <div>
                  <span class="inline-block bg-[#F9F9FB] border border-[#E5E7EB] text-text-main text-[8px] font-black px-2.5 py-0.5 rounded-sm uppercase tracking-widest mb-1">Individual</span>
                  <p class="text-xs sm:text-sm font-black text-text-main uppercase tracking-wider font-title">1 Chaqueta</p>
                  <p class="text-[10px] text-text-muted font-light">Largo y ancho exacto</p>
                </div>
                <div class="text-right">
                  <p class="text-base sm:text-lg font-black text-text-main font-title" id="pack-1-price">${formatPrice(product.price)}</p>
                  <p class="text-xs text-text-light line-through" id="pack-1-anchor">${formatPrice(product.anchorPrice)}</p>
                </div>
                <div class="absolute -top-1.5 -right-1.5 bg-text-main text-white w-4.5 h-4.5 rounded-full flex items-center justify-center text-[10px] font-bold" id="pack-check-1">✓</div>
              </button>

              <!-- Pack 2 -->
              <button 
                class="pack-option border border-[#E5E7EB] hover:border-neutral-500 bg-white rounded-md p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="2"
                data-pack-name="Pack 2 Duo Estilo"
                data-pack-price={Math.round(product.price * 2 - 20000)}
                data-pack-anchor={product.anchorPrice * 2}
                data-pack-desc="2 Chaquetas (Ahorras $20.000)"
              >
                <div>
                  <span class="inline-block bg-gold/10 border border-gold/30 text-gold text-[8px] font-black px-2.5 py-0.5 rounded-sm uppercase tracking-widest mb-1">Más vendido</span>
                  <p class="text-xs sm:text-sm font-black text-text-main uppercase tracking-wider font-title">2 Chaquetas</p>
                  <p class="text-[10px] text-text-muted font-light">Ahorras $20.000 en combo</p>
                </div>
                <div class="text-right">
                  <p class="text-base sm:text-lg font-black text-text-main font-title" id="pack-2-price">${formatPrice(Math.round(product.price * 2 - 20000))}</p>
                  <p class="text-xs text-text-light line-through" id="pack-2-anchor">${formatPrice(product.anchorPrice * 2)}</p>
                </div>
                <div class="absolute -top-1.5 -right-1.5 bg-text-main text-white w-4.5 h-4.5 rounded-full flex items-center justify-center text-[10px] font-bold hidden" id="pack-check-2">✓</div>
              </button>

              <!-- Pack 3 -->
              <button 
                class="pack-option border border-[#E5E7EB] hover:border-neutral-500 bg-white rounded-md p-4 text-left flex justify-between items-center transition-all cursor-pointer relative"
                data-pack-id="3"
                data-pack-name="Pack 3 Combo Familiar"
                data-pack-price={Math.round(product.price * 3 * 0.87)}
                data-pack-anchor={product.anchorPrice * 3}
                data-pack-desc="3 Chaquetas ($78.000 c/u)"
              >
                <div>
                  <span class="inline-block bg-neutral-100 border border-neutral-200 text-text-muted text-[8px] font-black px-2.5 py-0.5 rounded-sm uppercase tracking-widest mb-1">Ahorro Máximo</span>
                  <p class="text-xs sm:text-sm font-black text-text-main uppercase tracking-wider font-title">3 Chaquetas</p>
                  <p class="text-[10px] text-text-muted font-light">Mejor precio por unidad</p>
                </div>
                <div class="text-right">
                  <p class="text-base sm:text-lg font-black text-text-main font-title" id="pack-3-price">${formatPrice(Math.round(product.price * 3 * 0.87))}</p>
                  <p class="text-xs text-text-light line-through" id="pack-3-anchor">${formatPrice(product.anchorPrice * 3)}</p>
                </div>
                <div class="absolute -top-1.5 -right-1.5 bg-text-main text-white w-4.5 h-4.5 rounded-full flex items-center justify-center text-[10px] font-bold hidden" id="pack-check-3">✓</div>
              </button>
            </div>
          </div>
        )}

        <!-- Stock state -->
        <div class="mb-6 flex items-center gap-2">
          {product.status === 'agotado' ? (
            <>
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
              </span>
              <span class="text-[10px] font-black text-red-600 uppercase tracking-widest text-left">Agotado temporalmente</span>
            </>
          ) : (
            <>
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
              </span>
              <span class="text-[10px] font-black text-green-500 uppercase tracking-widest text-left">Stock real disponible para entrega hoy</span>
            </>
          )}
        </div>
      </div>

      <!-- Actions -->
      <div class="space-y-4">
        <!-- Action Buttons Bar: Desktop (In-page) -->
        <div class="hidden md:grid grid-cols-2 gap-3">
          <!-- Add to Cart Button -->
          <button
            id="product-add-cart-btn"
            class:list={[
              "w-full py-3.5 px-4 rounded-md text-xs font-black tracking-widest uppercase transition-all duration-300 cursor-pointer border-2 shadow-sm flex items-center justify-center gap-2",
              product.status === 'agotado'
                ? "opacity-50 cursor-not-allowed bg-neutral-200 text-neutral-500 border-neutral-300"
                : "bg-[#0B0B0C] hover:bg-[#1A1A1D] text-white border-[#0B0B0C] hover:border-[#C9A962]"
            ]}
            data-product-name={product.name}
            data-product-brand={product.brand}
            data-product-id={product.id}
            data-product-price={product.price}
            data-product-image={product.image}
            data-product-category={product.category}
            data-has-variants={hasVariants ? 'true' : 'false'}
            data-status={product.status}
            disabled={product.status === 'agotado'}
          >
            <svg class="w-4 h-4 text-[#C9A962]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>+ Agregar al Carrito</span>
          </button>

          <!-- Direct WhatsApp Buy Button -->
          <button
            id="product-buy-btn"
            class:list={[
              "w-full py-3.5 px-4 rounded-md text-xs font-black tracking-widest uppercase transition-all duration-300 cursor-pointer border-2 shadow-md flex items-center justify-center gap-2",
              product.status === 'agotado'
                ? "bg-[#C9A962] hover:bg-[#D4B878] text-[#0B0B0C] border-[#C9A962]"
                : "bg-[#25D366] hover:bg-[#1DA851] text-white border-[#25D366]"
            ]}
            data-product-name={product.name}
            data-product-brand={product.brand}
            data-product-id={product.id}
            data-product-price={product.price}
            data-phone={whatsappNumber}
            data-has-variants={hasVariants ? 'true' : 'false'}
            data-status={product.status}
          >
            <span id="buy-btn-text">
              {product.status === 'agotado'
                ? 'Encargar Próximo Pedido'
                : '🟢 Pedir WhatsApp (Pasto)'}
            </span>
          </button>
        </div>

        <!-- Sticky Mobile Bottom Bar (Bershka / ASOS / Tienda Urban CRO Benchmark) -->
        <div class="fixed bottom-0 left-0 right-0 z-40 bg-[#0B0B0C]/95 backdrop-blur-md border-t border-[#262626] p-2.5 px-4 shadow-2xl flex items-center justify-between gap-3 md:hidden">
          <div class="flex flex-col min-w-[95px]">
            <span class="text-[9px] text-[#C9A962] font-black uppercase tracking-widest" id="mobile-sticky-size">
              Talla: Elegir
            </span>
            <span class="text-sm font-black text-white font-title tracking-wider" id="mobile-sticky-price">
              ${formatPrice(product.price)} COP
            </span>
          </div>

          <div class="flex items-center gap-2 flex-1">
            <button
              id="mobile-sticky-cart-btn"
              type="button"
              class="p-2.5 rounded-md border border-white/20 bg-white/5 hover:bg-white/10 text-white flex items-center justify-center cursor-pointer active:scale-95 transition-transform"
              aria-label="Agregar al carrito"
            >
              <svg class="w-5 h-5 text-[#C9A962]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </button>

            <button
              id="mobile-sticky-buy-btn"
              type="button"
              class="flex-1 py-3 px-3 bg-[#25D366] hover:bg-[#1DA851] text-white rounded-md text-[11px] font-black uppercase tracking-wider flex items-center justify-center gap-1 shadow-lg cursor-pointer active:scale-95 transition-transform"
            >
              <span>🟢 Pedir Contraentrega Pasto</span>
            </button>
          </div>
        </div>

        <!-- Social Proof Widget -->
        <div class="p-3 bg-[#F9F9FB] border border-[#E5E7EB] rounded-md flex items-center justify-center gap-2 text-center">
          <span class="text-xs font-black text-text-main uppercase tracking-widest">
            {product.category === 'chaquetas' && 'Más de 500 chaquetas entregadas en Nariño'}
            {product.category === 'perfumes' && 'Más de 800 lociones entregadas en Nariño'}
            {product.category === 'relojes' && 'Más de 300 relojes entregados en Nariño'}
          </span>
        </div>

        <!-- Trust seals AliExpress style -->
        <div class="grid grid-cols-3 gap-3 text-center border-t border-[#E5E7EB] pt-4">
          <div class="flex flex-col items-center">
            <span class="text-[10px] font-black text-text-main uppercase tracking-widest">Pago en Casa</span>
            <span class="text-[9px] text-text-muted mt-0.5">Domicilio en Pasto</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-[10px] font-black text-text-main uppercase tracking-widest">Envíos del país</span>
            <span class="text-[9px] text-text-muted mt-0.5">Llega de 3 a 5 días</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-[10px] font-black text-text-main uppercase tracking-widest">
              {product.category === 'chaquetas' && 'Premium'}
              {product.category === 'perfumes' && 'Original'}
              {product.category === 'relojes' && 'Nórdico'}
            </span>
            <span class="text-[9px] text-text-muted mt-0.5">
              {product.category === 'chaquetas' && 'Confección nacional'}
              {product.category === 'perfumes' && 'Distribuidor oficial'}
              {product.category === 'relojes' && 'Garantía de máquina'}
            </span>
          </div>
        </div>

        <!-- Callout Banner for Direct Distributor request (for Perfumes/Watches only - High Contrast Dark Card with Gentle Bounce Button) -->
        {product.category !== 'chaquetas' && (
          <div class="p-6 bg-neutral-900 border border-neutral-800 rounded-md text-center mt-6 shadow-md">
            <p class="text-xs sm:text-sm font-black text-white uppercase tracking-widest">
              {product.category === 'perfumes' ? '¿No encuentras tu loción favorita?' : '¿Buscas otro modelo de reloj?'}
            </p>
            <p class="text-[11px] text-zinc-300 mt-1.5 font-light leading-relaxed">
              {product.category === 'perfumes' 
                ? 'Trabajamos directo con distribuidor de fábrica. ¡Pregunta por la que deseas para conseguírtela hoy mismo!' 
                : 'Trabajamos directo con distribuidor autorizado. ¡Pregunta por el que deseas para conseguírtelo hoy mismo!'}
            </p>
            <a 
              href={`https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(
                product.category === 'perfumes' 
                  ? 'Hola, estoy buscando una loción de catálogo que no veo en la web. Pregunto por la que deseo para conseguírmela hoy mismo. ¿Me ayudan?' 
                  : 'Hola, estoy buscando un modelo de reloj de catálogo que no veo en la web. Pregunto por el que deseo para conseguírmelo hoy mismo. ¿Me ayudan?'
              )}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-3.5 text-[9px] sm:text-[10px] font-black border border-white bg-white hover:bg-neutral-200 text-black px-6 py-3.5 rounded-md transition-all duration-300 uppercase tracking-widest cursor-pointer shadow-md animate-bounce-gentle"
            >
              Consultar por WhatsApp
            </a>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- 2. AliExpress Description & Marketing Sections -->
  <div class="grid lg:grid-cols-3 gap-8 mb-12">
    <!-- Description & Features (Left/Middle 2 Columns) -->
    <div class="lg:col-span-2 space-y-8">
      <div class="bg-white rounded-md border border-[#E5E7EB] p-6 sm:p-8">
        <h2 class="text-sm sm:text-base font-black text-text-main border-b border-[#E5E7EB] pb-4 mb-6 uppercase tracking-widest font-title">Detalles del Producto</h2>
        
        <p class="text-xs sm:text-sm text-text-muted mb-6 leading-relaxed font-light">
          {product.description}
        </p>

        <!-- High conversion features grid with icons -->
        {product.features && product.features.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4">
            {product.features.map((feature) => (
              <div class="flex items-center gap-3 p-3 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
                <span class="flex items-center justify-center w-5 h-5 rounded-md bg-[#E5E7EB] border border-[#D1D5DB] text-text-main text-[9px] font-black">✓</span>
                <span class="text-xs font-semibold text-text-main uppercase tracking-wider">{feature}</span>
              </div>
            ))}
          </div>
        )}
      </div>


      <!-- Guarantee Section (AliExpress style) -->
      <div class="bg-white rounded-md border border-[#E5E7EB] p-6 sm:p-8">
        <h2 class="text-sm sm:text-base font-black text-text-main border-b border-[#E5E7EB] pb-4 mb-6 uppercase tracking-widest font-title">Nuestra Garantía</h2>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="text-center p-4 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
            <span class="text-3xl mb-2 block">{product.category === 'chaquetas' ? '🏠' : '✨'}</span>
            <h3 class="text-xs font-black text-text-main uppercase mb-1">
              {product.category === 'chaquetas' ? 'Pruébalo en Casa' : '100% Original'}
            </h3>
            <p class="text-[10px] text-text-muted leading-relaxed">
              {product.category === 'chaquetas' 
                ? 'Te lo llevamos a domicilio en Pasto. Te lo mides y si te queda bien, lo pagas.' 
                : 'Fragancias oficiales selladas de fábrica y directas del catálogo oficial.'}
            </p>
          </div>
          <div class="text-center p-4 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
            <span class="text-[9px] font-black text-text-main uppercase tracking-widest block mb-1">01 / Cambio de Talla</span>
            <h3 class="text-xs sm:text-sm font-black text-text-main uppercase mb-1">Punto Físico</h3>
            <p class="text-[10px] text-text-muted leading-relaxed">
              {product.category === 'chaquetas'
                ? 'Si necesitas un cambio de talla, puedes acercarte a nuestro showroom en Pasto.'
                : 'Para cualquier reclamo o cambio, puedes visitarnos en nuestro punto físico en Pasto.'}
            </p>
          </div>
          <div class="text-center p-4 bg-[#F9F9FB] rounded-md border border-[#E5E7EB]">
            <span class="text-[9px] font-black text-text-main uppercase tracking-widest block mb-1">02 / Satisfacción</span>
            <h3 class="text-xs sm:text-sm font-black text-text-main uppercase mb-1">Garantía Segura</h3>
            <p class="text-[10px] text-text-muted leading-relaxed">
              {product.category === 'chaquetas'
                ? 'Garantizamos cambio de talla sin complicaciones dentro de los primeros 5 días.'
                : 'Garantizamos cambio inmediato por fallas en válvula o defectos en los primeros 5 días.'}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Sidebar FAQ (1 Column) -->
    <div class="space-y-8">
      <div class="bg-white rounded-md border border-[#E5E7EB] p-6 sm:p-8">
        <h2 class="text-sm sm:text-base font-black text-text-main border-b border-[#E5E7EB] pb-4 mb-6 uppercase tracking-widest font-title">Preguntas Frecuentes</h2>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group bg-[#F9F9FB] border border-[#E5E7EB] rounded-md overflow-hidden [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
              <summary class="flex justify-between items-center p-4 cursor-pointer select-none">
                <span class="text-xs font-black text-text-main uppercase tracking-widest pr-4">{faq.question}</span>
                <span class="text-text-muted group-open:rotate-180 transition-transform duration-200">▼</span>
              </summary>
              <div class="p-4 pt-0 border-t border-[#E5E7EB]">
                <p class="text-xs text-text-muted leading-relaxed whitespace-pre-line font-light">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 3. AliExpress Customer Reviews Section -->
  <div class="bg-white rounded-md border border-[#E5E7EB] p-6 sm:p-8 mb-12" id="reviews-section">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-[#E5E7EB] pb-4 mb-6 gap-4">
      <div>
        <h2 class="text-sm sm:text-base font-black text-text-main uppercase tracking-widest font-title">Valoraciones de Clientes</h2>
        <p class="text-xs text-text-muted mt-1 font-light">Opiniones verificadas de compradores de San Juan de Pasto y Nariño</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-black text-text-main font-title">4.7</span>
        <div class="flex flex-col">
          <span class="text-gold text-sm font-semibold">★★★★★</span>
          <span class="text-[9px] text-text-muted font-black uppercase tracking-widest mt-0.5">Valoraciones reales del local</span>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="p-5 bg-[#F9F9FB] rounded-md border border-[#E5E7EB] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <div>
                  <h3 class="text-xs font-black text-text-main uppercase tracking-widest">{rev.name}</h3>
                  <span class="text-[9px] text-green-500 font-bold flex items-center gap-1 uppercase tracking-wider">
                    <span>✓</span> Verificado
                  </span>
                </div>
              </div>
              <span class="text-[10px] text-text-light">{rev.date}</span>
            </div>
            <div class="text-gold text-xs font-semibold mb-2">★★★★★</div>
            <p class="text-xs text-text-muted leading-relaxed font-light">{rev.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { addToCart } from '../lib/cart';

  // Size selector and WhatsApp button logic
  const sizeButtons = document.querySelectorAll('.size-btn');
  const buyBtn = document.getElementById('product-buy-btn') as HTMLButtonElement;
  const addCartBtn = document.getElementById('product-add-cart-btn') as HTMLButtonElement;
  const buyBtnText = document.getElementById('buy-btn-text');
  const sizeInfo = document.getElementById('selected-size-info');
  const packOptions = document.querySelectorAll('.pack-option');
  
  let selectedSize = '';
  let selectedRef = '';
  let selectedVariantId = '';
  let selectedPack = '1';
  let selectedPackName = 'Pack 1 Individual';
  let selectedPackPrice = buyBtn ? parseFloat(buyBtn.getAttribute('data-product-price') || '90000') : 90000;
  let selectedPackDesc = '1 Chaqueta (Ideal para probar)';

  // Sincronización instantánea de precios, packs y stock en vivo con el ERP
  async function syncProductWithLiveERP() {
    try {
      const res = await fetch('http://localhost:8000/api/public/products');
      if (!res.ok) return;
      const products: any[] = await res.json();
      
      const currentColor = document.querySelector('p.text-xs.text-text-muted span.font-bold')?.textContent?.trim().toLowerCase() || '';

      const matchingVariants = products.filter((p: any) => {
        if (!p.ref || !p.ref.startsWith('5080')) return false;
        if (currentColor && p.color && p.color.toLowerCase().trim() === currentColor) return true;
        return false;
      });

      if (matchingVariants.length === 0) return;

      const liveItem = matchingVariants.find((v: any) => v.price_sale && v.price_sale > 0) || matchingVariants[0];
      const livePrice = Number(liveItem?.price_sale);
      const liveAnchor = Number(liveItem?.compare_price) || 120000;

      if (livePrice && !isNaN(livePrice)) {
        if (buyBtn) buyBtn.setAttribute('data-product-price', String(livePrice));
        if (addCartBtn) addCartBtn.setAttribute('data-product-price', String(livePrice));

        const p1 = livePrice;
        const p2 = Math.round(livePrice * 2 - 20000);
        const p3 = Math.round(livePrice * 3 * 0.87);

        const a1 = liveAnchor;
        const a2 = liveAnchor * 2;
        const a3 = liveAnchor * 3;

        const pack1Btn = document.querySelector('.pack-option[data-pack-id="1"]');
        if (pack1Btn) {
          pack1Btn.setAttribute('data-pack-price', String(p1));
          pack1Btn.setAttribute('data-pack-anchor', String(a1));
          const el = document.getElementById('pack-1-price');
          if (el) el.textContent = `$${new Intl.NumberFormat('es-CO').format(p1)}`;
          const anchorEl = document.getElementById('pack-1-anchor');
          if (anchorEl) anchorEl.textContent = `$${new Intl.NumberFormat('es-CO').format(a1)}`;
        }

        const pack2Btn = document.querySelector('.pack-option[data-pack-id="2"]');
        if (pack2Btn) {
          pack2Btn.setAttribute('data-pack-price', String(p2));
          pack2Btn.setAttribute('data-pack-anchor', String(a2));
          const el = document.getElementById('pack-2-price');
          if (el) el.textContent = `$${new Intl.NumberFormat('es-CO').format(p2)}`;
          const anchorEl = document.getElementById('pack-2-anchor');
          if (anchorEl) anchorEl.textContent = `$${new Intl.NumberFormat('es-CO').format(a2)}`;
        }

        const pack3Btn = document.querySelector('.pack-option[data-pack-id="3"]');
        if (pack3Btn) {
          pack3Btn.setAttribute('data-pack-price', String(p3));
          pack3Btn.setAttribute('data-pack-anchor', String(a3));
          const el = document.getElementById('pack-3-price');
          if (el) el.textContent = `$${new Intl.NumberFormat('es-CO').format(p3)}`;
          const anchorEl = document.getElementById('pack-3-anchor');
          if (anchorEl) anchorEl.textContent = `$${new Intl.NumberFormat('es-CO').format(a3)}`;
        }

        if (selectedPack === '1') {
          selectedPackPrice = p1;
        } else if (selectedPack === '2') {
          selectedPackPrice = p2;
        } else if (selectedPack === '3') {
          selectedPackPrice = p3;
        }

        const displayPrice = document.getElementById('display-price');
        const displayAnchorPrice = document.getElementById('display-anchor-price');
        const displaySavingBadge = document.getElementById('display-saving-badge');
        
        const activeAnchor = selectedPack === '1' ? a1 : (selectedPack === '2' ? a2 : a3);
        const discountPct = Math.round(((activeAnchor - selectedPackPrice) / activeAnchor) * 100);

        if (displayPrice) displayPrice.textContent = `$${new Intl.NumberFormat('es-CO').format(selectedPackPrice)} COP`;
        if (displayAnchorPrice) displayAnchorPrice.textContent = `$${new Intl.NumberFormat('es-CO').format(activeAnchor)} COP`;
        if (displaySavingBadge) displaySavingBadge.textContent = `AHORRAS ${discountPct}%`;
        if (mobileStickyPrice) mobileStickyPrice.textContent = `$${new Intl.NumberFormat('es-CO').format(selectedPackPrice)} COP`;
      }

      // Sincronizar tallas y stock
      sizeButtons.forEach(btn => {
        const buttonEl = btn as HTMLButtonElement;
        const talla = buttonEl.getAttribute('data-talla')?.toUpperCase();
        const variantLive = matchingVariants.find((v: any) => v.size?.toUpperCase() === talla);
        if (variantLive) {
          const liveStock = variantLive.stock || 0;
          buttonEl.setAttribute('data-stock', String(liveStock));
          buttonEl.setAttribute('data-available', liveStock > 0 ? 'true' : 'false');
          buttonEl.setAttribute('data-variant-id', String(variantLive.id));
          buttonEl.disabled = liveStock <= 0;

          const badge = buttonEl.querySelector('span');
          if (liveStock > 0) {
            buttonEl.classList.remove('line-through', 'opacity-40', 'cursor-not-allowed', 'border-[#F3F4F6]');
            buttonEl.classList.add('border-[#E5E7EB]', 'hover:border-text-main', 'cursor-pointer');
            if (badge) badge.textContent = `(${liveStock})`;
          } else {
            buttonEl.classList.add('line-through', 'opacity-40', 'cursor-not-allowed', 'border-[#F3F4F6]');
            buttonEl.classList.remove('border-[#E5E7EB]', 'hover:border-text-main', 'cursor-pointer');
            if (badge) badge.textContent = '(0)';
          }
        }
      });
    } catch (_) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncProductWithLiveERP);
  } else {
    syncProductWithLiveERP();
  }
  window.addEventListener('focus', syncProductWithLiveERP);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') syncProductWithLiveERP();
  });

  // Sticky Mobile Bottom Bar Listeners (Tienda Urban / ASOS Style)
  const mobileStickyBuyBtn = document.getElementById('mobile-sticky-buy-btn');
  const mobileStickyCartBtn = document.getElementById('mobile-sticky-cart-btn');
  const mobileStickySize = document.getElementById('mobile-sticky-size');
  const mobileStickyPrice = document.getElementById('mobile-sticky-price');

  mobileStickyBuyBtn?.addEventListener('click', () => {
    buyBtn?.click();
  });

  mobileStickyCartBtn?.addEventListener('click', () => {
    addCartBtn?.click();
  });

  // Micro-chequeo de stock en vivo contra la API del ERP
  async function verifyVariantStockInLive(variantId: string, buttonEl: HTMLButtonElement) {
    if (!variantId || isNaN(Number(variantId))) return;
    try {
      const res = await fetch(`http://localhost:8000/api/public/stock-check/${variantId}`);
      if (res.ok) {
        const data = await res.json();
        if (!data.available || data.stock <= 0) {
          buttonEl.disabled = true;
          buttonEl.classList.remove('bg-text-main', 'text-white', 'border-text-main');
          buttonEl.classList.add('border-[#F3F4F6]', 'text-text-light', 'line-through', 'cursor-not-allowed', 'opacity-40');
          if (sizeInfo) {
            sizeInfo.textContent = `🟡 Talla ${selectedSize} reservada en proceso de entrega`;
            sizeInfo.className = 'mt-2 text-[10px] text-amber-600 font-black uppercase tracking-wider';
          }
          selectedSize = '';
          selectedRef = '';
          selectedVariantId = '';
          updateCheckoutButton();
        }
      }
    } catch (_) {
      // Si el backend no responde, mantiene el stock SSG estático sin bloquear la UI
    }
  }

  // Handle pack selections
  packOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      // Remove selection classes
      packOptions.forEach(o => {
        o.classList.remove('border-white', 'bg-white/5');
        o.classList.add('border-[#262626]', 'bg-[#0B0B0C]');
        const check = document.getElementById(`pack-check-${o.getAttribute('data-pack-id')}`);
        if (check) check.classList.add('hidden');
      });

      // Add selection classes
      opt.classList.remove('border-[#262626]', 'bg-[#0B0B0C]');
      opt.classList.add('border-white', 'bg-white/5');
      const packId = opt.getAttribute('data-pack-id') || '1';
      const check = document.getElementById(`pack-check-${packId}`);
      if (check) check.classList.remove('hidden');

      selectedPack = packId;
      selectedPackName = opt.getAttribute('data-pack-name') || '';
      selectedPackPrice = parseFloat(opt.getAttribute('data-pack-price') || '90000');
      selectedPackDesc = opt.getAttribute('data-pack-desc') || '';

      // Update display prices
      const displayPrice = document.getElementById('display-price');
      const displayAnchorPrice = document.getElementById('display-anchor-price');
      const displaySavingBadge = document.getElementById('display-saving-badge');
      
      const formattedPrice = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(selectedPackPrice);
      const anchorVal = parseFloat(opt.getAttribute('data-pack-anchor') || '120000');
      const formattedAnchor = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(anchorVal);
      const discountPct = Math.round(((anchorVal - selectedPackPrice) / anchorVal) * 100);

      if (displayPrice) displayPrice.textContent = `$${formattedPrice}`;
      if (displayAnchorPrice) displayAnchorPrice.textContent = `$${formattedAnchor}`;
      if (displaySavingBadge) displaySavingBadge.textContent = `AHORRAS ${discountPct}%`;
      if (mobileStickyPrice) mobileStickyPrice.textContent = `$${formattedPrice} COP`;

      // Update WhatsApp checkout button text
      updateCheckoutButton();
    });
  });

  // Handle size selections
  sizeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const buttonEl = btn as HTMLButtonElement;
      if (buttonEl.getAttribute('data-available') !== 'true' || buttonEl.disabled) return;
      
      // Deselect all
      sizeButtons.forEach(b => {
        b.classList.remove('bg-text-main', 'text-white', 'border-text-main');
        b.classList.add('border-[#E5E7EB]');
      });
      
      // Select this one
      buttonEl.classList.remove('border-[#E5E7EB]');
      buttonEl.classList.add('bg-text-main', 'text-white', 'border-text-main');
      
      selectedSize = buttonEl.getAttribute('data-talla') || '';
      selectedRef = buttonEl.getAttribute('data-ref') || '';
      selectedVariantId = buttonEl.getAttribute('data-variant-id') || '';
      const stock = buttonEl.getAttribute('data-stock') || '0';
      
      if (sizeInfo) {
        sizeInfo.textContent = `Talla ${selectedSize} seleccionada — ${stock} unidades disponibles`;
        sizeInfo.className = 'mt-2 text-[10px] text-text-main font-black uppercase tracking-wider';
      }
      if (mobileStickySize) {
        mobileStickySize.textContent = `Talla: ${selectedSize}`;
      }

      // Clear any validation highlight
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.remove('ring-2', 'ring-red-600/50');
      }
      
      updateCheckoutButton();

      // Micro-chequeo en vivo
      if (selectedVariantId) {
        verifyVariantStockInLive(selectedVariantId, buttonEl);
      }
    });
  });

  function updateCheckoutButton() {
    if (!buyBtnText) return;
    
    const isAgotado = buyBtn ? buyBtn.getAttribute('data-status') === 'agotado' : false;
    if (isAgotado) {
      buyBtnText.textContent = 'Encargar para Próximo Pedido';
      return;
    }
    
    const hasVariants = buyBtn ? buyBtn.getAttribute('data-has-variants') === 'true' : false;
    let text = '🟢 Pedir por WhatsApp (Pago Contraentrega en Pasto)';
    
    if (hasVariants) {
      if (selectedPack === '1') {
        text = selectedSize ? `🟢 Pedir Talla ${selectedSize} por WhatsApp` : 'Selecciona una talla para pedir';
      } else if (selectedPack === '2') {
        text = '🟢 Pedir Duo Estilo (2 Chaquetas) por WhatsApp';
      } else if (selectedPack === '3') {
        text = '🟢 Pedir Combo Familiar (3 Chaquetas) por WhatsApp';
      }
    }

    buyBtnText.textContent = text;
  }

  buyBtn?.addEventListener('click', () => {
    const isAgotado = buyBtn.getAttribute('data-status') === 'agotado';
    if (isAgotado) {
      const name = buyBtn.getAttribute('data-product-name') || '';
      const brand = buyBtn.getAttribute('data-product-brand') || '';
      const id = buyBtn.getAttribute('data-product-id') || '';
      const phone = buyBtn.getAttribute('data-phone') || '';
      
      const message = 
        `*PRE-ENCARGO DE PRODUCTO SIN STOCK*\n\n` +
        `🧥 *Producto:* ${name} (${brand})` +
        `\n⚠️ *Estado:* Agotado (Deseo encargarlo para el próximo pedido de fábrica)\n` +
        `🆔 *Código Base:* ${id}\n\n` +
        `📍 _Hola, me gustaría encargar este modelo/color para el próximo pedido de fábrica. Por favor, anótenme y avísenme apenas esté disponible de nuevo. Mi nombre es:_`;
        
      const encodedMessage = encodeURIComponent(message);
      const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;
      
      // Meta Pixel Event
      if (typeof window !== 'undefined' && (window as any).fbq) {
        (window as any).fbq('track', 'Contact', {
          content_category: 'PreOrder',
          content_name: name,
          content_ids: [id]
        });
      }
      
      window.open(whatsAppUrl, '_blank');
      return;
    }

    const hasVariants = buyBtn.getAttribute('data-has-variants') === 'true';
    
    if (hasVariants && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = 'Selecciona tu talla antes de pedir';
        sizeInfo.classList.add('text-red-600', 'font-black');
      }
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.add('ring-2', 'ring-red-600/50', 'animate-shake');
        sizeOptions.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          sizeOptions.classList.remove('animate-shake');
        }, 500);
      }
      return;
    }

    const name = buyBtn.getAttribute('data-product-name') || '';
    const brand = buyBtn.getAttribute('data-product-brand') || '';
    const id = buyBtn.getAttribute('data-product-id') || '';
    const phone = buyBtn.getAttribute('data-phone') || '';

    const formattedPrice = new Intl.NumberFormat('es-CO', {
      style: 'decimal',
      minimumFractionDigits: 0,
    }).format(selectedPackPrice);

    let orderDetailText = `📦 *Pedido:* ${selectedPackName} (${selectedPackDesc})`;
    let sizeText = '';

    if (selectedPack === '1') {
      sizeText = `\n👕 *Talla:* ${selectedSize}`;
      if (selectedRef) sizeText += ` (Ref: ${selectedRef})`;
    } else {
      sizeText = `\n👕 *Talla Solicitada de Referencia:* ${selectedSize}\n📝 _(Coordinaré las tallas de las otras chaquetas del combo contigo en este chat)_`;
    }

    const message = 
      `*SOLICITUD DE PEDIDO CONTRAENTREGA*\n\n` +
      `🧥 *Producto:* ${name} (${brand})` +
      `\n${orderDetailText}` +
      sizeText +
      `\n🆔 *Código Base:* ${id}\n` +
      `💰 *Valor Total:* $${formattedPrice} COP\n\n` +
      `📍 _Por favor, indícame tu nombre, ciudad (Pasto o envío nacional) y dirección para coordinar el envío hoy mismo._`;

    const encodedMessage = encodeURIComponent(message);
    const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;

    // Meta Pixel event
    if (typeof window !== 'undefined' && (window as any).fbq) {
      (window as any).fbq('track', 'InitiateCheckout', {
        content_ids: [id],
        content_type: 'product',
        content_name: name,
        value: selectedPackPrice,
        currency: 'COP'
      }, { eventID: `evt-${id}-${Date.now()}` });
    }

    setTimeout(() => {
      window.open(whatsAppUrl, '_blank');
    }, 300);
  });

  // Listener para agregar al carrito
  addCartBtn?.addEventListener('click', () => {
    const isAgotado = addCartBtn.getAttribute('data-status') === 'agotado';
    if (isAgotado) return;

    const hasVariants = addCartBtn.getAttribute('data-has-variants') === 'true';
    if (hasVariants && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = 'Selecciona tu talla antes de agregar al carrito';
        sizeInfo.className = 'mt-2 text-[10px] text-red-600 font-black uppercase tracking-wider';
      }
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.add('ring-2', 'ring-red-600/50', 'animate-shake');
        sizeOptions.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          sizeOptions.classList.remove('animate-shake');
        }, 500);
      }
      return;
    }

    const name = addCartBtn.getAttribute('data-product-name') || '';
    const brand = addCartBtn.getAttribute('data-product-brand') || '';
    const id = addCartBtn.getAttribute('data-product-id') || '';
    const category = addCartBtn.getAttribute('data-product-category') || '';
    const image = addCartBtn.getAttribute('data-product-image') || '';
    const price = selectedPackPrice || parseFloat(addCartBtn.getAttribute('data-product-price') || '0');

    const itemId = selectedRef || (selectedVariantId ? `${id}-${selectedVariantId}` : (selectedSize ? `${id}-${selectedSize}` : id));

    addToCart({
      id: itemId,
      productId: id,
      variantId: selectedVariantId || undefined,
      name,
      brand,
      category,
      price,
      image,
      size: selectedSize || undefined,
      color: name.replace('Chaqueta Impermeable ', '').trim(),
      quantity: 1,
    });
  });
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }
  .animate-shake {
    animation: shake 0.4s ease-in-out;
  }
</style>
