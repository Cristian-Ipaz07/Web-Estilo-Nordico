<script>
  import { addToCart } from '../lib/cart';

  const mainImage = document.getElementById('main-product-image') as HTMLImageElement | null;
  const thumbnailBtns = document.querySelectorAll('.thumbnail-btn');
  const sizeBtns = document.querySelectorAll('.size-btn');
  const modelBtns = document.querySelectorAll('.model-btn');
  const sizeInfo = document.getElementById('size-selection-info');
  const buyBtn = document.getElementById('product-buy-whatsapp-btn');
  const addCartBtn = document.getElementById('product-add-cart-btn');
  const mobileBuyBtn = document.getElementById('mobile-sticky-buy-btn');
  const mobileCartBtn = document.getElementById('mobile-sticky-cart-btn');
  const mobileStickySize = document.getElementById('mobile-sticky-size');
  const mobileStickyPrice = document.getElementById('mobile-sticky-price');
  const packOptions = document.querySelectorAll('.pack-option');
  const displayPrice = document.getElementById('display-price');
  const displayAnchor = document.getElementById('display-anchor-price');
  const selectedModelText = document.getElementById('selected-model-text');

  let selectedSize = '';
  let selectedRef = '';
  let selectedVariantId = '';
  let selectedModelName = '';
  let selectedPack = '1';
  let selectedPackPrice = parseFloat(buyBtn?.getAttribute('data-product-price') || '0');
  let selectedPackName = 'Pack 1 Individual';
  let selectedPackDesc = buyBtn?.getAttribute('data-unit-name') || 'Prenda';

  // Sincronización visual de miniatura activa
  function setActiveThumbnail(imgUrl: string, index?: number) {
    thumbnailBtns.forEach((tBtn, idx) => {
      const tImg = tBtn.getAttribute('data-img');
      const isMatch = (tImg && imgUrl && tImg === imgUrl) || (index !== undefined && idx === index);
      const indicator = tBtn.querySelector('.thumb-active-indicator');
      if (isMatch) {
        tBtn.classList.remove('border-[#E5E7EB]', 'hover:border-black');
        tBtn.classList.add('border-[#0B0B0C]', 'ring-2', 'ring-[#0B0B0C]', 'shadow-sm', 'is-active');
        indicator?.classList.remove('opacity-0');
        indicator?.classList.add('opacity-100');
      } else {
        tBtn.classList.remove('border-[#0B0B0C]', 'ring-2', 'ring-[#0B0B0C]', 'shadow-sm', 'is-active');
        tBtn.classList.add('border-[#E5E7EB]', 'hover:border-black');
        indicator?.classList.remove('opacity-100');
        indicator?.classList.add('opacity-0');
      }
    });
  }

  // Activar un modelo/diseño y mantener sincronía total bidireccional
  function activateModel(btn: HTMLElement, syncThumb = true) {
    modelBtns.forEach(b => {
      b.classList.remove('border-[#C9A962]', 'bg-[#0B0B0C]', 'text-white', 'is-active', 'ring-2', 'ring-[#C9A962]/40');
      b.classList.add('border-[#E5E7EB]', 'bg-white', 'text-text-main');
    });

    btn.classList.remove('border-[#E5E7EB]', 'bg-white', 'text-text-main');
    btn.classList.add('border-[#C9A962]', 'bg-[#0B0B0C]', 'text-white', 'is-active', 'ring-2', 'ring-[#C9A962]/40');

    const vImg = btn.getAttribute('data-image');
    const vColor = btn.getAttribute('data-color') || '';
    const vBrand = btn.getAttribute('data-brand') || '';
    const modelIndex = parseInt(btn.getAttribute('data-index') || '-1', 10);
    selectedVariantId = btn.getAttribute('data-variant-id') || '';
    selectedRef = btn.getAttribute('data-ref') || '';
    selectedModelName = vBrand && vBrand !== 'Estilo Nórdico' ? `${vBrand} - ${vColor}` : vColor;

    if (vImg && mainImage) {
      mainImage.src = vImg;
    }

    if (selectedModelText) {
      selectedModelText.innerHTML = `Modelo seleccionado: <span class="font-bold text-text-main">${selectedModelName}</span>`;
    }

    if (mobileStickySize) {
      mobileStickySize.textContent = `Mod: ${selectedModelName}`;
    }

    if (syncThumb && vImg) {
      setActiveThumbnail(vImg, modelIndex >= 0 ? modelIndex : undefined);
    }
  }

  // Click en selector de modelos (derecha)
  modelBtns.forEach((btn, idx) => {
    btn.setAttribute('data-index', String(idx));
    btn.addEventListener('click', () => {
      activateModel(btn as HTMLElement, true);
    });
  });

  // Click en miniaturas de galería (abajo): selecciona el modelo y la imagen
  thumbnailBtns.forEach((tBtn, idx) => {
    tBtn.addEventListener('click', () => {
      const imgUrl = tBtn.getAttribute('data-img') || '';

      if (imgUrl && mainImage) {
        mainImage.src = imgUrl;
      }
      setActiveThumbnail(imgUrl, idx);

      // Si el producto tiene modelos/diseños, sincronizarlo de inmediato
      if (modelBtns.length > 0) {
        let targetModel = Array.from(modelBtns).find(m => {
          const mImg = m.getAttribute('data-image');
          return mImg && imgUrl && mImg === imgUrl;
        });

        if (!targetModel && modelBtns[idx]) {
          targetModel = modelBtns[idx];
        }

        if (targetModel) {
          activateModel(targetModel as HTMLElement, false);
        }
      }
    });
  });

  // Inicializar estado del primer modelo si existe
  if (modelBtns.length > 0) {
    activateModel(modelBtns[0] as HTMLElement, true);
  } else if (thumbnailBtns.length > 0) {
    const firstImg = thumbnailBtns[0].getAttribute('data-img') || '';
    setActiveThumbnail(firstImg, 0);
  }

  // Auto-seleccionar talla si es pieza única (1 sola talla disponible)
  if (sizeBtns.length === 1) {
    const singleBtn = sizeBtns[0] as HTMLElement;
    singleBtn.classList.add('is-selected');
    selectedSize = singleBtn.getAttribute('data-talla') || '';
    selectedRef = singleBtn.getAttribute('data-ref') || '';
    selectedVariantId = singleBtn.getAttribute('data-variant-id') || '';
    const stock = parseInt(singleBtn.getAttribute('data-stock') || '0', 10);
    if (sizeInfo) {
      sizeInfo.textContent = `Talla única disponible: ${selectedSize} (${stock} disponible)`;
      sizeInfo.className = 'mt-2 text-[10px] text-emerald-600 font-black uppercase tracking-wider';
    }
    if (mobileStickySize) {
      mobileStickySize.textContent = `Talla: ${selectedSize}`;
    }
  }

  // Selector de tallas (solo cuando aplique)
  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach(b => b.classList.remove('is-selected'));
      btn.classList.add('is-selected');

      selectedSize = btn.getAttribute('data-talla') || '';
      selectedRef = btn.getAttribute('data-ref') || '';
      selectedVariantId = btn.getAttribute('data-variant-id') || '';
      const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);

      if (sizeInfo) {
        sizeInfo.textContent = `Talla seleccionada: ${selectedSize} (${stock} disponible${stock !== 1 ? 's' : ''})`;
        sizeInfo.className = 'mt-2 text-[10px] text-emerald-600 font-black uppercase tracking-wider';
      }

      if (mobileStickySize) {
        mobileStickySize.textContent = `Talla: ${selectedSize}`;
      }
    });
  });

  // Selector de paquetes (Packs 1, 2 y 3)
  packOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      packOptions.forEach(b => {
        b.classList.remove('border-text-main', 'bg-neutral-50');
        b.classList.add('border-[#E5E7EB]', 'bg-white');
      });
      btn.classList.remove('border-[#E5E7EB]', 'bg-white');
      btn.classList.add('border-text-main', 'bg-neutral-50');

      document.querySelectorAll('[id^="pack-check-"]').forEach(c => c.classList.add('hidden'));
      const packId = btn.getAttribute('data-pack-id');
      const checkEl = document.getElementById(`pack-check-${packId}`);
      if (checkEl) checkEl.classList.remove('hidden');

      selectedPack = packId || '1';
      selectedPackPrice = parseFloat(btn.getAttribute('data-pack-price') || '0');
      selectedPackName = btn.getAttribute('data-pack-name') || '';
      selectedPackDesc = btn.getAttribute('data-pack-desc') || '';

      const formatted = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(selectedPackPrice);
      if (displayPrice) displayPrice.textContent = `$${formatted} COP`;
      if (mobileStickyPrice) mobileStickyPrice.textContent = `$${formatted} COP`;
    });
  });

  // Envío de Pedido a WhatsApp
  function handleWhatsAppOrder() {
    const isAgotado = buyBtn?.getAttribute('data-status') === 'agotado';
    if (isAgotado) {
      const name = buyBtn?.getAttribute('data-product-name') || '';
      const id = buyBtn?.getAttribute('data-product-id') || '';
      const phone = buyBtn?.getAttribute('data-phone') || '';
      const msg = `*CONSULTA DE PRODUCTO SIN STOCK*\n\n🛍️ *Producto:* ${name}\n🆔 *Código:* ${id}\n\n📍 _Hola Estilo Nórdico, me interesa encargar este producto para el próximo pedido. Mi nombre es:_`;
      window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(msg)}`, '_blank');
      return;
    }

    const hasSizes = buyBtn?.getAttribute('data-has-sizes') === 'true';
    if (hasSizes && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = 'Selecciona tu talla antes de pedir';
        sizeInfo.classList.add('text-red-600', 'font-black');
      }
      const sizeOptions = document.getElementById('size-options');
      if (sizeOptions) {
        sizeOptions.classList.add('ring-2', 'ring-red-600/50', 'animate-shake');
        sizeOptions.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => sizeOptions.classList.remove('animate-shake'), 500);
      }
      return;
    }

    const name = buyBtn?.getAttribute('data-product-name') || '';
    const brand = buyBtn?.getAttribute('data-product-brand') || '';
    const id = buyBtn?.getAttribute('data-product-id') || '';
    const phone = buyBtn?.getAttribute('data-phone') || '';
    const isJacket = buyBtn?.getAttribute('data-is-jacket') === 'true';

    const formattedPrice = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(selectedPackPrice);

    let detailText = `📦 *Pedido:* ${selectedPackName} (${selectedPackDesc})`;
    let specText = '';
    if (selectedModelName) {
      specText += `\n🎨 *Diseño / Modelo:* ${selectedModelName}`;
    }
    if (selectedSize) {
      specText += `\n👕 *Talla:* ${selectedSize}`;
    }
    if (selectedRef) {
      specText += ` (Ref: ${selectedRef})`;
    }

    let benefitText = '';
    if (isJacket) {
      benefitText = '🚚 *Beneficio:* ¡DOMICILIO GRATIS EN PASTO! (Pagas al recibir en casa)\n';
    } else if (selectedPack === '2' || selectedPack === '3') {
      benefitText = '🚚 *Beneficio Promo:* ¡DOMICILIO GRATIS EN PASTO POR LLEVAR 2 O MÁS! 🎁\n';
    } else {
      benefitText = '🛵 *Entrega:* Pago contraentrega en Pasto (o envío nacional)\n';
    }

    const message = 
      `*SOLICITUD DE PEDIDO CONTRAENTREGA* 🛵\n\n` +
      `🛍️ *Producto:* ${name} (${brand})\n` +
      detailText +
      specText +
      `\n🆔 *Código:* ${id}\n` +
      `💰 *Valor Total:* $${formattedPrice} COP\n` +
      benefitText +
      `\n📍 _Por favor, indícame tu nombre, ciudad (Pasto o envío nacional) y dirección para coordinar el despacho hoy mismo._`;

    window.open(`https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(message)}`, '_blank');
  }

  buyBtn?.addEventListener('click', handleWhatsAppOrder);
  mobileBuyBtn?.addEventListener('click', handleWhatsAppOrder);

  // Agregar al Carrito
  function handleAddToCart() {
    const isAgotado = addCartBtn?.getAttribute('data-status') === 'agotado';
    if (isAgotado) return;

    const hasSizes = addCartBtn?.getAttribute('data-has-sizes') === 'true';
    if (hasSizes && !selectedSize) {
      if (sizeInfo) {
        sizeInfo.textContent = 'Selecciona tu talla antes de agregar al carrito';
        sizeInfo.className = 'mt-2 text-[10px] text-red-600 font-black uppercase tracking-wider';
      }
      return;
    }

    const name = addCartBtn?.getAttribute('data-product-name') || '';
    const brand = addCartBtn?.getAttribute('data-product-brand') || '';
    const id = addCartBtn?.getAttribute('data-product-id') || '';
    const category = addCartBtn?.getAttribute('data-product-category') || '';
    const image = mainImage?.src || addCartBtn?.getAttribute('data-product-image') || '';
    const price = selectedPackPrice || parseFloat(addCartBtn?.getAttribute('data-product-price') || '0');

    const itemId = selectedRef || (selectedVariantId ? `${id}-${selectedVariantId}` : (selectedSize ? `${id}-${selectedSize}` : id));

    addToCart({
      id: itemId,
      productId: id,
      variantId: selectedVariantId || undefined,
      name: selectedModelName ? `${name} (${selectedModelName})` : name,
      brand,
      category,
      price,
      image,
      size: selectedSize || undefined,
      color: selectedModelName || undefined,
      quantity: 1,
    });
  }

  addCartBtn?.addEventListener('click', handleAddToCart);
  mobileCartBtn?.addEventListener('click', handleAddToCart);
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }
  .animate-shake {
    animation: shake 0.4s ease-in-out;
  }

  :global(.size-btn.is-selected) {
    background-color: #0B0B0C !important;
    border-color: #C9A962 !important;
    border-style: solid !important;
    box-shadow: 0 0 0 2px rgba(201, 169, 98, 0.4), 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
    transform: scale(1.04);
  }
  :global(.size-btn.is-selected .size-letter) {
    color: #FFFFFF !important;
  }
  :global(.size-btn.is-selected .size-badge) {
    background-color: rgba(201, 169, 98, 0.25) !important;
    color: #C9A962 !important;
    border-color: #C9A962 !important;
  }

  @keyframes wppGlow {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6), 0 4px 12px rgba(0, 0, 0, 0.15);
      transform: translateY(0);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(37, 211, 102, 0), 0 6px 18px rgba(37, 211, 102, 0.35);
      transform: translateY(-2px);
    }
  }
  .animate-wpp-btn {
    animation: wppGlow 2.5s infinite ease-in-out;
  }

  @keyframes goldHeartbeat {
    0%, 100% {
      border-color: #C9A962;
      box-shadow: 0 0 0 0 rgba(201, 169, 98, 0.4);
    }
    50% {
      border-color: #ecd79b;
      box-shadow: 0 0 12px 2px rgba(201, 169, 98, 0.35);
    }
  }
  .promo-highlight {
    animation: goldHeartbeat 2.8s infinite ease-in-out;
  }
</style>
