---
/**
 * Hero.astro — Sección hero de la página principal
 * Destaca el producto gancho (chaqueta impermeable) con CTA directo a WhatsApp
 */
import { formatPrice, getDiscount } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary via-primary-light to-[#3B5998] text-white" id="hero">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-72 h-72 bg-white rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      
      <!-- Content -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm rounded-full px-4 py-2 mb-6 fade-in">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          <span class="text-sm font-semibold tracking-wide">🔥 Producto más vendido en Pasto</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black leading-tight mb-4 fade-in fade-in-delay-1">
          {product.name}
        </h1>

        <p class="text-base sm:text-lg text-white/80 mb-6 max-w-lg mx-auto lg:mx-0 fade-in fade-in-delay-2">
          {product.description}
        </p>

        <!-- Price -->
        <div class="flex items-center gap-4 justify-center lg:justify-start mb-8 fade-in fade-in-delay-3">
          <div class="flex flex-col">
            <span class="text-3xl sm:text-4xl font-black">${formatPrice(product.price)}</span>
            <span class="text-sm text-white/50">COP</span>
          </div>
          <div class="flex flex-col items-start">
            <span class="text-lg text-white/40 line-through">${formatPrice(product.anchorPrice)}</span>
            <span class="bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full badge-discount">-{discount}% OFF</span>
          </div>
        </div>

        <!-- Badges -->
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-8 fade-in fade-in-delay-3">
          <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold">
            🚚 Envío gratis en Pasto
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold">
            💰 Pago contraentrega
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold">
            ⚡ Entrega hoy mismo
          </span>
        </div>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start fade-in fade-in-delay-4">
          <a
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(`*SOLICITUD DE PEDIDO CONTRAENTREGA (PASTO)*\n\n📦 *Producto:* ${product.name} (${product.brand})\n🆔 *Código:* ${product.id}\n💰 *Precio Especial:* $${formatPrice(product.price)} COP\n\n📍 _Por favor, indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._`)}`}
            target="_blank"
            rel="noopener noreferrer"
            id="hero-cta-whatsapp"
            class="inline-flex items-center justify-center gap-2.5 btn-whatsapp px-8 py-4 rounded-2xl text-base sm:text-lg shadow-xl"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pedir ahora por WhatsApp
          </a>
          <a 
            href="/chaquetas"
            class="inline-flex items-center justify-center gap-2 bg-white/15 hover:bg-white/25 backdrop-blur-sm px-6 py-4 rounded-2xl text-sm font-semibold transition-all duration-200 border border-white/20"
          >
            Ver todas las chaquetas →
          </a>
        </div>
      </div>

      <!-- Product Image -->
      <div class="order-1 lg:order-2 flex justify-center fade-in">
        <div class="relative">
          <div class="absolute inset-0 bg-white/10 rounded-3xl blur-2xl scale-90"></div>
          <img 
            src={product.image} 
            alt={product.name}
            class="relative w-64 sm:w-80 lg:w-96 rounded-3xl shadow-2xl animate-float"
            loading="eager"
          />
          <!-- Price tag overlay -->
          <div class="absolute -bottom-3 -right-3 sm:bottom-0 sm:right-0 bg-white text-primary rounded-2xl px-4 py-2 shadow-xl">
            <span class="text-xs text-text-muted font-medium">Desde</span>
            <p class="text-xl font-black">${formatPrice(product.price)}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
