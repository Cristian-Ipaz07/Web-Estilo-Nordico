---
/**
 * Hero.astro — Sección hero de la página principal (Estilo Dark Mode Streetwear)
 * Imagen de estilo de vida de modelos a pantalla completa (100vh / 16:9 ratio) con degradado inferior
 */
import { formatPrice } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<section class="relative w-full h-[80vh] sm:h-[90vh] lg:h-[95vh] min-h-[600px] flex items-end overflow-hidden bg-black" id="hero">
  
  <!-- Full Screen Lifestyle Image Background -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/assets/baner.png" 
      alt="Estilo Nórdico Colección" 
      class="w-full h-full object-cover object-center scale-100 group-hover:scale-105 transition-transform duration-1000 brightness-[0.8]"
      loading="eager"
    />
    <!-- Dark bottom gradient overlay that fades to white at the very bottom edge -->
    <div class="absolute inset-0 bg-gradient-to-t from-white via-[#0B0B0C]/85 to-[#0B0B0C]/30 z-10"></div>
  </div>

  <!-- Content Container (overlaid at the bottom left) -->
  <div class="relative z-20 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24 lg:pb-28">
    <div class="max-w-2xl text-left">
      
      <!-- Minimalist Tagline -->
      <span class="inline-block border border-white/20 bg-white/5 backdrop-blur-md text-white text-[9px] font-black px-3.5 py-1.5 rounded-md uppercase tracking-widest mb-4">
        COLECCIÓN OFICIAL — PASTO, COLOMBIA
      </span>

      <!-- Title / Brand name -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-title font-black text-white leading-none tracking-wider uppercase mb-4">
        Estilo Nórdico
      </h1>

      <!-- Slogan (from docx identity) -->
      <p class="text-xs sm:text-sm lg:text-base text-zinc-300 mb-8 font-light leading-relaxed max-w-lg">
        Nacimos en Pasto, inspirados por quienes avanzan, sueñan y crean su propia actitud. Ropa urbana y elegante con identidad.
      </p>

      <!-- CTAs (Monochrome Streetwear Style over Dark Area) -->
      <div class="flex flex-col sm:flex-row gap-3.5">
        <a
          href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(`*SOLICITUD DE ASESORÍA / COMPRA DE ROPA*\n\nHola, vengo de la web de Estilo Nórdico y me gustaría recibir asesoría sobre la colección de ropa.\n\n📍 _¿Qué prendas o tallas están disponibles en Pasto?_`)}`}
          target="_blank"
          rel="noopener noreferrer"
          id="hero-cta-whatsapp"
          class="inline-flex items-center justify-center gap-2 bg-[#0B0B0C] hover:bg-neutral-800 text-white font-black text-[10px] sm:text-xs uppercase tracking-widest px-8 py-4.5 rounded-md transition-all duration-300 shadow-md cursor-pointer border border-white/10"
        >
          Pedir por WhatsApp (Pago Contraentrega)
        </a>
        <a 
          href="/chaquetas"
          class="inline-flex items-center justify-center gap-2 border border-[#0B0B0C]/20 hover:border-black bg-transparent text-[#0B0B0C] font-black text-[10px] sm:text-xs uppercase tracking-widest px-6 py-4.5 rounded-md transition-all duration-300 cursor-pointer"
        >
          Ver Catálogo Completo
        </a>
      </div>

    </div>
  </div>
</section>
