---
/**
 * Hero.astro — Sección hero de la página principal
 * Destaca el producto gancho (chaqueta impermeable) con diseño editorial premium de alta costura
 */
import { formatPrice, getDiscount } from '../data/products';
import { STORE_CONFIG } from '../config/store';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const discount = getDiscount(product.price, product.anchorPrice);
---

<section class="relative overflow-hidden bg-mesh-premium bg-grain text-white py-16 sm:py-24 lg:py-32" id="hero">
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Content (7 columns on desktop) -->
      <div class="lg:col-span-7 text-center lg:text-left order-2 lg:order-1 relative z-10">
        
        <!-- Premium Tag Badge -->
        <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 backdrop-blur-md rounded-full px-4 py-2 mb-6 fade-in text-[10px] sm:text-xs uppercase tracking-widest font-black text-gold">
          <span class="w-1.5 h-1.5 bg-gold rounded-full animate-ping"></span>
          <span>🔥 Colección Otoño-Invierno | Pasto</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-title font-black leading-[1.05] mb-5 tracking-tight fade-in fade-in-delay-1 text-white">
          {product.name}
        </h1>

        <!-- Description -->
        <p class="text-sm sm:text-base text-white/70 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed font-light fade-in fade-in-delay-2">
          {product.description} Confección nacional premium con forro interior abrigado y gorro extraíble. Ideal para el clima frío de Pasto.
        </p>

        <!-- Dynamic trust pills -->
        <div class="flex flex-wrap gap-2.5 justify-center lg:justify-start mb-8 fade-in fade-in-delay-3">
          <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/5 backdrop-blur-md rounded-xl px-3.5 py-2 text-xs text-white/90">
            🏠 Paga al Recibir en Pasto
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/5 backdrop-blur-md rounded-xl px-3.5 py-2 text-xs text-white/90">
            ⚡ Entrega inmediata hoy mismo
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/5 backdrop-blur-md rounded-xl px-3.5 py-2 text-xs text-white/90">
            📦 Cambios fáciles y rápidos
          </span>
        </div>

        <!-- Premium CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start fade-in fade-in-delay-4">
          <a
            href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(`*SOLICITUD DE PEDIDO CONTRAENTREGA (PASTO)*\n\n📦 *Producto:* ${product.name} (${product.brand})\n🆔 *Código:* ${product.id}\n💰 *Precio Especial:* $${formatPrice(product.price)} COP\n\n📍 _Por favor, indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._`)}`}
            target="_blank"
            rel="noopener noreferrer"
            id="hero-cta-whatsapp"
            class="inline-flex items-center justify-center gap-3 bg-accent hover:bg-accent-hover hover:scale-[1.02] text-white font-black text-xs sm:text-sm uppercase tracking-widest px-8 py-4.5 rounded-2xl transition-all duration-300 shadow-[0_12px_24px_-8px_rgba(37,211,102,0.4)] cursor-pointer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pedir Contraentrega
          </a>
          <a 
            href="/chaquetas"
            class="inline-flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 backdrop-blur-sm px-6 py-4.5 rounded-2xl text-[10px] sm:text-xs font-black uppercase tracking-widest transition-all duration-300 border border-white/10 hover:border-white/20 text-white"
          >
            Ver Catálogo →
          </a>
        </div>
      </div>

      <!-- Floating Product Image Card (5 columns on desktop) -->
      <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center fade-in z-10">
        <div class="relative group">
          <!-- Ambient glowing background aura -->
          <div class="absolute inset-0 bg-primary-light/30 rounded-3xl blur-3xl opacity-60 group-hover:opacity-80 transition-all duration-700 scale-90"></div>
          
          <!-- Glassmorphic Card Container -->
          <div class="relative bg-white/5 border border-white/15 backdrop-blur-xl rounded-[2.5rem] p-5 sm:p-6 shadow-[0_30px_60px_rgba(0,0,0,0.5)] transition-all duration-700 group-hover:scale-[1.02] group-hover:border-white/25">
            <img 
              src={product.image} 
              alt={product.name}
              class="w-56 sm:w-64 lg:w-72 rounded-[2rem] shadow-2xl object-cover hover:brightness-105 transition-all duration-500 animate-float"
              loading="eager"
            />
            
            <!-- Shaking Discount Badge -->
            <div class="absolute -top-3 -left-3 bg-red-500 text-white text-[10px] font-black px-3.5 py-1.5 rounded-2xl shadow-lg border border-red-400 rotate-[-8deg] badge-discount uppercase tracking-wider">
              -{discount}% Lanzamiento
            </div>

            <!-- Price tag overlay in glass -->
            <div class="absolute -bottom-3 -right-3 bg-primary-dark/80 border border-white/20 backdrop-blur-md text-white rounded-2xl px-5 py-3.5 shadow-2xl text-right">
              <span class="text-[8px] text-white/55 font-black tracking-widest uppercase block mb-0.5">Precio Especial</span>
              <p class="text-xl font-black text-gold">${formatPrice(product.price)}</p>
              <span class="text-[10px] text-white/40 line-through">${formatPrice(product.anchorPrice)} COP</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
