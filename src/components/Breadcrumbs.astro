---
/**
 * Breadcrumbs.astro — Migas de pan para navegación
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-1.5 text-sm text-text-muted flex-wrap">
    <li>
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        <span class="text-text-light">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
        ) : (
          <span class="text-text-main font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
