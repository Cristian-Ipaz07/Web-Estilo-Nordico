---
/**
 * Navbar.astro — Barra de navegación principal (Estilo Dark Mode Streetwear)
 */
import { STORE_CONFIG } from '../config/store';

const navItems = STORE_CONFIG.navigation;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[#0B0B0C] border-b border-[#262626]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Logo and Drakkar Ship Symbol -->
      <a href="/" class="flex items-center gap-3 group" id="nav-logo">
        <div class="w-9 h-9 sm:w-10 sm:h-10 overflow-hidden relative transition-transform duration-300 group-hover:scale-105">
          <img 
            src="/assets/logo-nordico.png" 
            alt="Estilo Nórdico" 
            class="absolute top-0 left-0 w-full h-[145%] object-cover object-top" 
          />
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-sm sm:text-base font-black text-white uppercase tracking-widest font-title">Estilo Nórdico</span>
          <span class="text-[8px] text-[#A3A3A3] font-black tracking-widest uppercase mt-1 hidden sm:block">Pasto, Colombia</span>
        </div>
      </a>

      <!-- Desktop Navigation (Represent Clo style) -->
      <div class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            id={`nav-${item.label.toLowerCase()}`}
            class:list={[
              'text-xs font-black uppercase tracking-widest transition-all duration-300 py-1 border-b-2',
              currentPath === item.href
                ? 'border-white text-white'
                : 'border-transparent text-[#A3A3A3] hover:text-white'
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <!-- Cart Trigger Button -->
        <button
          id="nav-cart-btn"
          class="relative flex items-center justify-center p-2 sm:p-2.5 rounded-md border border-white/20 hover:border-white bg-white/5 hover:bg-white/10 text-white transition-all cursor-pointer"
          aria-label="Ver carrito"
        >
          <svg class="w-5 h-5 text-[#C9A962]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            id="nav-cart-badge"
            class="absolute -top-1.5 -right-1.5 bg-[#C9A962] text-black text-[9px] font-black w-4.5 h-4.5 rounded-full flex items-center justify-center scale-0 transition-transform duration-300 shadow-sm"
          >
            0
          </span>
        </button>

        <!-- Monochrome Header Button (streetwear look) -->
        <a
          href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          id="nav-whatsapp-cta"
          class="hidden md:flex items-center gap-2 border border-white/20 hover:border-white bg-white/5 hover:bg-white text-white hover:text-[#0B0B0C] px-5 py-2.5 rounded-md text-xs font-black uppercase tracking-widest transition-all duration-300 cursor-pointer"
        >
          Contáctanos
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-md hover:bg-white/5 border border-white/10 transition-colors"
          aria-label="Abrir menú"
        >
          <svg id="menu-icon-open" class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu (Monochrome) -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-2 pt-2 border-t border-[#262626]">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-4 py-3 text-xs font-black uppercase tracking-widest rounded-md transition-all duration-300',
              currentPath === item.href
                ? 'bg-white/10 text-white'
                : 'text-[#A3A3A3] hover:text-white'
            ]}
          >
            {item.label}
          </a>
        ))}
        <a
          href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center justify-center gap-2 border border-white/20 bg-white/5 text-white px-4 py-3 rounded-md text-xs font-black uppercase tracking-widest"
        >
          <span>Escríbenos por WhatsApp</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });

  // Carrito listeners en Navbar
  const navCartBtn = document.getElementById('nav-cart-btn');
  const navCartBadge = document.getElementById('nav-cart-badge');

  navCartBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  window.addEventListener('cart:updated', (e: any) => {
    const count = e.detail?.count ?? 0;
    if (!navCartBadge) return;
    navCartBadge.textContent = String(count);
    if (count > 0) {
      navCartBadge.classList.remove('scale-0');
      navCartBadge.classList.add('scale-100');
    } else {
      navCartBadge.classList.remove('scale-100');
      navCartBadge.classList.add('scale-0');
    }
  });

  try {
    const raw = localStorage.getItem('estilo_nordico_cart_v1');
    if (raw && navCartBadge) {
      const items = JSON.parse(raw);
      const count = items.reduce((s: number, i: any) => s + (i.quantity || 1), 0);
      if (count > 0) {
        navCartBadge.textContent = String(count);
        navCartBadge.classList.remove('scale-0');
        navCartBadge.classList.add('scale-100');
      }
    }
  } catch (_) {}
</script>
