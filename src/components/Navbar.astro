---
/**
 * Navbar.astro — Barra de navegación principal multirubro (Koaj / Mattelsa / Bershka Style)
 * Totalmente sincronizada con el ERP de Estilo Nórdico:
 * Los menús desplegables solo muestran categorías con productos PUBLICADOS y CON STOCK REAL (>0).
 * Cuando se agota una categoría en el ERP o se desactiva, desaparece automáticamente de la web.
 */
import { STORE_CONFIG } from '../config/store';
import CategoryChips from './CategoryChips.astro';
import { fetchNavigationFromERP } from '../lib/erpApi';

const currentPath = Astro.url.pathname;
const navData = await fetchNavigationFromERP();

// Diccionario de metadatos estéticos para subcategorías del ERP
const SUBCAT_META: Record<string, { label: string; href: string }> = {
  'CHAQUETA': { label: 'Chaquetas Impermeables', href: '/chaquetas' },
  'CAMISETA': { label: 'Camisetas Streetwear', href: '/chaquetas?tipo=camiseta' },
  'BUSO': { label: 'Busos & Sacos', href: '/chaquetas?tipo=buso' },
  'PANTALON': { label: 'Pantalones & Joggers', href: '/chaquetas?tipo=pantalon' },
  'JEANS': { label: 'Jeans & Denim', href: '/chaquetas?tipo=jeans' },
  'BERMUDA': { label: 'Bermudas Algodón', href: '/chaquetas?tipo=bermuda' },
  'BLUSAS': { label: 'Blusas & Tops', href: '/chaquetas?tipo=blusas' },
  'BODY': { label: 'Bodys', href: '/chaquetas?tipo=body' },
  'CONJUNTO': { label: 'Conjuntos', href: '/chaquetas?tipo=conjunto' },
  'SUDADERA': { label: 'Sudaderas', href: '/chaquetas?tipo=sudadera' },
  'LICRA': { label: 'Licras Deportivas', href: '/chaquetas?tipo=licra' },
};

function formatSubcategory(code: string, rawName: string) {
  const norm = code.toUpperCase().trim();
  if (SUBCAT_META[norm]) return SUBCAT_META[norm];
  return {
    label: rawName ? rawName.charAt(0).toUpperCase() + rawName.slice(1).toLowerCase() : norm,
    href: `/chaquetas?tipo=${norm.toLowerCase()}`
  };
}

const rawHombre = navData.departments['HOMBRE'] || [];
const rawMujer = navData.departments['MUJER'] || [];

const hombreItems = rawHombre.map(item => formatSubcategory(item.code, item.name));
const mujerItems = rawMujer.map(item => formatSubcategory(item.code, item.name));

interface NavMenuItem {
  label: string;
  href: string;
  badge: string | null;
  items: Array<{ label: string; href: string; badge?: string }>;
}

const navMenu: NavMenuItem[] = [];

// 1. Departamento Hombre (Sincronizado con inventario activo y publicado)
if (hombreItems.length > 0) {
  navMenu.push({
    label: 'Hombre',
    href: '/chaquetas',
    badge: null,
    items: [
      { label: 'Ver Todo Hombre', href: '/chaquetas' },
      ...hombreItems
    ]
  });
} else {
  navMenu.push({
    label: 'Hombre',
    href: '/chaquetas',
    badge: null,
    items: [
      { label: 'Ver Todo Hombre', href: '/chaquetas' },
      { label: 'Chaquetas Impermeables', href: '/chaquetas' }
    ]
  });
}

// 2. Departamento Mujer (Sincronizado: solo muestra lo publicado desde la app)
if (mujerItems.length > 0) {
  navMenu.push({
    label: 'Mujer',
    href: '/chaquetas?cat=mujer',
    badge: null,
    items: [
      { label: 'Ver Todo Mujer', href: '/chaquetas?cat=mujer' },
      ...mujerItems
    ]
  });
} else {
  // Cuando aún no se han publicado prendas de mujer desde la app, no se muestran opciones vacías
  navMenu.push({
    label: 'Mujer',
    href: '/#coleccion-mujer',
    badge: 'Pronto',
    items: [
      { label: 'Colección Mujer (Próximamente en Tienda)', href: '/#coleccion-mujer' }
    ]
  });
}

// 3. Perfumes & Accesorios
navMenu.push({
  label: 'Perfumes & Accesorios',
  href: '/perfumes',
  badge: null,
  items: [
    { label: 'Perfumes Yanbal (Ohm, Solo, Zentro)', href: '/perfumes' },
    { label: 'Ésika, Cyzone & L\'Bel', href: '/perfumes' },
    { label: 'Relojes Nórdicos Curren & Skmei', href: '/relojes' },
  ]
});

// 4. Combos y Promociones
navMenu.push({
  label: 'Combos 🔥',
  href: '/#combos',
  badge: 'Ahorra 25%',
  items: [
    { label: 'Chaqueta + Camiseta ($130.000)', href: '/#combos' },
    { label: 'Chaqueta + Perfume ($135.000)', href: '/#combos' },
    { label: 'Pack Dúo 2 Chaquetas ($160.000)', href: '/chaquetas' },
  ]
});
---

<header class="sticky top-0 z-40 bg-[#0B0B0C] border-b border-[#262626]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group" id="nav-logo">
        <div class="w-9 h-9 sm:w-10 sm:h-10 overflow-hidden relative transition-transform duration-300 group-hover:scale-105">
          <img 
            src="/assets/logo-nordico.png" 
            alt="Estilo Nórdico" 
            class="absolute top-0 left-0 w-full h-[145%] object-cover object-top" 
          />
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-sm sm:text-base font-black text-white uppercase tracking-widest font-title">Estilo Nórdico</span>
          <span class="text-[8px] text-[#A3A3A3] font-black tracking-widest uppercase mt-1 hidden sm:block">Pasto, Colombia</span>
        </div>
      </a>

      <!-- Desktop Navigation with Dropdowns (Koaj / Mattelsa Style) -->
      <div class="hidden md:flex items-center gap-7">
        {navMenu.map((menu) => (
          <div class="relative group py-5">
            <a
              href={menu.href}
              class="text-xs font-black uppercase tracking-widest text-[#D1D5DB] group-hover:text-white transition-colors flex items-center gap-1.5"
            >
              <span>{menu.label}</span>
              {menu.badge && (
                <span class="bg-[#C9A962] text-[#0B0B0C] text-[8px] font-black px-1.5 py-0.5 rounded-sm uppercase tracking-wider">
                  {menu.badge}
                </span>
              )}
              <svg class="w-3 h-3 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <!-- Dropdown Menu -->
            <div class="absolute top-full left-0 w-64 bg-[#121214] border border-[#262626] rounded-md shadow-2xl p-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 z-50">
              {menu.items.map((sub) => (
                <a
                  href={sub.href}
                  class="block px-3 py-2 text-xs font-bold text-[#A3A3A3] hover:text-white hover:bg-white/5 rounded-md uppercase tracking-wider transition-colors"
                >
                  {sub.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-3">
        <!-- Cart Trigger Button -->
        <button
          id="nav-cart-btn"
          class="relative flex items-center justify-center p-2 sm:p-2.5 rounded-md border border-white/20 hover:border-[#C9A962] bg-white/5 hover:bg-white/10 text-white transition-all cursor-pointer"
          aria-label="Ver carrito"
        >
          <svg class="w-5 h-5 text-[#C9A962]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span
            id="nav-cart-badge"
            class="absolute -top-1.5 -right-1.5 bg-[#C9A962] text-black text-[9px] font-black w-4.5 h-4.5 rounded-full flex items-center justify-center scale-0 transition-transform duration-300 shadow-sm"
          >
            0
          </span>
        </button>

        <!-- Direct WhatsApp CTA -->
        <a
          href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:flex items-center gap-2 border border-[#C9A962] bg-[#C9A962]/10 hover:bg-[#C9A962] text-[#C9A962] hover:text-black px-4 py-2.5 rounded-md text-xs font-black uppercase tracking-widest transition-all duration-300"
        >
          WhatsApp Pasto
        </a>

        <!-- Mobile Drawer Toggle -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-md hover:bg-white/5 border border-white/10 text-white cursor-pointer"
          aria-label="Abrir menú"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Accordion -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-[#262626]">
      <div class="flex flex-col gap-2 pt-3">
        {navMenu.map((m) => (
          <details class="group bg-[#121214] rounded-md border border-[#262626] overflow-hidden">
            <summary class="flex items-center justify-between p-3.5 text-xs font-black uppercase tracking-widest text-white cursor-pointer select-none">
              <span>{m.label}</span>
              <span class="text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="p-2 pt-0 space-y-1 bg-[#0B0B0C]">
              {m.items.map((sub) => (
                <a
                  href={sub.href}
                  class="block px-3 py-2 text-xs font-semibold text-[#A3A3A3] hover:text-white uppercase tracking-wider"
                >
                  {sub.label}
                </a>
              ))}
            </div>
          </details>
        ))}

        <a
          href={`https://api.whatsapp.com/send?phone=${STORE_CONFIG.whatsapp.number}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center justify-center gap-2 border border-[#C9A962] bg-[#C9A962]/10 text-[#C9A962] px-4 py-3 rounded-md text-xs font-black uppercase tracking-widest"
        >
          <span>💬 Chatear con Asesor en Pasto</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Barra táctil horizontal para móvil (Chips táctiles dinámicos sincronizados con ERP) -->
  <CategoryChips />
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
  });

  // Carrito listeners en Navbar
  const navCartBtn = document.getElementById('nav-cart-btn');
  const navCartBadge = document.getElementById('nav-cart-badge');

  navCartBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cart:open'));
  });

  window.addEventListener('cart:updated', (e: any) => {
    const count = e.detail?.count ?? 0;
    if (!navCartBadge) return;
    navCartBadge.textContent = String(count);
    if (count > 0) {
      navCartBadge.classList.remove('scale-0');
      navCartBadge.classList.add('scale-100');
      navCartBtn?.classList.add('animate-cart-attention');
    } else {
      navCartBadge.classList.remove('scale-100');
      navCartBadge.classList.add('scale-0');
      navCartBtn?.classList.remove('animate-cart-attention');
    }
  });

  try {
    const raw = localStorage.getItem('estilo_nordico_cart_v1');
    if (raw && navCartBadge) {
      const items = JSON.parse(raw);
      const count = items.reduce((s: number, i: any) => s + (i.quantity || 1), 0);
      if (count > 0) {
        navCartBadge.textContent = String(count);
        navCartBadge.classList.remove('scale-0');
        navCartBadge.classList.add('scale-100');
      }
    }
  } catch (_) {}
</script>

<style>
  @keyframes cartWobbleNav {
    0%, 75%, 100% {
      transform: scale(1) rotate(0deg);
    }
    80% {
      transform: scale(1.15) rotate(-10deg);
    }
    85% {
      transform: scale(1.15) rotate(10deg);
    }
    90% {
      transform: scale(1.08) rotate(-5deg);
    }
    95% {
      transform: scale(1.04) rotate(3deg);
    }
  }
  .animate-cart-attention {
    animation: cartWobbleNav 4.5s infinite ease-in-out;
  }
</style>
