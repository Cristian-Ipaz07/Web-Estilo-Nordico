---
/**
 * ProductCard.astro — Tarjeta de producto reutilizable
 * 
 * ACTUALIZADO: Ahora incluye link a product page individual.
 * Incluye imagen, precios, badge de descuento, badge de stock,
 * link "Ver detalles" y botón WhatsApp.
 * Dispara evento InitiateCheckout del Píxel de Meta.
 */
import { formatPrice, getDiscount } from '../data/products';
import { STORE_CONFIG } from '../config/store';

interface Props {
  id: string;
  slug: string;
  name: string;
  brand: string;
  price: number;
  anchorPrice: number;
  image: string;
  description: string;
  category: string;
  stock?: number;
  status?: string;
  colorHex?: string;
}

const { id, slug, name, brand, price, anchorPrice, image, description, category, stock, status, colorHex } = Astro.props;
const discount = getDiscount(price, anchorPrice);
const whatsappNumber = STORE_CONFIG.whatsapp.number;
const productPageUrl = `/${category}/${slug}`;
const isAvailable = status !== 'agotado';
---

<article class="product-card bg-white rounded-md overflow-hidden border border-[#E5E7EB] flex flex-col group" id={`product-${id}`}>
  <!-- Image container (clickable → product page) -->
  <a href={productPageUrl} class="relative overflow-hidden bg-[#F3F4F6] aspect-square block">
    <img 
      src={image} 
      alt={name}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
    />
    <!-- Discount badge -->
    {discount > 0 && (
      <div class="absolute top-3 left-3 bg-red-600 text-white text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider shadow-md">
        -{discount}%
      </div>
    )}
    <!-- Brand badge -->
    <div class="absolute top-3 right-3 bg-[#0B0B0C]/80 border border-white/10 text-white text-[9px] font-black px-2.5 py-1 rounded-md uppercase tracking-widest shadow-sm">
      {brand}
    </div>
    <!-- Stock badge -->
    {status && (
      <div class:list={[
        'card-stock-badge absolute bottom-3 left-3 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider',
        isAvailable 
          ? 'bg-green-600 text-white' 
          : 'bg-neutral-800 text-neutral-400'
      ]}>
        {isAvailable ? `✓ ${stock ?? ''} Disp` : '✗ Agotado'}
      </div>
    )}
    <!-- Color swatch -->
    {colorHex && (
      <div 
        class="absolute bottom-3 right-3 w-4 h-4 rounded-md border border-white/20 shadow-sm" 
        style={`background-color: ${colorHex}`}
        title={name}
      ></div>
    )}
    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
      <span class="text-white text-[10px] font-black uppercase tracking-widest bg-black/60 border border-white/15 px-4 py-2 rounded-md transition-all duration-300">
        Ver detalles →
      </span>
    </div>
  </a>

  <!-- Content -->
  <div class="p-4 sm:p-5 flex flex-col flex-grow">
    <div class="flex-grow">
      <a href={productPageUrl} class="hover:text-neutral-600 transition-colors">
        <h3 class="text-sm sm:text-base font-black text-text-main uppercase tracking-wider leading-snug mb-1 font-title">{name}</h3>
      </a>
      <p class="text-xs text-text-muted mb-3 line-clamp-2 leading-relaxed font-light">{description}</p>
    </div>
    
    <!-- Pricing Anchoring Comparison -->
    <div class="bg-[#F9F9FB] border border-[#E5E7EB] rounded-md p-2.5 mb-4 space-y-1">
      <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-text-muted">
        <span>Precio Comercial:</span>
        <span class="line-through text-text-light font-semibold card-anchor-price">${formatPrice(anchorPrice)} COP</span>
      </div>
      <div class="flex items-center justify-between text-xs sm:text-sm font-black text-text-main font-title border-t border-[#E5E7EB] pt-1">
        <span>Precio Estilo Nórdico:</span>
        <span class="text-sm sm:text-base font-black text-emerald-600 card-price">${formatPrice(price)} COP</span>
      </div>
      {discount > 0 && (
        <div class="pt-1 text-center">
          <span class="card-discount-badge bg-red-600 text-white text-[9px] font-black px-2 py-0.5 rounded-sm uppercase tracking-widest inline-block shadow-sm">
            AHORRAS {discount}%
          </span>
        </div>
      )}
    </div>

    <!-- Actions: View + WhatsApp -->
    <!-- Actions: View + Add to Cart -->
    <div class="flex gap-2">
      <a 
        href={productPageUrl}
        class="flex-1 text-center py-2.5 px-3 rounded-md text-[10px] font-black uppercase tracking-widest border border-border hover:border-text-main hover:bg-[#F9F9FB] text-text-main transition-all duration-300"
      >
        Detalles
      </a>
      <button 
        class="flex-1 bg-text-main hover:bg-neutral-800 text-white py-2.5 px-3 rounded-md text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-1.5 card-buy-btn transition-all duration-300 cursor-pointer"
        data-id={id}
        data-name={name}
        data-brand={brand}
        data-price={price}
        data-image={image}
        data-category={category}
        data-url={productPageUrl}
        id={`buy-${id}`}
      >
        {category === 'chaquetas' ? 'Elegir Talla' : '+ Carrito'}
      </button>
    </div>
  </div>
</article>

<script>
  import { addToCart } from '../lib/cart';

  // Sincronización instantánea de precios y stock en vivo con el ERP
  async function syncCardsWithLiveERP() {
    try {
      const res = await fetch('http://localhost:8000/api/public/products');
      if (!res.ok) return;
      const products = await res.json();
      
      const cards = document.querySelectorAll('.product-card');
      cards.forEach(card => {
        const titleEl = card.querySelector('h3');
        const title = titleEl?.textContent?.trim() || '';
        if (!title.toLowerCase().includes('chaqueta')) return;
        
        const colorName = title.replace(/chaqueta impermeable/i, '').trim().toLowerCase();
        
        const variants = products.filter((p: any) => {
          if (!p.ref || !p.ref.startsWith('5080')) return false;
          if (colorName && p.color && p.color.toLowerCase().trim() === colorName) return true;
          return false;
        });

        if (variants.length === 0) return;

        const totalStock = variants.reduce((sum: number, v: any) => sum + (v.stock || 0), 0);
        const liveItem = variants.find((v: any) => v.price_sale && v.price_sale > 0) || variants[0];
        const livePrice = Number(liveItem?.price_sale);
        const liveAnchor = Number(liveItem?.compare_price) || 120000;

        if (livePrice && !isNaN(livePrice)) {
          const fmtPrice = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(livePrice);
          const fmtAnchor = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(liveAnchor);
          const discount = Math.round(((liveAnchor - livePrice) / liveAnchor) * 100);

          const priceEl = card.querySelector('.card-price');
          if (priceEl) priceEl.textContent = `$${fmtPrice} COP`;

          const anchorEl = card.querySelector('.card-anchor-price');
          if (anchorEl) anchorEl.textContent = `$${fmtAnchor} COP`;

          const discountEl = card.querySelector('.card-discount-badge');
          if (discountEl && discount > 0) {
            discountEl.textContent = `AHORRAS ${discount}%`;
          }

          const buyBtn = card.querySelector('.card-buy-btn');
          if (buyBtn) buyBtn.setAttribute('data-price', String(livePrice));
        }

        const stockBadge = card.querySelector('.card-stock-badge');
        if (stockBadge) {
          if (totalStock > 0) {
            stockBadge.textContent = `✓ ${totalStock} Disp`;
            stockBadge.className = 'card-stock-badge absolute bottom-3 left-3 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider bg-green-600 text-white';
          } else {
            stockBadge.textContent = '✗ Agotado';
            stockBadge.className = 'card-stock-badge absolute bottom-3 left-3 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider bg-neutral-800 text-neutral-400';
          }
        }
      });
    } catch (_) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncCardsWithLiveERP);
  } else {
    syncCardsWithLiveERP();
  }
  window.addEventListener('focus', syncCardsWithLiveERP);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') syncCardsWithLiveERP();
  });

  document.querySelectorAll('.card-buy-btn').forEach(button => {
    button.addEventListener('click', (event) => {
      const target = event.currentTarget as HTMLButtonElement;
      const category = target.getAttribute('data-category') || '';
      const url = target.getAttribute('data-url') || '';

      if (category === 'chaquetas' && url) {
        window.location.href = url;
        return;
      }

      const id = target.getAttribute('data-id') || '';
      const name = target.getAttribute('data-name') || '';
      const brand = target.getAttribute('data-brand') || '';
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const image = target.getAttribute('data-image') || '';

      addToCart({
        id,
        productId: id,
        name,
        brand,
        category,
        price,
        image,
        quantity: 1,
      });
    });
  });
</script>
