---
/**
 * ProductCard.astro — Tarjeta de producto de alta conversión (Mattelsa CRO Benchmark)
 * 
 * - Selectores rápidos de talla directos en la tarjeta (Quick-Add Pills)
 * - Muestra ahorro evidente, stock en tiempo real y pago contraentrega en Pasto
 * - Sincronización instantánea de precios con la API del ERP
 */
import { formatPrice, getDiscount } from '../data/products';
import { STORE_CONFIG } from '../config/store';

interface Props {
  id: string;
  slug: string;
  name: string;
  brand: string;
  price: number;
  anchorPrice: number;
  image: string;
  images?: string[];
  description: string;
  category: string;
  stock?: number;
  status?: string;
  colorHex?: string;
  gender?: string;
  variants?: { id: string; talla: string; stock: number; status: string; images?: string[] }[];
}

const { id, slug, name, brand, price, anchorPrice, image, images = [], description, category, stock, status, colorHex, gender, variants } = Astro.props;

// Recolectar todas las fotos únicas del producto (portada, galería y fotos de variantes)
const allCardImages: string[] = [];
if (image) allCardImages.push(image);
if (images && Array.isArray(images)) {
  images.forEach(img => {
    if (img && typeof img === 'string' && !allCardImages.includes(img)) allCardImages.push(img);
  });
}
if (variants && Array.isArray(variants)) {
  variants.forEach((v: any) => {
    if (v.images && Array.isArray(v.images)) {
      v.images.forEach((img: string) => {
        if (img && typeof img === 'string' && !allCardImages.includes(img)) allCardImages.push(img);
      });
    }
  });
}
const hasMultipleImages = allCardImages.length >= 2;
const discount = getDiscount(price, anchorPrice);
const productPageUrl = `/${category}/${slug}`;
const isAvailable = status !== 'agotado';

// Deduplicar variantes por talla para evitar botones repetidos y soportar piezas únicas
const uniqueVariantsMap = new Map<string, typeof variants[0]>();
if (variants) {
  variants.forEach(v => {
    const sz = (v.talla || '').trim().toUpperCase();
    if (!sz || ['ÚNICA', 'UNICA', 'NONE', 'NULL', ''].includes(sz)) return;
    if (!uniqueVariantsMap.has(sz) || (v.status === 'disponible' && uniqueVariantsMap.get(sz)?.status !== 'disponible')) {
      uniqueVariantsMap.set(sz, v);
    }
  });
}
const uniqueVariantsList = Array.from(uniqueVariantsMap.values());
const isSingleSizePiece = uniqueVariantsList.length === 1;
---

<article class="product-card bg-white rounded-md overflow-hidden border border-[#E5E7EB] hover:border-[#C9A962] transition-colors flex flex-col group relative shadow-sm" id={`product-${id}`} data-gender={gender || ''}>
  <!-- Image container (clickable → product page) con Auto-Preview para 2+ fotos -->
  <a href={productPageUrl} class="relative overflow-hidden bg-[#F3F4F6] aspect-square block group/cardimg">
    {hasMultipleImages ? (
      <div 
        class="card-image-slider relative w-full h-full overflow-hidden"
        data-total={allCardImages.length}
      >
        {allCardImages.map((imgSrc, idx) => (
          <img 
            src={imgSrc} 
            alt={`${name} - Vista ${idx + 1}`}
            class={`card-slide-img absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out group-hover:scale-105 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
            loading={idx === 0 ? "lazy" : "lazy"}
            data-index={idx}
          />
        ))}
        <!-- Indicador sutil de fotos múltiples -->
        <div class="card-dots-indicator absolute bottom-2 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 bg-black/40 backdrop-blur-xs px-2 py-1 rounded-full pointer-events-none transition-opacity duration-300">
          {allCardImages.map((_, idx) => (
            <span 
              class={`card-dot rounded-full transition-all duration-300 ${idx === 0 ? 'bg-white w-3 h-1.5' : 'bg-white/40 w-1.5 h-1.5'}`}
              data-dot-index={idx}
            ></span>
          ))}
        </div>
      </div>
    ) : (
      <img 
        src={image} 
        alt={name}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    )}
    <!-- Discount badge -->
    {discount > 0 && (
      <div class="absolute top-2.5 left-2.5 bg-red-600 text-white text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider shadow-md">
        -{discount}%
      </div>
    )}
    <!-- Brand & Gender badges -->
    <div class="absolute top-2.5 right-2.5 flex items-center gap-1.5">
      {gender === 'mujer' && (
        <span class="bg-[#C9A962] text-[#0B0B0C] text-[8px] font-black px-1.5 py-0.5 rounded-sm uppercase tracking-wider shadow-sm">
          Dama
        </span>
      )}
      <div class="bg-[#0B0B0C]/80 border border-white/10 text-white text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-widest shadow-sm">
        {brand}
      </div>
    </div>
    <!-- Stock badge -->
    {status && (
      <div class:list={[
        'card-stock-badge absolute bottom-2.5 left-2.5 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider',
        isAvailable 
          ? 'bg-green-600 text-white' 
          : 'bg-neutral-800 text-neutral-400'
      ]}>
        {isAvailable ? `✓ ${stock ?? ''} Disp` : '✗ Agotado'}
      </div>
    )}
    <!-- Color swatch -->
    {colorHex && (
      <div 
        class="absolute bottom-2.5 right-2.5 w-4 h-4 rounded-md border border-white/20 shadow-sm" 
        style={`background-color: ${colorHex}`}
        title={name}
      ></div>
    )}
    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
      <span class="text-white text-[10px] font-black uppercase tracking-widest bg-black/70 border border-white/20 px-3 py-1.5 rounded-md transition-all">
        Ver prenda →
      </span>
    </div>
  </a>

  <!-- Content -->
  <div class="p-3.5 sm:p-4 flex flex-col flex-grow justify-between">
    <div>
      <a href={productPageUrl} class="hover:text-neutral-600 transition-colors">
        <h3 class="text-xs sm:text-sm font-black text-text-main uppercase tracking-wider leading-snug mb-1 font-title">{name}</h3>
      </a>
      <p class="text-[11px] text-text-muted mb-2.5 line-clamp-2 leading-relaxed font-light">{description}</p>
    </div>
    
    <!-- Pricing Comparison -->
    <div class="bg-[#F9F9FB] border border-[#E5E7EB] rounded-md p-2 mb-2.5 space-y-1">
      <div class="flex items-center justify-between text-[10px] text-text-muted">
        <span>Comercial:</span>
        <span class="line-through text-text-light font-semibold card-anchor-price">${formatPrice(anchorPrice)} COP</span>
      </div>
      <div class="flex items-center justify-between text-xs sm:text-sm font-black text-text-main font-title border-t border-[#E5E7EB] pt-1">
        <span>Estilo Nórdico:</span>
        <span class="text-xs sm:text-sm font-black text-emerald-600 card-price">${formatPrice(price)} COP</span>
      </div>
      {discount > 0 && (
        <div class="pt-0.5 text-center">
          <span class="card-discount-badge bg-red-600 text-white text-[8px] font-black px-1.5 py-0.5 rounded-sm uppercase tracking-widest inline-block shadow-sm">
            AHORRAS {discount}%
          </span>
        </div>
      )}
    </div>

    <!-- Quick Size Selector (Mattelsa CRO Benchmark) -->
    {uniqueVariantsList.length > 0 && isAvailable && (
      <div class="mb-2.5 pt-1.5 border-t border-[#E5E7EB]">
        <div class="flex items-center justify-between mb-1">
          <span class="text-[8px] font-black text-text-muted uppercase tracking-widest">
            {isSingleSizePiece ? 'Talla pieza única:' : 'Talla rápida:'}
          </span>
          <span class="text-[8px] text-emerald-600 font-bold uppercase tracking-wider">Hoy en Pasto</span>
        </div>
        <div class="flex flex-wrap gap-1">
          {uniqueVariantsList.map((v) => (
            <button
              type="button"
              class:list={[
                "card-quick-size-btn px-2 py-1 rounded text-[9px] font-black transition-all cursor-pointer border flex items-center gap-1",
                v.status === 'disponible'
                  ? (isSingleSizePiece
                      ? "border-[#0B0B0C] bg-[#0B0B0C] text-white hover:bg-neutral-800 shadow-xs"
                      : "border-[#E5E7EB] hover:border-black bg-[#F9F9FB] hover:bg-black hover:text-white text-text-main shadow-xs")
                  : "border-[#F3F4F6] text-neutral-300 line-through cursor-not-allowed opacity-40"
              ]}
              data-product-id={id}
              data-product-name={name}
              data-product-brand={brand}
              data-product-price={price}
              data-product-image={image}
              data-category={category}
              data-variant-id={v.id}
              data-size={v.talla}
              disabled={v.status !== 'disponible'}
              title={v.status === 'disponible' ? `Talla ${v.talla} (${v.stock} disp) — Clic para agregar directo` : 'Agotada'}
            >
              <span>{isSingleSizePiece ? `TALLA ${v.talla}` : v.talla}</span>
              {isSingleSizePiece && (
                <span class="text-[8px] text-emerald-400 font-bold">({v.stock} un.)</span>
              )}
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Actions: View + Add to Cart -->
    <div class="flex gap-2 pt-1">
      <a 
        href={productPageUrl}
        class="flex-1 text-center py-2 px-2 rounded-md text-[9px] sm:text-[10px] font-black uppercase tracking-widest border border-border hover:border-text-main hover:bg-[#F9F9FB] text-text-main transition-all duration-300 flex items-center justify-center"
      >
        Detalles
      </a>
      <button 
        class="flex-1 bg-text-main hover:bg-neutral-800 text-white py-2 px-2 rounded-md text-[9px] sm:text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-1 card-buy-btn transition-all duration-300 cursor-pointer"
        data-id={id}
        data-name={name}
        data-brand={brand}
        data-price={price}
        data-image={image}
        data-category={category}
        data-url={productPageUrl}
        data-is-single-size={isSingleSizePiece ? 'true' : 'false'}
        data-single-size={isSingleSizePiece ? uniqueVariantsList[0]?.talla : ''}
        data-single-variant-id={isSingleSizePiece ? uniqueVariantsList[0]?.id : ''}
        id={`buy-${id}`}
      >
        {(category === 'chaquetas' && !isSingleSizePiece) ? 'Elegir Talla' : '+ Carrito'}
      </button>
    </div>
  </div>
</article>

<script>
  import { addToCart } from '../lib/cart';
  import { ERP_API_BASE_URL } from '../lib/erpApi';

  // Sincronización instantánea de precios y stock en vivo con el ERP
  async function syncCardsWithLiveERP() {
    try {
      const res = await fetch(`${ERP_API_BASE_URL}/api/public/products`);
      if (!res.ok) return;
      const products = await res.json();
      
      const cards = document.querySelectorAll('.product-card');
      cards.forEach(card => {
        const titleEl = card.querySelector('h3');
        const title = titleEl?.textContent?.trim() || '';
        if (!title.toLowerCase().includes('chaqueta')) return;
        
        const cleanColorName = title
          .replace(/chaqueta impermeable/i, '')
          .replace(/dama/i, '')
          .replace(/columbia/i, '')
          .replace(/the north face/i, '')
          .trim()
          .toLowerCase();
        
        const isWoman = (card.getAttribute('data-gender') || '').toLowerCase() === 'mujer' || title.toLowerCase().includes('dama');
        const refPrefix = isWoman ? '5081' : '5080';
        
        const variants = products.filter((p: any) => {
          if (!p.ref || !p.ref.startsWith(refPrefix)) return false;
          if (cleanColorName && p.color && p.color.toLowerCase().trim() === cleanColorName) return true;
          return false;
        });

        if (variants.length === 0) return;

        const totalStock = variants.reduce((sum: number, v: any) => sum + (v.stock || 0), 0);
        const liveItem = variants.find((v: any) => v.price_sale && v.price_sale > 0) || variants[0];
        const livePrice = Number(liveItem?.price_sale);
        const liveAnchor = Number(liveItem?.compare_price) || 120000;

        if (livePrice && !isNaN(livePrice)) {
          const fmtPrice = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(livePrice);
          const fmtAnchor = new Intl.NumberFormat('es-CO', { style: 'decimal', minimumFractionDigits: 0 }).format(liveAnchor);
          const discount = Math.round(((liveAnchor - livePrice) / liveAnchor) * 100);

          const priceEl = card.querySelector('.card-price');
          if (priceEl) priceEl.textContent = `$${fmtPrice} COP`;

          const anchorEl = card.querySelector('.card-anchor-price');
          if (anchorEl) anchorEl.textContent = `$${fmtAnchor} COP`;

          const discountEl = card.querySelector('.card-discount-badge');
          if (discountEl && discount > 0) {
            discountEl.textContent = `AHORRAS ${discount}%`;
          }

          const buyBtn = card.querySelector('.card-buy-btn');
          if (buyBtn) buyBtn.setAttribute('data-price', String(livePrice));

          // Actualizar data-product-price en botones de talla rápida
          card.querySelectorAll('.card-quick-size-btn').forEach(btn => {
            btn.setAttribute('data-product-price', String(livePrice));
          });
        }

        const stockBadge = card.querySelector('.card-stock-badge');
        if (stockBadge) {
          if (totalStock > 0) {
            stockBadge.textContent = `✓ ${totalStock} Disp`;
            stockBadge.className = 'card-stock-badge absolute bottom-2.5 left-2.5 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider bg-green-600 text-white';
          } else {
            stockBadge.textContent = '✗ Agotado';
            stockBadge.className = 'card-stock-badge absolute bottom-2.5 left-2.5 text-[9px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider bg-neutral-800 text-neutral-400';
          }
        }
      });
    } catch (_) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncCardsWithLiveERP);
  } else {
    syncCardsWithLiveERP();
  }
  window.addEventListener('focus', syncCardsWithLiveERP);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') syncCardsWithLiveERP();
  });

  // Selector de Talla Rápido (Mattelsa Benchmark)
  document.querySelectorAll('.card-quick-size-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = e.currentTarget as HTMLButtonElement;
      const productId = target.getAttribute('data-product-id') || '';
      const name = target.getAttribute('data-product-name') || '';
      const brand = target.getAttribute('data-product-brand') || '';
      const price = parseFloat(target.getAttribute('data-product-price') || '0');
      const image = target.getAttribute('data-product-image') || '';
      const category = target.getAttribute('data-category') || '';
      const variantId = target.getAttribute('data-variant-id') || '';
      const size = target.getAttribute('data-size') || '';

      addToCart({
        id: `${productId}-${size}`,
        productId,
        variantId,
        name,
        brand,
        category,
        price,
        image,
        size,
        color: name.replace('Chaqueta Impermeable ', '').trim(),
        quantity: 1,
      });

      // Feedback visual rápido
      target.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('cart:open'));
        target.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
      }, 250);
    });
  });

  document.querySelectorAll('.card-buy-btn').forEach(button => {
    button.addEventListener('click', (event) => {
      const target = event.currentTarget as HTMLButtonElement;
      const category = target.getAttribute('data-category') || '';
      const url = target.getAttribute('data-url') || '';
      const isSingleSize = target.getAttribute('data-is-single-size') === 'true';

      if (category === 'chaquetas' && !isSingleSize && url) {
        window.location.href = url;
        return;
      }

      const id = target.getAttribute('data-id') || '';
      const name = target.getAttribute('data-name') || '';
      const brand = target.getAttribute('data-brand') || '';
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const image = target.getAttribute('data-image') || '';
      const size = target.getAttribute('data-single-size') || undefined;
      const variantId = target.getAttribute('data-single-variant-id') || undefined;

      addToCart({
        id: size ? `${id}-${size}` : id,
        productId: id,
        variantId,
        name,
        brand,
        category,
        price,
        image,
        size,
        color: name.includes('·') ? name.split('·')[1].trim() : name.replace('Chaqueta Impermeable ', '').trim(),
        quantity: 1,
      });

      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  });

  // ── Auto-preview de ciclo único para productos con 2 o más fotos ──
  function setCardSlide(slider: HTMLElement, targetIndex: number) {
    const imgs = slider.querySelectorAll<HTMLImageElement>('.card-slide-img');
    const dots = slider.querySelectorAll<HTMLElement>('.card-dot');

    imgs.forEach((img, idx) => {
      if (idx === targetIndex) {
        img.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        img.classList.add('opacity-100', 'z-10');
      } else {
        img.classList.remove('opacity-100', 'z-10');
        img.classList.add('opacity-0', 'z-0', 'pointer-events-none');
      }
    });

    dots.forEach((dot, idx) => {
      if (idx === targetIndex) {
        dot.className = 'card-dot rounded-full transition-all duration-300 bg-white w-3 h-1.5';
      } else {
        dot.className = 'card-dot rounded-full transition-all duration-300 bg-white/40 w-1.5 h-1.5';
      }
    });
  }

  function runCardSingleCycle(slider: HTMLElement) {
    const imgs = slider.querySelectorAll<HTMLImageElement>('.card-slide-img');
    const total = imgs.length;
    if (total < 2) return;

    // Solo un ciclo: pasa por las fotos secundarias y queda fija en la primera (índice 0)
    const steps: number[] = [];
    for (let i = 1; i < total; i++) {
      steps.push(i);
    }
    steps.push(0); // Vuelve y reposa en la primera imagen

    let stepIndex = 0;
    const initialWait = 650; // Pausa para ver la primera imagen
    const stepDuration = 1400; // Tiempo en cada imagen antes de pasar a la siguiente

    setTimeout(() => {
      const timer = setInterval(() => {
        if (stepIndex < steps.length) {
          const nextIdx = steps[stepIndex];
          setCardSlide(slider, nextIdx);
          stepIndex++;
        } else {
          clearInterval(timer);
          setCardSlide(slider, 0); // Queda fija en la primera imagen
          slider.dataset.cycleCompleted = 'true';
        }
      }, stepDuration);
    }, initialWait);
  }

  function initCardSliders() {
    const sliders = document.querySelectorAll<HTMLElement>('.card-image-slider:not([data-cycle-init])');
    if (sliders.length === 0) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            if (el.dataset.cycleRan === 'true') return;
            el.dataset.cycleRan = 'true';
            observer.unobserve(el);
            runCardSingleCycle(el);
          }
        });
      }, {
        threshold: 0.2, // Activar cuando al menos 20% de la tarjeta es visible
      });

      sliders.forEach(s => {
        s.setAttribute('data-cycle-init', 'true');
        observer.observe(s);
      });
    } else {
      sliders.forEach(s => {
        s.setAttribute('data-cycle-init', 'true');
        setTimeout(() => runCardSingleCycle(s), 1000);
      });
    }

    // Soporte opcional de hover en escritorio tras finalizar el ciclo
    document.querySelectorAll<HTMLElement>('.product-card').forEach(card => {
      const slider = card.querySelector<HTMLElement>('.card-image-slider');
      if (!slider || card.dataset.hoverInit === 'true') return;
      card.dataset.hoverInit = 'true';

      card.addEventListener('mouseenter', () => {
        if (slider.dataset.cycleCompleted === 'true') {
          setCardSlide(slider, 1);
        }
      });
      card.addEventListener('mouseleave', () => {
        if (slider.dataset.cycleCompleted === 'true') {
          setCardSlide(slider, 0);
        }
      });
    });
  }

  initCardSliders();
  document.addEventListener('astro:page-load', initCardSliders);
</script>
