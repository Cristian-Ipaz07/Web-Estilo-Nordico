---
/**
 * ProductCard.astro — Tarjeta de producto reutilizable
 * Incluye imagen, precios, badge de descuento y botón WhatsApp
 * Dispara evento InitiateCheckout del Píxel de Meta
 */
import { formatPrice, getDiscount } from '../data/products';
import { STORE_CONFIG } from '../config/store';

interface Props {
  id: string;
  name: string;
  brand: string;
  price: number;
  anchorPrice: number;
  image: string;
  description: string;
}

const { id, name, brand, price, anchorPrice, image, description } = Astro.props;
const discount = getDiscount(price, anchorPrice);
const whatsappNumber = STORE_CONFIG.whatsapp.number;
---

<article class="product-card bg-white rounded-2xl overflow-hidden shadow-sm border border-border-light flex flex-col" id={`product-${id}`}>
  <!-- Image container -->
  <div class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-gray-100 aspect-square">
    <img 
      src={image} 
      alt={name}
      class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
      loading="lazy"
    />
    <!-- Discount badge -->
    <div class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full badge-discount shadow-md">
      -{discount}%
    </div>
    <!-- Brand badge -->
    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-primary text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
      {brand}
    </div>
  </div>

  <!-- Content -->
  <div class="p-4 sm:p-5 flex flex-col flex-grow">
    <div class="flex-grow">
      <h3 class="text-base sm:text-lg font-bold text-text-main leading-snug mb-1">{name}</h3>
      <p class="text-xs text-text-muted mb-3 line-clamp-2">{description}</p>
    </div>
    
    <!-- Pricing -->
    <div class="flex items-baseline gap-2 mb-4">
      <span class="text-xl sm:text-2xl font-black text-text-main">${formatPrice(price)}</span>
      <span class="text-xs text-text-light line-through">${formatPrice(anchorPrice)}</span>
      <span class="text-[10px] text-text-muted">COP</span>
    </div>

    <!-- WhatsApp CTA -->
    <button 
      class="w-full btn-whatsapp py-3 px-4 rounded-xl text-sm flex items-center justify-center gap-2 buy-btn"
      data-id={id}
      data-name={name}
      data-brand={brand}
      data-price={price}
      data-phone={whatsappNumber}
      id={`buy-${id}`}
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>Pedir por WhatsApp</span>
    </button>
  </div>
</article>

<script>
  // Configurar listeners de compra para todas las tarjetas de producto
  document.querySelectorAll('.buy-btn').forEach(button => {
    button.addEventListener('click', (event) => {
      const target = event.currentTarget as HTMLButtonElement;
      const id = target.getAttribute('data-id') || '';
      const name = target.getAttribute('data-name') || '';
      const brand = target.getAttribute('data-brand') || '';
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const phone = target.getAttribute('data-phone') || '';

      const formattedPrice = new Intl.NumberFormat('es-CO', {
        style: 'decimal',
        minimumFractionDigits: 0,
      }).format(price);

      const message = 
        `*SOLICITUD DE PEDIDO CONTRAENTREGA (PASTO)*\n\n` +
        `📦 *Producto:* ${name} (${brand})\n` +
        `🆔 *Código:* ${id}\n` +
        `💰 *Precio Especial:* $${formattedPrice} COP\n\n` +
        `📍 _Por favor, indícame tu nombre y dirección en Pasto para coordinar la entrega hoy mismo._`;

      const encodedMessage = encodeURIComponent(message);
      const whatsAppUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMessage}`;

      // Disparar evento de conversión Meta Pixel (si está disponible)
      if (typeof window !== 'undefined' && (window as any).fbq) {
        (window as any).fbq('track', 'InitiateCheckout', {
          content_ids: [id],
          content_type: 'product',
          content_name: name,
          value: price,
          currency: 'COP'
        }, { eventID: `evt-${id}-${Date.now()}` });
      }

      // Retardo para asegurar transmisión del evento de Meta
      setTimeout(() => {
        window.open(whatsAppUrl, '_blank');
      }, 300);
    });
  });
</script>
