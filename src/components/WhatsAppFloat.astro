---
/**
 * WhatsAppFloat.astro — Botón flotante de WhatsApp inteligente
 * Siempre visible en esquina inferior derecha con animación y tooltip recurrente inteligente.
 */
import { STORE_CONFIG } from '../config/store';

const whatsappNumber = STORE_CONFIG.whatsapp.number;
---

<!-- Contenedor Flotante de WhatsApp y Tooltip (Ubicado a la izquierda del botón de WhatsApp, sin tapar ni ser tapado por el carrito) -->
<div class="fixed bottom-5 right-5 z-40 flex items-center">
  <!-- Tooltip conversacional llamativo y bailable -->
  <a
    href={`https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-tooltip"
    class="mr-3 bg-white text-text-main rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.18)] p-3 max-w-[210px] sm:max-w-[240px] transition-all duration-500 opacity-0 translate-x-4 border border-[#E5E7EB] hover:border-[#25D366] flex items-center gap-2 cursor-pointer group pointer-events-none relative select-none"
    aria-label="Abrir chat de WhatsApp con asesor"
  >
    <!-- Flecha indicadora apuntando hacia el botón de WhatsApp (a la derecha) -->
    <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rotate-45 border-t border-r border-[#E5E7EB] group-hover:border-[#25D366]"></div>

    <div class="flex items-center gap-2 text-xs font-bold relative z-10" id="tooltip-text">
      <span class="text-base shrink-0">💬</span>
      <span class="leading-tight text-[11px] sm:text-xs">¿Tienes alguna duda? <b>¡Escríbenos!</b></span>
    </div>

    <!-- Botón cerrar para no ser invasivo -->
    <button
      type="button"
      id="close-tooltip-btn"
      class="text-zinc-400 hover:text-zinc-700 text-xs p-1 -mr-1 rounded-full transition-colors relative z-20 cursor-pointer shrink-0"
      title="Cerrar mensaje"
      aria-label="Cerrar"
    >
      ✕
    </button>
  </a>

  <!-- Botón Circular de WhatsApp -->
  <a
    href={`https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodeURIComponent(STORE_CONFIG.whatsapp.defaultMessage)}`}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-float"
    class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-accent shadow-lg hover:bg-accent-hover transition-all duration-300 hover:scale-110 hover:shadow-[0_0_25px_rgb(37_211_102/0.5)] group animate-wpp-float relative shrink-0 cursor-pointer"
    aria-label="Contáctanos por WhatsApp"
  >
    <!-- Ping animation ring -->
    <span class="absolute w-full h-full rounded-full bg-accent/40 animate-ping"></span>
    
    <!-- WhatsApp icon -->
    <svg class="relative w-7 h-7 sm:w-8 sm:h-8 text-white group-hover:rotate-12 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>

<script define:vars={{ whatsappNumber }}>
  // Detección contextual inteligente de mensajes y textos
  const path = window.location.pathname;
  const pageTitle = (document.title || '').toLowerCase();
  const floatBtn = document.getElementById('whatsapp-float');
  const tooltip = document.getElementById('whatsapp-tooltip');
  const tooltipText = document.getElementById('tooltip-text');
  const closeBtn = document.getElementById('close-tooltip-btn');
  
  let customMsg = '¡Hola! Me gustaría hacer una consulta general sobre la tienda.';

  const isWallet = path.includes('billetera') || pageTitle.includes('billetera');
  const isPerfume = path.includes('/perfumes/') || pageTitle.includes('perfume') || pageTitle.includes('loción') || pageTitle.includes('fragancia');
  const isWatch = path.includes('/relojes/') || pageTitle.includes('reloj');
  const isJacket = (path.includes('/chaquetas/') || pageTitle.includes('chaqueta')) && !isWallet;

  if (isWallet) {
    customMsg = '¡Hola! Estoy viendo las billeteras de Estilo Nórdico y tengo una duda sobre los modelos disponibles...';
    if (tooltipText) {
      tooltipText.innerHTML = '<span class="text-base shrink-0">👛</span> <span class="leading-tight text-[11px] sm:text-xs">¿Dudas con tu modelo o diseño? <b>¡Escríbenos!</b></span>';
    }
  } else if (isJacket) {
    customMsg = '¡Hola! Estoy viendo las chaquetas premium y se me presentó una duda con mi talla o pedido...';
    if (tooltipText) {
      tooltipText.innerHTML = '<span class="text-base shrink-0">🧥</span> <span class="leading-tight text-[11px] sm:text-xs">¿Dudas con tu talla? <b>¡Te asesoramos ya!</b></span>';
    }
  } else if (isPerfume) {
    customMsg = '¡Hola! Estoy viendo los perfumes originales y me gustaría recibir asesoría...';
    if (tooltipText) {
      tooltipText.innerHTML = '<span class="text-base shrink-0">🧴</span> <span class="leading-tight text-[11px] sm:text-xs">¿Buscas una fragancia especial? <b>¡Escríbenos!</b></span>';
    }
  } else if (isWatch) {
    customMsg = '¡Hola! Estoy viendo los relojes de catálogo y quisiera consultar sobre entrega y garantía...';
    if (tooltipText) {
      tooltipText.innerHTML = '<span class="text-base shrink-0">⌚</span> <span class="leading-tight text-[11px] sm:text-xs">¿Garantía y entrega del reloj? <b>¡Pregúntanos!</b></span>';
    }
  }

  const encodedMsg = encodeURIComponent(customMsg);
  if (floatBtn) {
    floatBtn.href = `https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodedMsg}`;
  }
  if (tooltip) {
    tooltip.href = `https://api.whatsapp.com/send?phone=${whatsappNumber}&text=${encodedMsg}`;
  }

  // Animación bailable y visibilidad garantizada sin interferir con el carrito
  if (tooltip) {
    setTimeout(() => {
      tooltip.classList.remove('opacity-0', 'translate-x-4', 'pointer-events-none');
      tooltip.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto', 'animate-dance-wobble');
    }, 1200);

    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      tooltip.classList.remove('opacity-100', 'translate-x-0', 'animate-dance-wobble');
      tooltip.classList.add('opacity-0', 'translate-x-4', 'pointer-events-none');
    });
  }
</script>

<style>
  @keyframes wppFloat {
    0%, 100% {
      transform: translateY(0);
      box-shadow: 0 10px 25px -5px rgba(37, 211, 102, 0.4);
    }
    50% {
      transform: translateY(-4px);
      box-shadow: 0 18px 30px -5px rgba(37, 211, 102, 0.7);
    }
  }
  .animate-wpp-float {
    animation: wppFloat 3s infinite ease-in-out;
  }

  /* Animación bailable alegre y atractiva */
  @keyframes danceWobble {
    0%, 100% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    12% {
      transform: translateY(-6px) rotate(-3.5deg) scale(1.04);
    }
    24% {
      transform: translateY(2px) rotate(3deg) scale(0.98);
    }
    36% {
      transform: translateY(-4px) rotate(-2deg) scale(1.02);
    }
    48% {
      transform: translateY(1px) rotate(1.5deg) scale(0.99);
    }
    60% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  .animate-dance-wobble {
    animation: danceWobble 3.2s infinite ease-in-out;
    transform-origin: right center;
  }
</style>
